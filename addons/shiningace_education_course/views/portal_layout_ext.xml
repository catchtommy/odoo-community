<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds a "Curriculum" nav link to the tutor portal sidebar (no new
         base route in tuition_management — extends its existing shell,
         same convention as portal_tutor_lesson_ext.xml). -->
    <template id="portal_sidebar_layout_curriculum_nav" inherit_id="tuition_management.portal_sidebar_layout">
        <xpath expr="//a[@href='/my/tutor/payments']" position="after">
            <a href="/my/tutor/curriculum"
               t-attf-class="tm-nav-item #{_page == 'tutor_curriculum' and 'active' or ''}">
                Curriculum
            </a>
        </xpath>
        <!-- This portal shell (tuition_management.portal_sidebar_layout)
             calls t-call="web.layout" directly, not "web.frontend_layout" —
             so it never pulls in ANY Odoo asset bundle (web.assets_frontend,
             _minimal, _lazy, none of it). Registering mathjax_loader.js
             under an asset bundle key (as shiningace_education_core's
             manifest does, for web.assets_backend) is therefore a no-op on
             every tutor/student/parent portal page: they simply never load
             it. Load it directly as a plain script tag instead, the same
             way portal_assignment_annotator.js already is just above —
             it's a self-contained script with no import/export statements,
             so it works fine outside Odoo's module system. -->
        <xpath expr="//script[@src='/tuition_management/static/src/js/portal_assignment_annotator.js']" position="after">
            <script type="text/javascript" src="/shiningace_education_core/static/src/js/mathjax_loader.js"/>
        </xpath>
    </template>
</odoo>
