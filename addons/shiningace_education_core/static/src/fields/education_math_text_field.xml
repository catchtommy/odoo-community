<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="shiningace_education_core.EducationMathTextField">
        <t t-if="props.readonly">
            <span t-ref="mathRoot">
                <t t-if="isHtml">
                    <span t-out="props.record.data[props.name] or ''"/>
                </t>
                <t t-else="">
                    <span t-esc="props.record.data[props.name] or ''"/>
                </t>
            </span>
        </t>
        <t t-else="">
            <t t-call="web.TextField"/>
            <button type="button" class="btn btn-sm btn-link o_edu_insert_equation_btn"
                    t-on-click="openEquationEditor">
                <i class="fa fa-superscript me-1"/>Insert Equation
            </button>
            <!-- This build treats a writable record as always "editable" (no
                 separate view/edit mode to switch into), so props.readonly is
                 almost never true here in practice — the branch above rarely
                 fires. Show a live-typeset preview alongside the raw textarea
                 instead, same fix question_bank's LatexPreviewWidget already
                 uses for the same reason. Updates on blur/record-commit
                 (the base textarea doesn't push every keystroke into
                 record.data), which is enough to confirm the equation is
                 right without leaving the field. -->
            <div t-if="props.record.data[props.name]" class="o_edu_math_preview" t-ref="mathRoot">
                <div class="o_edu_math_preview_label">Preview</div>
                <t t-if="isHtml">
                    <div t-out="props.record.data[props.name]"/>
                </t>
                <t t-else="">
                    <div class="o_edu_math_preview_text" t-esc="props.record.data[props.name]"/>
                </t>
            </div>
        </t>
    </t>
</templates>
