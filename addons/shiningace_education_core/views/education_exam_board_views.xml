<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_exam_board_list" model="ir.ui.view">
        <field name="name">education.exam.board.list</field>
        <field name="model">education.exam.board</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="education_system_id"/>
            </list>
        </field>
    </record>

    <record id="view_education_exam_board_form" model="ir.ui.view">
        <field name="name">education.exam.board.form</field>
        <field name="model">education.exam.board</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. AQA, Edexcel, Cambridge, IB"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="country_id"/>
                            <field name="education_system_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_education_exam_board_search" model="ir.ui.view">
        <field name="name">education.exam.board.search</field>
        <field name="model">education.exam.board</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="education_system_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_country" string="Country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_exam_board" model="ir.actions.act_window">
        <field name="name">Exam Boards</field>
        <field name="res_model">education.exam.board</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
