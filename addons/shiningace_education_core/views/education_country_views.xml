<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_country_list" model="ir.ui.view">
        <field name="name">education.country.list</field>
        <field name="model">education.country</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="education_system_count"/>
                <field name="board_count"/>
            </list>
        </field>
    </record>

    <record id="view_education_country_form" model="ir.ui.view">
        <field name="name">education.country.form</field>
        <field name="model">education.country</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_education_systems" type="object" class="oe_stat_button" icon="fa-university">
                            <field name="education_system_count" widget="statinfo" string="Systems"/>
                        </button>
                        <button name="action_view_exam_boards" type="object" class="oe_stat_button" icon="fa-institution">
                            <field name="board_count" widget="statinfo" string="Boards"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_education_country_search" model="ir.ui.view">
        <field name="name">education.country.search</field>
        <field name="model">education.country</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_education_country" model="ir.actions.act_window">
        <field name="name">Countries</field>
        <field name="res_model">education.country</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
