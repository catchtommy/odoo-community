<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_subject_list" model="ir.ui.view">
        <field name="name">education.subject.list</field>
        <field name="model">education.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_education_subject_form" model="ir.ui.view">
        <field name="name">education.subject.form</field>
        <field name="model">education.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Mathematics"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_education_subject_search" model="ir.ui.view">
        <field name="name">education.subject.search</field>
        <field name="model">education.subject</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_education_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">education.subject</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
