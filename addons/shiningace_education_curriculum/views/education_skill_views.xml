<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_skill_list" model="ir.ui.view">
        <field name="name">education.skill.list</field>
        <field name="model">education.skill</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="unique_skill_code"/>
                <field name="name"/>
                <field name="topic_id"/>
                <field name="difficulty_level"/>
            </list>
        </field>
    </record>

    <record id="view_education_skill_search" model="ir.ui.view">
        <field name="name">education.skill.search</field>
        <field name="model">education.skill</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unique_skill_code"/>
                <field name="curriculum_id"/>
                <field name="curriculum_version_id"/>
                <field name="topic_id"/>
                <field name="subject_id"/>
                <group>
                    <filter name="group_by_curriculum" string="Curriculum" context="{'group_by': 'curriculum_id'}"/>
                    <filter name="group_by_version" string="Curriculum Version" context="{'group_by': 'curriculum_version_id'}"/>
                    <filter name="group_by_topic" string="Topic" context="{'group_by': 'topic_id'}"/>
                    <filter name="group_by_subject" string="Subject" context="{'group_by': 'subject_id'}"/>
                    <filter name="group_by_difficulty" string="Difficulty" context="{'group_by': 'difficulty_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_skill" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">education.skill</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'search_default_group_by_curriculum': 1,
            'search_default_group_by_version': 1,
            'search_default_group_by_topic': 1,
        }</field>
    </record>
</odoo>
