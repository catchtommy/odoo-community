<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_curriculum_list" model="ir.ui.view">
        <field name="name">education.curriculum.list</field>
        <field name="model">education.curriculum</field>
        <field name="arch" type="xml">
            <list js_class="education_curriculum_list">
                <field name="name"/>
                <field name="subject_id"/>
                <field name="board_id"/>
                <field name="academic_level_id"/>
                <field name="version_count"/>
                <field name="current_version_id"/>
            </list>
        </field>
    </record>

    <record id="view_education_curriculum_form" model="ir.ui.view">
        <field name="name">education.curriculum.form</field>
        <field name="model">education.curriculum</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_versions" type="object" class="oe_stat_button" icon="fa-code-fork">
                            <field name="version_count" widget="statinfo" string="Versions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. GCSE Mathematics (AQA)"/></h1>
                    </div>
                    <div class="mb-3">
                        <button name="action_view_structure_tree" type="object" class="btn-secondary" icon="fa-sitemap"
                                string="View Structure Tree" invisible="version_count == 0"/>
                        <button name="action_publish_all_content" type="object" class="btn-secondary" icon="fa-check-circle"
                                string="Publish All Content" invisible="version_count == 0"
                                confirm="This approves any pending tutor proposals and publishes every lesson and lesson plan in the current version. Continue?"/>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="subject_id"/>
                            <field name="education_system_id"/>
                        </group>
                        <group>
                            <field name="board_id"/>
                            <field name="academic_level_id"/>
                            <field name="current_version_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Versions">
                            <field name="version_ids">
                                <list>
                                    <field name="version_label"/>
                                    <field name="version_number"/>
                                    <field name="state" widget="badge"/>
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                    <field name="published_date"/>
                                </list>
                            </field>
                            <button name="action_create_first_version" type="object" string="Create First Version"
                                    class="btn-secondary" invisible="version_count != 0"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_education_curriculum_search" model="ir.ui.view">
        <field name="name">education.curriculum.search</field>
        <field name="model">education.curriculum</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject_id"/>
                <field name="board_id"/>
                <field name="academic_level_id"/>
                <field name="tag_ids"/>
                <group>
                    <filter name="group_by_subject" string="Subject" context="{'group_by': 'subject_id'}"/>
                    <filter name="group_by_board" string="Exam Board" context="{'group_by': 'board_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_curriculum" model="ir.actions.act_window">
        <field name="name">Curricula</field>
        <field name="res_model">education.curriculum</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
