<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_learning_objective_list" model="ir.ui.view">
        <field name="name">education.learning.objective.list</field>
        <field name="model">education.learning.objective</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="topic_id"/>
                <field name="subtopic_id"/>
                <field name="bloom_level"/>
                <field name="expected_completion_minutes"/>
            </list>
        </field>
    </record>

    <record id="view_education_learning_objective_form" model="ir.ui.view">
        <field name="name">education.learning.objective.form</field>
        <field name="model">education.learning.objective</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Understand equivalent fractions"/></h1>
                    </div>
                    <group>
                        <group>
                            <div class="text-muted mb-2" colspan="2">
                                Link this objective to either a Topic (general, topic-level) or a
                                Subtopic — not both. Picking one clears the other.
                            </div>
                            <field name="topic_id" placeholder="(topic-level objective)"/>
                            <field name="subtopic_id" placeholder="(subtopic-level objective)"/>
                        </group>
                        <group>
                            <field name="bloom_level"/>
                            <field name="expected_completion_minutes"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_education_learning_objective_search" model="ir.ui.view">
        <field name="name">education.learning.objective.search</field>
        <field name="model">education.learning.objective</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="curriculum_id"/>
                <field name="curriculum_version_id"/>
                <field name="topic_id"/>
                <field name="subtopic_id"/>
                <group>
                    <filter name="group_by_curriculum" string="Curriculum" context="{'group_by': 'curriculum_id'}"/>
                    <filter name="group_by_version" string="Curriculum Version" context="{'group_by': 'curriculum_version_id'}"/>
                    <filter name="group_by_topic" string="Topic" context="{'group_by': 'topic_id'}"/>
                    <filter name="group_by_subtopic" string="Subtopic" context="{'group_by': 'subtopic_id'}"/>
                    <filter name="group_by_bloom" string="Bloom Level" context="{'group_by': 'bloom_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_learning_objective" model="ir.actions.act_window">
        <field name="name">Learning Objectives</field>
        <field name="res_model">education.learning.objective</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'search_default_group_by_curriculum': 1,
            'search_default_group_by_version': 1,
            'search_default_group_by_topic': 1,
            'search_default_group_by_subtopic': 1,
        }</field>
    </record>
</odoo>
