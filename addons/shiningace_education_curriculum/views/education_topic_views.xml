<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_topic_list" model="ir.ui.view">
        <field name="name">education.topic.list</field>
        <field name="model">education.topic</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="subject_id"/>
                <field name="academic_level_id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="curriculum_version_id"/>
                <field name="proposed_by_id" optional="hide"/>
                <field name="approval_state" widget="badge" decoration-warning="approval_state == 'pending'" decoration-danger="approval_state == 'rejected'" decoration-success="approval_state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_education_topic_form" model="ir.ui.view">
        <field name="name">education.topic.form</field>
        <field name="model">education.topic</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve_proposal" type="object" string="Approve" class="btn-primary" invisible="approval_state != 'pending'"/>
                    <button name="action_reject_proposal" type="object" string="Reject" invisible="approval_state != 'pending'"/>
                    <field name="approval_state" widget="statusbar" statusbar_visible="pending,approved" invisible="not proposed_by_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Linear Equations"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="curriculum_version_id"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="subject_id" readonly="1"/>
                            <field name="academic_level_id" readonly="1"/>
                            <field name="board_id" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="approval_state == 'approved' and not proposed_by_id" string="Tutor Proposal">
                        <group>
                            <field name="proposed_by_id" readonly="1"/>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="review_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="review_notes" placeholder="Notes for the tutor (shown when rejecting)…"/>
                        </group>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Subtopics">
                            <field name="subtopic_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="parent_subtopic_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Learning Objectives">
                            <field name="learning_objective_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="bloom_level"/>
                                    <field name="expected_completion_minutes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Skills">
                            <field name="skill_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="unique_skill_code" readonly="1"/>
                                    <field name="difficulty_level"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prerequisites">
                            <field name="prerequisite_ids">
                                <list editable="bottom">
                                    <field name="prerequisite_topic_id"/>
                                    <field name="is_mandatory"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_education_topic_search" model="ir.ui.view">
        <field name="name">education.topic.search</field>
        <field name="model">education.topic</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="curriculum_id"/>
                <field name="subject_id"/>
                <field name="academic_level_id"/>
                <field name="curriculum_version_id"/>
                <filter name="pending_review" string="Pending Review" domain="[('approval_state', '=', 'pending')]"/>
                <group>
                    <filter name="group_by_curriculum" string="Curriculum" context="{'group_by': 'curriculum_id'}"/>
                    <filter name="group_by_version" string="Curriculum Version" context="{'group_by': 'curriculum_version_id'}"/>
                    <filter name="group_by_subject" string="Subject" context="{'group_by': 'subject_id'}"/>
                    <filter name="group_by_approval_state" string="Approval Status" context="{'group_by': 'approval_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_topic" model="ir.actions.act_window">
        <field name="name">Topics</field>
        <field name="res_model">education.topic</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_curriculum': 1, 'search_default_group_by_version': 1}</field>
    </record>
</odoo>
