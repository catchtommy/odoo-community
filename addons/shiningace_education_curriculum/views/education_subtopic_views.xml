<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_subtopic_list" model="ir.ui.view">
        <field name="name">education.subtopic.list</field>
        <field name="model">education.subtopic</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="topic_id"/>
                <field name="parent_subtopic_id"/>
                <field name="proposed_by_id" optional="hide"/>
                <field name="approval_state" widget="badge" decoration-warning="approval_state == 'pending'" decoration-danger="approval_state == 'rejected'" decoration-success="approval_state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_education_subtopic_search" model="ir.ui.view">
        <field name="name">education.subtopic.search</field>
        <field name="model">education.subtopic</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="topic_id"/>
                <field name="curriculum_id"/>
                <field name="curriculum_version_id"/>
                <filter name="pending_review" string="Pending Review" domain="[('approval_state', '=', 'pending')]"/>
                <group>
                    <filter name="group_by_curriculum" string="Curriculum" context="{'group_by': 'curriculum_id'}"/>
                    <filter name="group_by_version" string="Curriculum Version" context="{'group_by': 'curriculum_version_id'}"/>
                    <filter name="group_by_topic" string="Topic" context="{'group_by': 'topic_id'}"/>
                    <filter name="group_by_approval_state" string="Approval Status" context="{'group_by': 'approval_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_education_subtopic_form" model="ir.ui.view">
        <field name="name">education.subtopic.form</field>
        <field name="model">education.subtopic</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve_proposal" type="object" string="Approve" class="btn-primary" invisible="approval_state != 'pending'"/>
                    <button name="action_reject_proposal" type="object" string="Reject" invisible="approval_state != 'pending'"/>
                    <field name="approval_state" widget="statusbar" statusbar_visible="pending,approved" invisible="not proposed_by_id"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="topic_id"/>
                        <field name="parent_subtopic_id" domain="[('topic_id', '=', topic_id)]"/>
                    </group>
                    <group invisible="approval_state == 'approved' and not proposed_by_id" string="Tutor Proposal">
                        <group>
                            <field name="proposed_by_id" readonly="1"/>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="review_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="review_notes" placeholder="Notes for the tutor (shown when rejecting)…"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="learning_objective_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="bloom_level"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_education_subtopic" model="ir.actions.act_window">
        <field name="name">Subtopics</field>
        <field name="res_model">education.subtopic</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_curriculum': 1, 'search_default_group_by_version': 1, 'search_default_group_by_topic': 1}</field>
    </record>
</odoo>
