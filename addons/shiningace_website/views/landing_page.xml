<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  Landing Page — extends website.layout (website builder compatible) -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <template id="landing_page" name="Shiningace Home">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'homepage'"/>

            <!-- Page content -->
            <div id="wrap" class="sa-page">

                <!-- ── HERO ─────────────────────────────────────────────── -->
                <section class="sa-hero">
                    <div class="sa-container sa-hero__inner">

                        <!-- Left: headline + CTA -->
                        <div class="sa-hero__left">
                            <div class="sa-hero__badge">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                1-to-1 Online Tutoring
                            </div>
                            <h1 class="sa-hero__headline">
                                Find the right tutor<br/>
                                in <span class="sa-yellow">60 seconds</span>
                            </h1>
                            <p class="sa-hero__sub">
                                AI-powered 1-to-1 tutoring for<br/>
                                GCSE, A-Level &amp; beyond
                            </p>
                            <a href="#start" class="sa-btn sa-btn--cta">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                                Start with AI Assistant
                            </a>
                            <div class="sa-hero__trust">
                                <span class="sa-star">★</span>
                                <strong>4.6</strong>
                                <span class="sa-muted">Excellent</span>
                                <span class="sa-divider">|</span>
                                <svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#00b67a"/></svg>
                                <span class="sa-muted">Trustpilot</span>
                            </div>
                        </div>

                        <!-- Right: AI chat widget -->
                        <div class="sa-hero__right">
                            <div class="sa-hero-card">
                                <!-- Card header -->
                                <div class="sa-hero-card__header">
                                    <div class="sa-hero-card__icon">🎓</div>
                                    <div>
                                        <div class="sa-hero-card__title">Why ShiningAce?</div>
                                        <div class="sa-hero-card__sub">Trusted by families across the UK</div>
                                    </div>
                                </div>

                                <!-- Stats row -->
                                <div class="sa-hero-card__stats">
                                    <div class="sa-hero-stat">
                                        <div class="sa-hero-stat__num">500+</div>
                                        <div class="sa-hero-stat__label">Students Enrolled</div>
                                    </div>
                                    <div class="sa-hero-stat">
                                        <div class="sa-hero-stat__num">98%</div>
                                        <div class="sa-hero-stat__label">Grade Improvement</div>
                                    </div>
                                    <div class="sa-hero-stat">
                                        <div class="sa-hero-stat__num">50+</div>
                                        <div class="sa-hero-stat__label">Expert Tutors</div>
                                    </div>
                                </div>

                                <!-- Feature list -->
                                <ul class="sa-hero-card__features">
                                    <li>
                                        <span class="sa-hero-card__check">✓</span>
                                        Personalised 1-to-1 &amp; small group sessions
                                    </li>
                                    <li>
                                        <span class="sa-hero-card__check">✓</span>
                                        Live online classes with interactive whiteboards
                                    </li>
                                    <li>
                                        <span class="sa-hero-card__check">✓</span>
                                        Real-time progress tracking for parents
                                    </li>
                                    <li>
                                        <span class="sa-hero-card__check">✓</span>
                                        Flexible scheduling — evenings &amp; weekends
                                    </li>
                                    <li>
                                        <span class="sa-hero-card__check">✓</span>
                                        AI-powered tutor matching &amp; study plans
                                    </li>
                                </ul>

                                <!-- CTA -->
                                <a href="/enquiry" class="sa-hero-card__cta">
                                    Book a Free Demo Session
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                </a>
                                <div class="sa-hero-card__note">No commitment · Free trial lesson available</div>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- ── HOW IT WORKS ──────────────────────────────────────── -->
                <section class="sa-how" id="how-it-works">
                    <div class="sa-container">
                        <h2 class="sa-section-title">How it works</h2>
                        <div class="sa-how__steps">
                            <div class="sa-how__step">
                                <div class="sa-how__icon">
                                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                </div>
                                <div class="sa-how__connector"></div>
                                <div class="sa-how__num">1</div>
                                <h3>Tell us your needs</h3>
                                <p>Chat with our AI assistant about your child's goals</p>
                            </div>
                            <div class="sa-how__step">
                                <div class="sa-how__icon">
                                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
                                </div>
                                <div class="sa-how__connector"></div>
                                <div class="sa-how__num">2</div>
                                <h3>Get matched instantly</h3>
                                <p>We find the perfect tutor for your child</p>
                            </div>
                            <div class="sa-how__step">
                                <div class="sa-how__icon">
                                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#4F46E5" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                </div>
                                <div class="sa-how__num">3</div>
                                <h3>Book a demo</h3>
                                <p>Pick a time and start the learning journey</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ── TESTIMONIAL ───────────────────────────────────────── -->
                <section class="sa-testimonial" id="success">
                    <div class="sa-container sa-testimonial__inner">
                        <div class="sa-testimonial__left">
                            <div class="sa-testimonial__rating">
                                <span class="sa-star sa-star--lg">★</span>
                                <span class="sa-testimonial__score">4.6</span>
                            </div>
                            <div class="sa-testimonial__label">Excellent</div>
                            <div class="sa-testimonial__reviews">Based on 1,000+ reviews</div>
                            <div class="sa-testimonial__tp">
                                <svg width="16" height="16" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#00b67a"/></svg>
                                Trustpilot
                            </div>
                        </div>
                        <div class="sa-testimonial__quote">
                            <div class="sa-quote-mark">"</div>
                            <p>ShiningAce helped my daughter improve from grade 5 to 8 in just 3 months. Highly recommended!</p>
                            <div class="sa-testimonial__author">– Sarah J.</div>
                        </div>
                        <div class="sa-testimonial__image">
                            <div class="sa-testimonial__img-placeholder">
                                <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="1"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ── DEMO SLOTS ─────────────────────────────────────────── -->
                <section class="sa-slots" id="book-demo">
                    <div class="sa-container">
                        <h2 class="sa-section-title">Next available demo slots</h2>
                        <div class="sa-slots__grid">
                            <div class="sa-slot">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                <div><div class="sa-slot__day">Today</div><div class="sa-slot__time">6:00 PM</div></div>
                            </div>
                            <div class="sa-slot">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                <div><div class="sa-slot__day">Tomorrow</div><div class="sa-slot__time">5:00 PM</div></div>
                            </div>
                            <div class="sa-slot">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                <div><div class="sa-slot__day">Saturday</div><div class="sa-slot__time">10:00 AM</div></div>
                            </div>
                            <div class="sa-slot sa-slot--cta">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                <a href="#" class="sa-slot__link">View all slots</a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ── DARK CTA BANNER ───────────────────────────────────── -->
                <section class="sa-cta-banner">
                    <div class="sa-container sa-cta-banner__inner">
                        <div class="sa-cta-banner__left">
                            <img src="/shiningace_website/static/src/img/penguin.svg" alt="ShiningACE" class="sa-cta-banner__penguin"/>
                            <span class="sa-cta-banner__arrow">→</span>
                        </div>
                        <div class="sa-cta-banner__text">
                            <h2>Ready to boost your<br/>child's grades?</h2>
                            <p>Let our AI find the perfect tutor and help your child shine brighter.</p>
                        </div>
                        <div class="sa-cta-banner__actions">
                            <a href="#start" class="sa-btn sa-btn--cta">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                                Start with AI Assistant
                            </a>
                            <a href="#book-demo" class="sa-btn sa-btn--outline-yellow">Book Free Demo</a>
                        </div>
                    </div>
                </section>

                <!-- ── TRUST BAR ─────────────────────────────────────────── -->
                <section class="sa-trustbar">
                    <div class="sa-container sa-trustbar__inner">
                        <div class="sa-trustbar__item">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                            1-to-1 Personalised Learning
                        </div>
                        <div class="sa-trustbar__item">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            Flexible Scheduling
                        </div>
                        <div class="sa-trustbar__item">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            Safe &amp; Secure Platform
                        </div>
                        <div class="sa-trustbar__item">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                            Money-back Guarantee
                        </div>
                    </div>
                </section>

            </div><!-- /wrap -->
        </t>
    </template>


</odoo>
