<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shiningace_question_tag_tree" model="ir.ui.view">
        <field name="name">shiningace.question.tag.tree</field>
        <field name="model">shiningace.question.tag</field>
        <field name="arch" type="xml">
            <list string="Tags">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="question_count"/>
            </list>
        </field>
    </record>

    <record id="view_shiningace_question_tag_form" model="ir.ui.view">
        <field name="name">shiningace.question.tag.form</field>
        <field name="model">shiningace.question.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
