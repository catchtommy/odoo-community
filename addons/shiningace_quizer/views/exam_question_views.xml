<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shiningace_exam_question_tree" model="ir.ui.view">
        <field name="name">shiningace.exam.question.tree</field>
        <field name="model">shiningace.exam.question</field>
        <field name="arch" type="xml">
            <list string="Exam Questions" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="question_id"/>
                <field name="mark"/>
                <field name="is_required"/>
                <field name="question_type_name"/>
                <field name="difficulty"/>
            </list>
        </field>
    </record>

    <record id="view_shiningace_exam_question_form" model="ir.ui.view">
        <field name="name">shiningace.exam.question.form</field>
        <field name="model">shiningace.exam.question</field>
        <field name="arch" type="xml">
            <form string="Exam Question">
                <group>
                    <group>
                        <field name="exam_id"/>
                        <field name="question_id"/>
                        <field name="sequence"/>
                        <field name="mark"/>
                        <field name="is_required"/>
                        <field name="shuffle_answers"/>
                    </group>
                    <group>
                        <field name="question_type_name"/>
                        <field name="difficulty"/>
                        <field name="is_answered"/>
                        <field name="is_correct"/>
                        <field name="obtained_mark"/>
                    </group>
                </group>
                <group string="Grading">
                    <field name="student_answer"/>
                    <field name="feedback_given"/>
                    <field name="grader_notes"/>
                </group>
            </form>
        </field>
    </record>
</odoo>
