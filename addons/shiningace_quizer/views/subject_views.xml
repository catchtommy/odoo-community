<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shiningace_subject_tree" model="ir.ui.view">
        <field name="name">shiningace.subject.tree</field>
        <field name="model">shiningace.subject</field>
        <field name="arch" type="xml">
            <list string="Subjects" decoration-info="parent_id != False">
                <field name="code" optional="show"/>
                <field name="name" string="Subject Name"/>
                <field name="parent_id" string="Parent Subject"/>
                <field name="question_count" string="Questions"/>
                <field name="exam_count" string="Exams"/>
                <field name="homework_count" string="Homework"/>
            </list>
        </field>
    </record>

    <record id="view_shiningace_subject_form" model="ir.ui.view">
        <field name="name">shiningace.subject.form</field>
        <field name="model">shiningace.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_shiningace_question)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-question-circle"
                                context="{'default_subject_id': id}">
                            <div class="o_stat_info">
                                <field name="question_count"/>
                                <span class="o_stat_text">Questions</span>
                            </div>
                        </button>
                        <button name="%(action_shiningace_exam)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-file-text"
                                context="{'default_subject_id': id}">
                            <div class="o_stat_info">
                                <field name="exam_count"/>
                                <span class="o_stat_text">Exams</span>
                            </div>
                        </button>
                        <button name="%(action_shiningace_homework)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-tasks"
                                context="{'default_subject_id': id}">
                            <div class="o_stat_info">
                                <field name="homework_count"/>
                                <span class="o_stat_text">Homework</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" text="Archived" bg_color="bg-danger"/>

                    <field name="active" invisible="1"/>
                    <field name="parent_path" invisible="1"/>

                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Mathematics"/>
                            <field name="code" placeholder="e.g. MATH101"/>
                            <field name="parent_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>

                    <group>
                        <field name="description" placeholder="Subject description..."/>
                    </group>

                    <notebook>
                        <page name="questions" string="Questions">
                            <field name="question_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="question_type_id"/>
                                    <field name="difficulty_level"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page name="subjects" string="Sub-Subjects">
                            <field name="child_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shiningace_subject_search" model="ir.ui.view">
        <field name="name">shiningace.subject.search</field>
        <field name="model">shiningace.subject</field>
        <field name="arch" type="xml">
            <search string="Search Subjects">
                <field name="name"/>
                <field name="code"/>
                <filter name="group_parent" string="Parent" domain="[('parent_id', '=', False)]"/>
                <filter name="group_child" string="Sub-Subjects" domain="[('parent_id', '!=', False)]"/>
                <separator/>
                <filter name="group_by_parent" string="Parent" context="{'group_by': 'parent_id'}"/>
            </search>
        </field>
    </record>
</odoo>
