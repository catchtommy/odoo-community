<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shiningace_question_editor_wizard_form" model="ir.ui.view">
        <field name="name">shiningace.question.editor.wizard.form</field>
        <field name="model">shiningace.question.editor.wizard</field>
        <field name="arch" type="xml">
            <form string="Advanced Question Editor">
                <header>
                    <button name="action_switch_to_html" string="HTML Editor"
                            type="object" class="btn-secondary"/>
                    <button name="action_switch_to_latex" string="LaTeX Editor"
                            type="object" class="btn-secondary"/>
                    <button name="action_preview" string="Preview"
                            type="object" class="btn-info"/>
                </header>

                <group>
                    <field name="editor_mode" invisible="1"/>
                    <field name="question_id" invisible="1"/>
                </group>

                <!-- HTML Mode -->
                <group string="HTML Editor">
                    <field name="question_text_html" placeholder="Enter question with HTML formatting. Use $$...$$ for LaTeX equations."/>
                    <field name="answer_html" placeholder="Enter answer with HTML formatting..."/>
                    <field name="feedback_html" placeholder="Enter feedback with HTML formatting..."/>
                </group>

                <!-- LaTeX Mode -->
                <group string="LaTeX Editor">
                    <field name="question_text_latex" placeholder="\question
Enter your question in LaTeX here. You can use all LaTeX math environments.

\begin{equation}
E = mc^2
\end{equation}"/>
                    <field name="answer_latex" placeholder="% LaTeX answer"/>
                    <field name="feedback_latex" placeholder="% LaTeX feedback"/>
                </group>

                <!-- Preview Mode -->
                <group string="Preview">
                    <field name="preview_html"/>
                </group>

                <footer>
                    <button name="action_save" string="Save &amp; Close" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
