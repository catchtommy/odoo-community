<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_student_progress_list" model="ir.ui.view">
        <field name="name">education.student.progress.list</field>
        <field name="model">education.student.progress</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="lesson_id"/>
                <field name="status" widget="badge"/>
                <field name="completion_date"/>
                <field name="mastery_score"/>
            </list>
        </field>
    </record>

    <record id="view_education_student_progress_search" model="ir.ui.view">
        <field name="name">education.student.progress.search</field>
        <field name="model">education.student.progress</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="lesson_id"/>
                <group>
                    <filter name="group_by_student" string="Student" context="{'group_by': 'student_id'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_student_progress" model="ir.actions.act_window">
        <field name="name">Student Progress</field>
        <field name="res_model">education.student.progress</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
