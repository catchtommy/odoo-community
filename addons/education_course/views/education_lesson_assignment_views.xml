<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_lesson_assignment_list" model="ir.ui.view">
        <field name="name">education.lesson.assignment.list</field>
        <field name="model">education.lesson.assignment</field>
        <field name="arch" type="xml">
            <list>
                <field name="start_datetime"/>
                <field name="course_id"/>
                <field name="tutor_id"/>
                <field name="lesson_id"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_education_lesson_assignment_form" model="ir.ui.view">
        <field name="name">education.lesson.assignment.form</field>
        <field name="model">education.lesson.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="planned,in_progress,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="class_schedule_occurrence_id"/>
                            <field name="course_id" readonly="1"/>
                            <field name="tutor_id" readonly="1"/>
                            <field name="start_datetime" readonly="1"/>
                        </group>
                        <group>
                            <field name="lesson_id" domain="[('topic_id.curriculum_version_id.state', '=', 'published')]"/>
                            <field name="topic_id" readonly="1"/>
                            <field name="actual_duration_minutes"/>
                        </group>
                    </group>
                    <field name="notes"/>
                    <notebook>
                        <page string="Feedback">
                            <field name="feedback_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="author_id"/>
                                    <field name="feedback_type"/>
                                    <field name="rating"/>
                                    <field name="comments"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_education_lesson_assignment_search" model="ir.ui.view">
        <field name="name">education.lesson.assignment.search</field>
        <field name="model">education.lesson.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="course_id"/>
                <field name="tutor_id"/>
                <field name="lesson_id"/>
                <filter name="today" string="Today"
                        domain="[('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <group>
                    <filter name="group_by_course" string="Course" context="{'group_by': 'course_id'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_lesson_assignment" model="ir.actions.act_window">
        <field name="name">Lesson Assignments</field>
        <field name="res_model">education.lesson.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
