<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ───────────────────────────────────────────────────── -->
    <record id="view_qb_subject_list" model="ir.ui.view">
        <field name="name">qb.subject.list</field>
        <field name="model">qb.subject</field>
        <field name="arch" type="xml">
            <list string="Subjects" decoration-muted="not active">
                <field name="name"/>
                <field name="topic_count" string="Topics"/>
                <field name="question_count" string="Questions"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ───────────────────────────────────────────────────── -->
    <record id="view_qb_subject_form" model="ir.ui.view">
        <field name="name">qb.subject.form</field>
        <field name="model">qb.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_questions" icon="fa-question-circle">
                            <field name="question_count" widget="statinfo" string="Questions"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-list"
                                invisible="topic_count == 0">
                            <field name="topic_count" widget="statinfo" string="Topics"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Mathematics"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Brief description of this subject…"/>
                    <separator string="Topics"/>
                    <field name="topic_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="description"/>
                            <field name="question_count" string="Questions" readonly="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ──────────────────────────────────────────────────────── -->
    <record id="action_qb_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">qb.subject</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subject
            </p>
            <p>Subjects help you organise questions by discipline.</p>
        </field>
    </record>

</odoo>
