<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         LIST VIEW
    ════════════════════════════════════════════════════════════════════ -->
    <record id="view_qb_question_list" model="ir.ui.view">
        <field name="name">qb.question.list</field>
        <field name="model">qb.question</field>
        <field name="arch" type="xml">
            <list string="Questions"
                  decoration-success="state == 'approved'"
                  decoration-muted="not active">
                <field name="name" string="Question"/>
                <field name="question_type" widget="badge"/>
                <field name="subject_id"/>
                <field name="topic_id"/>
                <field name="difficulty" widget="badge"
                       decoration-success="difficulty == 'easy'"
                       decoration-warning="difficulty == 'medium'"
                       decoration-danger="difficulty == 'hard'"/>
                <field name="marks" string="Marks"/>
                <field name="option_count" string="Options" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'draft'"/>
                <field name="active" column_invisible="True"/>
                <button name="action_approve" string="Approve" type="object"
                        icon="fa-check" title="Approve question"
                        invisible="state == 'approved'"
                        groups="question_bank.group_qb_manager"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         KANBAN VIEW
    ════════════════════════════════════════════════════════════════════ -->
    <record id="view_qb_question_kanban" model="ir.ui.view">
        <field name="name">qb.question.kanban</field>
        <field name="model">qb.question</field>
        <field name="arch" type="xml">
            <kanban default_group_by="subject_id"
                    class="o_kanban_small_column"
                    group_create="false">
                <field name="name"/>
                <field name="question_type"/>
                <field name="difficulty"/>
                <field name="marks"/>
                <field name="subject_id"/>
                <field name="topic_id"/>
                <field name="state"/>
                <field name="tag_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="qb-kanban-card">
                            <!-- Type + Difficulty badges -->
                            <div class="qb-kanban-badges">
                                <span t-attf-class="badge qb-type-badge qb-type-#{record.question_type.raw_value}">
                                    <t t-esc="record.question_type.value"/>
                                </span>
                                <span t-attf-class="badge qb-diff-badge qb-diff-#{record.difficulty.raw_value}">
                                    <t t-esc="record.difficulty.value"/>
                                </span>
                            </div>
                            <!-- Title -->
                            <div class="qb-kanban-title fw-semibold mt-1">
                                <t t-esc="record.name.value"/>
                            </div>
                            <!-- Topic -->
                            <div class="qb-kanban-meta text-muted small mt-1">
                                <t t-if="record.topic_id.value">
                                    📚 <t t-esc="record.topic_id.value"/>
                                </t>
                            </div>
                            <!-- Footer -->
                            <div class="qb-kanban-footer d-flex justify-content-between align-items-center mt-2">
                                <span class="text-muted small">
                                    <t t-esc="record.marks.value"/> mark(s)
                                </span>
                                <span t-attf-class="badge #{record.state.raw_value == 'approved' ? 'text-bg-success' : 'text-bg-warning'}">
                                    <t t-esc="record.state.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         FORM VIEW
    ════════════════════════════════════════════════════════════════════ -->
    <record id="view_qb_question_form" model="ir.ui.view">
        <field name="name">qb.question.form</field>
        <field name="model">qb.question</field>
        <field name="arch" type="xml">
            <form string="Question" class="qb-question-form">
                <!-- ── Status bar ─────────────────────────────────────── -->
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="question_bank.group_qb_manager"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'approved'"
                            groups="question_bank.group_qb_manager"/>
                    <button name="action_duplicate" string="Duplicate" type="object"
                            icon="fa-copy"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved"/>
                </header>

                <sheet>
                    <!-- ── Smart buttons ─────────────────────────────── -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-check-circle"
                                invisible="question_type != 'mcq'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="correct_option_count"/>/<field name="option_count"/>
                                </span>
                                <span class="o_stat_text">Correct</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" text="Draft" bg_color="text-bg-warning"
                            invisible="state != 'draft'"/>
                    <widget name="web_ribbon" text="Approved" bg_color="text-bg-success"
                            invisible="state != 'approved'"/>

                    <!-- ── Metadata row ───────────────────────────────── -->
                    <group class="qb-meta-group">
                        <group string="Question Details">
                            <field name="name" placeholder="Enter question title…"/>
                            <field name="question_type" widget="radio"/>
                            <field name="subject_id"/>
                            <field name="topic_id"
                                   domain="[('subject_id','=',subject_id)]"/>
                            <field name="difficulty"/>
                            <field name="marks"/>
                        </group>
                        <group string="Classification">
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                            <field name="active"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>

                    <!-- ── Question Content ───────────────────────────── -->
                    <notebook class="qb-notebook">

                        <!-- TAB 1: Question Editor -->
                        <page string="Question" name="question_editor">
                            <group string="Question Content">
                                <field name="question_html" widget="html"
                                       nolabel="1"
                                       options="{'collaborative': False, 'resizable': True}"
                                       placeholder="Write the question here…"/>
                            </group>

                            <group string="LaTeX Equation (optional)">
                                <field name="latex_equation" widget="qb_latex_preview"
                                       nolabel="1"
                                       placeholder="e.g. x = \frac{-b \pm \sqrt{b^2 - 4ac}}{2a}"/>
                            </group>

                            <group string="Graph Config — JSON (optional)">
                                <field name="graph_json" widget="qb_graph_editor"
                                       nolabel="1"
                                       placeholder='{"type": "line", "equation": "y = x^2"}'/>
                            </group>

                            <group string="Images">
                                <field name="image_ids" widget="many2many_binary" nolabel="1"/>
                            </group>
                        </page>

                        <!-- TAB 2: Answers -->
                        <page string="Answers" name="answers">

                            <!-- MCQ Options -->
                            <group string="Answer Options" invisible="question_type != 'mcq'">
                                <field name="option_ids" nolabel="1"
                                       context="{'default_question_id': id}">
                                    <list editable="bottom" class="qb-options-list">
                                        <field name="sequence" widget="handle"/>
                                        <field name="option_text" widget="html"
                                               string="Option"/>
                                        <field name="is_correct" string="✓ Correct"/>
                                        <field name="explanation" string="Explanation"
                                               optional="show"/>
                                    </list>
                                </field>
                            </group>

                            <!-- True / False -->
                            <group string="Correct Answer" invisible="question_type != 'true_false'">
                                <field name="true_false_answer" widget="radio" nolabel="1"/>
                            </group>

                            <!-- Fill in the Blank -->
                            <group string="Correct Answer" invisible="question_type != 'fill_blank'">
                                <field name="blank_answer"
                                       placeholder="Enter the correct answer…"/>
                            </group>

                        </page>

                        <!-- TAB 3: Explanation -->
                        <page string="Explanation / Solution" name="explanation">
                            <field name="explanation" widget="html" nolabel="1"
                                   options="{'collaborative': False}"/>
                        </page>

                        <!-- TAB 4: Live Preview -->
                        <page string="Preview" name="preview">
                            <div id="qb-live-preview-root"
                                 data-question-form="1"
                                 class="qb-preview-wrapper p-3">
                                <!-- Populated by question_editor.js -->
                            </div>
                        </page>

                    </notebook>
                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         SEARCH VIEW
    ════════════════════════════════════════════════════════════════════ -->
    <record id="view_qb_question_search" model="ir.ui.view">
        <field name="name">qb.question.search</field>
        <field name="model">qb.question</field>
        <field name="arch" type="xml">
            <search string="Search Questions">
                <field name="name" string="Question" filter_domain="[('name','ilike',self)]"/>
                <field name="subject_id"/>
                <field name="topic_id"/>
                <field name="tag_ids"/>
                <separator/>
                <filter name="filter_mcq"        string="MCQ"
                        domain="[('question_type','=','mcq')]"/>
                <filter name="filter_true_false"  string="True / False"
                        domain="[('question_type','=','true_false')]"/>
                <filter name="filter_fill_blank"  string="Fill in the Blank"
                        domain="[('question_type','=','fill_blank')]"/>
                <separator/>
                <filter name="filter_easy"   string="Easy"   domain="[('difficulty','=','easy')]"/>
                <filter name="filter_medium" string="Medium" domain="[('difficulty','=','medium')]"/>
                <filter name="filter_hard"   string="Hard"   domain="[('difficulty','=','hard')]"/>
                <separator/>
                <filter name="filter_draft"    string="Draft"
                        domain="[('state','=','draft')]"/>
                <filter name="filter_approved" string="Approved"
                        domain="[('state','=','approved')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active','=',False)]"/>
                <filter name="group_subject"    string="Subject"
                        context="{'group_by':'subject_id'}"/>
                <filter name="group_topic"      string="Topic"
                        context="{'group_by':'topic_id'}"/>
                <filter name="group_type"       string="Type"
                        context="{'group_by':'question_type'}"/>
                <filter name="group_difficulty" string="Difficulty"
                        context="{'group_by':'difficulty'}"/>
                <filter name="group_state"      string="Status"
                        context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         ACTION
    ════════════════════════════════════════════════════════════════════ -->
    <record id="action_qb_question" model="ir.actions.act_window">
        <field name="name">Questions</field>
        <field name="res_model">qb.question</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_qb_question_search"/>
        <field name="context">{'search_default_filter_draft': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first question
            </p>
            <p>Build MCQ, True/False, or Fill-in-the-Blank questions with rich
               content including equations, images, and graphs.</p>
        </field>
    </record>

</odoo>
