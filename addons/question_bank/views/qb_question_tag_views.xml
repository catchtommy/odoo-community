<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="qb_question_tag_view_form" model="ir.ui.view">
        <field name="name">qb.question.tag.form</field>
        <field name="model">qb.question.tag</field>
        <field name="arch" type="xml">
            <form string="Question Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="question_count"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="qb_question_tag_view_tree" model="ir.ui.view">
        <field name="name">qb.question.tag.tree</field>
        <field name="model">qb.question.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="question_count"/>
            </list>
        </field>
    </record>
    
    <record id="action_qb_question_tag" model="ir.actions.act_window">
        <field name="name">Question Tags</field>
        <field name="res_model">qb.question.tag</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
