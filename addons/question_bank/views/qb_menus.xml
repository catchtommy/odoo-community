<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Top-level app menu ───────────────────────────────────────────── -->
    <menuitem id="menu_qb_root"
              name="Question Bank"
              sequence="80"
              web_icon="question_bank,static/description/icon.png"
              groups="question_bank.group_qb_user"/>

    <!-- ── Question Bank (Moodle-style main view) ───────────────────────── -->
    <menuitem id="menu_qb_question_bank"
              name="Question Bank"
              parent="menu_qb_root"
              sequence="5"
              action="action_qb_question_bank"
              groups="question_bank.group_qb_user"/>

    <!-- ── Questions Submenu ───────────────────────────────────────────── -->
    <menuitem id="menu_qb_questions_section"
              name="Questions"
              parent="menu_qb_root"
              sequence="10"
              groups="question_bank.group_qb_user"/>

    <menuitem id="menu_qb_questions"
              name="All Questions"
              parent="menu_qb_questions_section"
              sequence="10"
              action="action_qb_question_bank"
              groups="question_bank.group_qb_user"/>
    
    <menuitem id="menu_qb_my_questions"
              name="My Questions"
              parent="menu_qb_questions_section"
              sequence="20"
              action="action_qb_question"
              groups="question_bank.group_qb_user"/>

    <!-- ── Import / Export ─────────────────────────────────────────────── -->
    <menuitem id="menu_qb_import_export"
              name="Import/Export"
              parent="menu_qb_root"
              sequence="80"
              groups="question_bank.group_qb_user"/>

    <menuitem id="menu_qb_import_moodle"
              name="Import from Moodle"
              parent="menu_qb_import_export"
              sequence="10"
              action="action_qb_moodle_import"
              groups="question_bank.group_qb_user"/>

    <!-- ── Configuration submenu ───────────────────────────────────────── -->
    <menuitem id="menu_qb_config"
              name="Configuration"
              parent="menu_qb_root"
              sequence="90"
              groups="question_bank.group_qb_manager"/>

    <menuitem id="menu_qb_subjects"
              name="Subjects"
              parent="menu_qb_config"
              sequence="10"
              action="action_qb_subject"
              groups="question_bank.group_qb_manager"/>

    <menuitem id="menu_qb_topics"
              name="Topics"
              parent="menu_qb_config"
              sequence="20"
              action="action_qb_topic"
              groups="question_bank.group_qb_manager"/>
    
    <menuitem id="menu_qb_tags"
              name="Tags"
              parent="menu_qb_config"
              sequence="30"
              action="action_qb_question_tag"
              groups="question_bank.group_qb_manager"/>
              action="action_qb_topic"
              groups="question_bank.group_qb_manager"/>

    <menuitem id="menu_qb_tags"
              name="Tags"
              parent="menu_qb_config"
              sequence="30"
              action="action_qb_tag"
              groups="question_bank.group_qb_manager"/>

</odoo>
