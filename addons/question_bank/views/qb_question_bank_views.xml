<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Question Bank Kanban View (Moodle-style) -->
    <record id="qb_question_view_kanban_bank" model="ir.ui.view">
        <field name="name">qb.question.kanban.bank</field>
        <field name="model">qb.question</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="question_type"/>
                <field name="subject_id"/>
                <field name="topic_id"/>
                <field name="difficulty"/>
                <field name="state"/>
                <field name="tag_ids"/>
                <field name="usage_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="question_preview"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge badge-pill">
                                        <field name="type_display"/>
                                    </span>
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection" 
                                           options="{'classes': {'draft': 'secondary', 'approved': 'success'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Question Bank List View (Moodle-style Grid) -->
    <record id="qb_question_view_tree_bank" model="ir.ui.view">
        <field name="name">qb.question.tree.bank</field>
        <field name="model">qb.question</field>
        <field name="arch" type="xml">
            <list string="Question Bank" 
                  multi_edit="1" 
                  sample="1"
                  decoration-info="state == 'draft'">
                
                <field name="sequence" widget="handle"/>
                <field name="name" string="Question Name"/>
                <field name="question_preview" string="Preview" optional="show"/>
                <field name="type_display" string="Type"/>
                <field name="subject_id" optional="show"/>
                <field name="topic_id" optional="show"/>
                <field name="difficulty" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'approved'"
                       decoration-info="state == 'draft'"/>
                <field name="usage_count" string="Used" optional="hide"/>
                <field name="created_by" string="Author" optional="hide"/>
                <field name="create_date" string="Created" optional="hide"/>
                <field name="write_date" string="Modified" optional="hide"/>
                
                <button name="action_preview_question" 
                        type="object" 
                        icon="fa-eye" 
                        title="Preview Question"/>
                <button name="action_create_version" 
                        type="object" 
                        icon="fa-code-fork" 
                        title="Create Version"
                        invisible="parent_question_id"/>
                <button name="action_duplicate_question" 
                        type="object" 
                        icon="fa-copy" 
                        title="Duplicate"/>
            </list>
        </field>
    </record>

    <!-- Question Preview Form (Modal) -->
    <record id="qb_question_view_form_preview" model="ir.ui.view">
        <field name="name">qb.question.form.preview</field>
        <field name="model">qb.question</field>
        <field name="arch" type="xml">
            <form string="Question Preview" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="question_type" readonly="1"/>
                            <field name="subject_id" readonly="1"/>
                            <field name="topic_id" readonly="1"/>
                            <field name="difficulty" readonly="1"/>
                        </group>
                        <group>
                            <field name="marks" readonly="1"/>
                            <field name="negative_marks" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="tag_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Question" name="question">
                            <group>
                                <field name="question_html" widget="html" readonly="1" nolabel="1"/>
                            </group>
                            
                            <!-- MCQ Options -->
                            <field name="option_ids" readonly="1" 
                                   invisible="question_type != 'mcq'">
                                <list>
                                    <field name="option_text"/>
                                    <field name="is_correct" widget="boolean_toggle"/>
                                </list>
                            </field>
                            
                            <!-- True/False Answer -->
                            <group invisible="question_type != 'true_false'">
                                <field name="true_false_answer" readonly="1"/>
                            </group>
                            
                            <!-- Fill in Blank Answer -->
                            <group invisible="question_type != 'fill_blank'">
                                <field name="blank_answer" readonly="1"/>
                            </group>
                        </page>
                        
                        <page string="Explanation" name="explanation">
                            <field name="explanation" widget="html" readonly="1"/>
                        </page>
                        
                        <page string="Statistics" name="statistics">
                            <group>
                                <group>
                                    <field name="usage_count" readonly="1"/>
                                    <field name="last_used_date" readonly="1"/>
                                    <field name="average_score" readonly="1"/>
                                </group>
                                <group>
                                    <field name="created_by" readonly="1"/>
                                    <field name="create_date" readonly="1"/>
                                    <field name="modified_by" readonly="1"/>
                                    <field name="write_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Edit" name="action_edit_from_preview" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Question Bank Search View (Enhanced Filters) -->
    <record id="qb_question_view_search_bank" model="ir.ui.view">
        <field name="name">qb.question.search.bank</field>
        <field name="model">qb.question</field>
        <field name="arch" type="xml">
            <search string="Question Bank">
                <field name="name" string="Question" 
                       filter_domain="['|', ('name', 'ilike', self), ('question_html', 'ilike', self)]"/>
                <field name="subject_id"/>
                <field name="topic_id"/>
                <field name="tag_ids"/>
                <field name="created_by"/>
                
                <filter string="My Questions" name="my_questions" 
                        domain="[('created_by', '=', uid)]"/>
                <filter string="Shared with Me" name="shared" 
                        domain="[('is_shared', '=', True), ('created_by', '!=', uid)]"/>
                <separator/>
                
                <filter string="Draft" name="draft" 
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="approved" 
                        domain="[('state', '=', 'approved')]"/>
                <separator/>
                
                <filter string="MCQ" name="mcq" 
                        domain="[('question_type', '=', 'mcq')]"/>
                <filter string="True/False" name="true_false" 
                        domain="[('question_type', '=', 'true_false')]"/>
                <filter string="Fill in Blank" name="fill_blank" 
                        domain="[('question_type', '=', 'fill_blank')]"/>
                <separator/>
                
                <filter string="Easy" name="easy" 
                        domain="[('difficulty', '=', 'easy')]"/>
                <filter string="Medium" name="medium" 
                        domain="[('difficulty', '=', 'medium')]"/>
                <filter string="Hard" name="hard" 
                        domain="[('difficulty', '=', 'hard')]"/>
                <separator/>
                
                <filter string="Recently Used" name="recently_used" 
                        domain="[('usage_count', '>', 0)]" 
                        context="{'order': 'last_used_date desc'}"/>
                <filter string="Never Used" name="never_used" 
                        domain="[('usage_count', '=', 0)]"/>
                <separator/>
                
                <group name="group_by">
                    <filter string="Subject" name="group_subject" 
                            context="{'group_by': 'subject_id'}"/>
                    <filter string="Topic" name="group_topic" 
                            context="{'group_by': 'topic_id'}"/>
                    <filter string="Type" name="group_type" 
                            context="{'group_by': 'question_type'}"/>
                    <filter string="Difficulty" name="group_difficulty" 
                            context="{'group_by': 'difficulty'}"/>
                    <filter string="State" name="group_state" 
                            context="{'group_by': 'state'}"/>
                    <filter string="Created By" name="group_author" 
                            context="{'group_by': 'created_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Question Bank Main Action -->
    <record id="action_qb_question_bank" model="ir.actions.act_window">
        <field name="name">Question Bank</field>
        <field name="res_model">qb.question</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('qb_question_view_tree_bank')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('qb_question_view_kanban_bank')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_qb_question_form')})]"/>
        <field name="search_view_id" ref="qb_question_view_search_bank"/>
        <field name="context">{
            'search_default_approved': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first question
            </p>
            <p>
                Build your question bank with multiple choice, true/false, and fill in the blank questions.
            </p>
        </field>
    </record>

</odoo>
