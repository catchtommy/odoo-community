<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Module category -->
        <record id="module_category_question_bank" model="ir.module.category">
            <field name="name">Question Bank</field>
            <field name="description">Manage exam questions and assessments.</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privilege (groups category in Odoo 19) -->
        <record id="privilege_qb_access" model="res.groups.privilege">
            <field name="name">Question Bank</field>
            <field name="category_id" ref="module_category_question_bank"/>
        </record>

        <!-- User group: can create/edit questions -->
        <record id="group_qb_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_qb_access"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Manager group: can approve/delete/configure -->
        <!-- implied_ids means: being a Manager also grants User permissions -->
        <record id="group_qb_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_qb_access"/>
            <field name="implied_ids" eval="[(4, ref('group_qb_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
