<?xml version="1.0" encoding="utf-8"?>
<templates>

    <!-- ══════════════════════════════════════════════════════════
         Live Preview Panel
    ══════════════════════════════════════════════════════════ -->
    <t t-name="question_bank.QuestionPreview">
        <div class="qb-preview">
            <div t-if="!props.question.name" class="qb-preview-empty">
                <i class="fa fa-eye-slash fa-2x text-muted"/>
                <p class="text-muted mt-2">Fill in the question details to see a live preview.</p>
            </div>

            <div t-else="" class="qb-preview-content">
                <!-- Header badges -->
                <div class="qb-preview-badges d-flex gap-2 flex-wrap mb-3">
                    <span t-attf-class="badge qb-type-badge qb-type-#{props.question.question_type}">
                        <t t-esc="typeLabel"/>
                    </span>
                    <span t-attf-class="badge qb-diff-badge qb-diff-#{props.question.difficulty}">
                        <t t-esc="difficultyLabel"/>
                    </span>
                    <span class="badge text-bg-secondary">
                        <t t-esc="props.question.marks"/> mark(s)
                    </span>
                </div>

                <!-- Question title -->
                <h5 class="qb-preview-title"><t t-esc="props.question.name"/></h5>

                <!-- Question HTML content -->
                <div t-if="props.question.question_html"
                     class="qb-preview-html"
                     t-out="props.question.question_html"/>

                <!-- LaTeX equation -->
                <div t-if="props.question.latex_equation" class="qb-preview-latex">
                    <div class="qb-preview-section-label">Equation</div>
                    <div class="qb-latex-render" t-ref="latexContainer">
                        \( <t t-esc="props.question.latex_equation"/> \)
                    </div>
                </div>

                <!-- Graph placeholder -->
                <div t-if="props.question.graph_json" class="qb-preview-graph">
                    <div class="qb-preview-section-label">Graph</div>
                    <div class="qb-graph-placeholder">
                        <i class="fa fa-line-chart fa-2x text-muted"/>
                        <pre class="mt-2 qb-graph-json"><t t-esc="formattedGraph"/></pre>
                    </div>
                </div>

                <!-- MCQ options -->
                <div t-if="props.question.question_type === 'mcq' and props.question.options and props.question.options.length"
                     class="qb-preview-options mt-3">
                    <div class="qb-preview-section-label">Options</div>
                    <div class="qb-preview-options-list">
                        <t t-foreach="props.question.options" t-as="opt" t-key="opt_index">
                            <div t-attf-class="qb-preview-option #{opt.is_correct ? 'qb-preview-option--correct' : ''}">
                                <span class="qb-option-letter">
                                    <t t-esc="String.fromCharCode(65 + opt_index)"/>
                                </span>
                                <span class="qb-option-text" t-out="opt.option_text"/>
                                <i t-if="opt.is_correct" class="fa fa-check-circle text-success ms-2"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- True/False answer -->
                <div t-if="props.question.question_type === 'true_false' and props.question.true_false_answer"
                     class="qb-preview-tf mt-3">
                    <div class="qb-preview-section-label">Correct Answer</div>
                    <span t-attf-class="badge fs-6 #{props.question.true_false_answer === 'true' ? 'text-bg-success' : 'text-bg-danger'}">
                        <i t-attf-class="fa #{props.question.true_false_answer === 'true' ? 'fa-check' : 'fa-times'} me-1"/>
                        <t t-esc="props.question.true_false_answer === 'true' ? 'TRUE' : 'FALSE'"/>
                    </span>
                </div>

                <!-- Fill in the blank answer -->
                <div t-if="props.question.question_type === 'fill_blank' and props.question.blank_answer"
                     class="qb-preview-blank mt-3">
                    <div class="qb-preview-section-label">Correct Answer</div>
                    <span class="badge text-bg-primary fs-6">
                        <i class="fa fa-key me-1"/>
                        <t t-esc="props.question.blank_answer"/>
                    </span>
                </div>

                <!-- Explanation -->
                <div t-if="props.question.explanation" class="qb-preview-explanation mt-3">
                    <div class="qb-preview-section-label">
                        <i class="fa fa-lightbulb-o me-1"/> Explanation
                    </div>
                    <div class="qb-preview-html qb-preview-html--explanation"
                         t-out="props.question.explanation"/>
                </div>
            </div>
        </div>
    </t>

    <!-- ══════════════════════════════════════════════════════════
         LaTeX Preview Widget
    ══════════════════════════════════════════════════════════ -->
    <t t-name="question_bank.LatexPreviewWidget">
        <div class="qb-latex-widget">
            <textarea class="qb-latex-input o_field_char"
                      t-att-value="props.value or ''"
                      t-on-input="onInput"
                      t-att-placeholder="props.placeholder or 'Enter LaTeX…'"
                      rows="2"/>
            <div t-if="props.value" class="qb-latex-preview-box">
                <span class="qb-preview-section-label small">Preview</span>
                <div class="qb-latex-render" t-ref="latexBox">
                    \( <t t-esc="props.value"/> \)
                </div>
            </div>
        </div>
    </t>

    <!-- ══════════════════════════════════════════════════════════
         Graph Editor Widget
    ══════════════════════════════════════════════════════════ -->
    <t t-name="question_bank.GraphEditorWidget">
        <div class="qb-graph-widget">
            <textarea class="qb-graph-input o_field_char"
                      t-att-value="props.value or ''"
                      t-on-input="onInput"
                      t-att-placeholder="props.placeholder or '{&quot;type&quot;: &quot;line&quot;, &quot;equation&quot;: &quot;y = x^2&quot;}'"
                      rows="4"/>
            <div t-if="jsonValid and props.value" class="qb-graph-preview-box">
                <span class="qb-preview-section-label small">
                    <i class="fa fa-check-circle text-success me-1"/> Valid JSON
                </span>
                <pre class="qb-graph-json-display"><t t-esc="formattedJson"/></pre>
                <div class="qb-graph-placeholder-visual">
                    <i class="fa fa-line-chart fa-3x text-muted"/>
                    <div class="text-muted small mt-1">Graph will render here (Plotly/Desmos integration)</div>
                </div>
            </div>
            <div t-if="!jsonValid and props.value" class="alert alert-warning py-1 mt-1 small">
                <i class="fa fa-exclamation-triangle me-1"/> Invalid JSON — please check syntax.
            </div>
        </div>
    </t>

</templates>
