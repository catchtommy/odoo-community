<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Note: ir.rule domain_force can only reference `user`/`company_id`/`company_ids`
         (see ir.rule._eval_context) — no date/time functions are available server-side,
         so expiry_date filtering is enforced at the application layer (portal
         controllers), not here. These rules cover state + visibility only. -->

    <record id="rule_education_lesson_content_student" model="ir.rule">
        <field name="name">Lesson Content: student visibility</field>
        <field name="model_id" ref="model_education_lesson_content"/>
        <field name="domain_force">[('state', '=', 'published'), ('visibility', 'in', ('student', 'public'))]</field>
        <field name="groups" eval="[(4, ref('education_core.group_education_student'))]"/>
    </record>

    <record id="rule_education_lesson_content_tutor" model="ir.rule">
        <field name="name">Lesson Content: tutor visibility</field>
        <field name="model_id" ref="model_education_lesson_content"/>
        <field name="domain_force">[('state', '=', 'published'), ('visibility', 'in', ('tutor', 'student', 'public'))]</field>
        <field name="groups" eval="[(4, ref('education_core.group_education_tutor'))]"/>
    </record>

    <record id="rule_education_resource_student" model="ir.rule">
        <field name="name">Resource: student visibility</field>
        <field name="model_id" ref="model_education_resource"/>
        <field name="domain_force">[('state', '=', 'published'), ('visibility', 'in', ('student', 'public'))]</field>
        <field name="groups" eval="[(4, ref('education_core.group_education_student'))]"/>
    </record>

    <record id="rule_education_resource_tutor" model="ir.rule">
        <field name="name">Resource: tutor visibility</field>
        <field name="model_id" ref="model_education_resource"/>
        <field name="domain_force">[('state', '=', 'published'), ('visibility', 'in', ('tutor', 'student', 'public'))]</field>
        <field name="groups" eval="[(4, ref('education_core.group_education_tutor'))]"/>
    </record>

    <!-- See education_curriculum_security.xml for why this is needed: without
         it, Curriculum Manager/Administrator (which implies Tutor/Student)
         would inherit the visibility restrictions above. -->
    <record id="rule_education_lesson_content_manager_full" model="ir.rule">
        <field name="name">Lesson Content: full access for Curriculum Manager</field>
        <field name="model_id" ref="model_education_lesson_content"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('education_core.group_education_curriculum_manager'))]"/>
    </record>

    <record id="rule_education_resource_manager_full" model="ir.rule">
        <field name="name">Resource: full access for Curriculum Manager</field>
        <field name="model_id" ref="model_education_resource"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('education_core.group_education_curriculum_manager'))]"/>
    </record>
</odoo>
