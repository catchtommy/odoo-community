<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_content_type_list" model="ir.ui.view">
        <field name="name">education.content.type.list</field>
        <field name="model">education.content.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="icon"/>
                <field name="is_previewable"/>
                <field name="is_downloadable"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_education_content_type" model="ir.actions.act_window">
        <field name="name">Content Types</field>
        <field name="res_model">education.content.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
