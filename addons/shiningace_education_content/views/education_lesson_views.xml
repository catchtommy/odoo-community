<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_lesson_list" model="ir.ui.view">
        <field name="name">education.lesson.list</field>
        <field name="model">education.lesson</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="topic_id"/>
                <field name="duration_minutes"/>
                <field name="content_count"/>
                <field name="state" widget="badge"/>
                <field name="proposed_by_id" optional="hide"/>
                <field name="approval_state" widget="badge" decoration-warning="approval_state == 'pending'" decoration-danger="approval_state == 'rejected'" decoration-success="approval_state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_education_lesson_form" model="ir.ui.view">
        <field name="name">education.lesson.form</field>
        <field name="model">education.lesson</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve_proposal" type="object" string="Approve" class="btn-primary" invisible="approval_state != 'pending'"/>
                    <button name="action_reject_proposal" type="object" string="Reject" invisible="approval_state != 'pending'"/>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_archive_lesson" type="object" string="Archive" invisible="state != 'published'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Lesson 3: Equivalent Fractions"/></h1>
                    </div>
                    <widget name="web_ribbon" title="Pending Review" bg_color="text-bg-warning" invisible="approval_state != 'pending'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="approval_state != 'rejected'"/>
                    <group>
                        <group>
                            <field name="topic_id"/>
                            <field name="subtopic_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="duration_minutes"/>
                            <field name="objective_ids" widget="many2many_tags"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group invisible="approval_state == 'approved' and not proposed_by_id" string="Tutor Proposal">
                        <group>
                            <field name="proposed_by_id" readonly="1"/>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="review_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="review_notes" placeholder="Notes for the tutor (shown when rejecting)…"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lesson Plans">
                            <field name="lesson_plan_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="summary"/>
                                    <field name="duration_minutes"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Content">
                            <field name="content_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="content_type_id"/>
                                    <field name="content_filename" column_invisible="1"/>
                                    <field name="content_file" widget="binary" filename="content_filename" string="File"/>
                                    <field name="external_url" string="URL" placeholder="https://…"/>
                                    <field name="visibility"/>
                                    <field name="state"/>
                                    <field name="id" widget="content_preview_button" string="Preview"/>
                                </list>
                            </field>
                        </page>
                        <page string="AI / RAG Metadata">
                            <group>
                                <field name="keywords"/>
                                <field name="ai_description"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_education_lesson_search" model="ir.ui.view">
        <field name="name">education.lesson.search</field>
        <field name="model">education.lesson</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="topic_id"/>
                <field name="subject_id"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="pending_review" string="Pending Review" domain="[('approval_state', '=', 'pending')]"/>
                <group>
                    <filter name="group_by_topic" string="Topic" context="{'group_by': 'topic_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_approval_state" string="Approval Status" context="{'group_by': 'approval_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_lesson" model="ir.actions.act_window">
        <field name="name">Lessons</field>
        <field name="res_model">education.lesson</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
