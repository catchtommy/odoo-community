<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_lesson_plan_list" model="ir.ui.view">
        <field name="name">education.lesson.plan.list</field>
        <field name="model">education.lesson.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="lesson_id"/>
                <field name="topic_id"/>
                <field name="curriculum_version_id"/>
                <field name="duration_minutes"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_education_lesson_plan_form" model="ir.ui.view">
        <field name="name">education.lesson.plan.form</field>
        <field name="model">education.lesson.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="lesson_id"/>
                            <field name="topic_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="curriculum_version_id" readonly="1"/>
                            <field name="duration_minutes"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <field name="plan_text"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_education_lesson_plan_search" model="ir.ui.view">
        <field name="name">education.lesson.plan.search</field>
        <field name="model">education.lesson.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lesson_id"/>
                <field name="topic_id"/>
                <field name="curriculum_version_id"/>
                <group>
                    <filter name="group_by_version" string="Curriculum Version" context="{'group_by': 'curriculum_version_id'}"/>
                    <filter name="group_by_topic" string="Topic" context="{'group_by': 'topic_id'}"/>
                    <filter name="group_by_lesson" string="Lesson" context="{'group_by': 'lesson_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_lesson_plan" model="ir.actions.act_window">
        <field name="name">Lesson Plans</field>
        <field name="res_model">education.lesson.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_topic': 1}</field>
    </record>
</odoo>
