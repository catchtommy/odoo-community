<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_lesson_content_list" model="ir.ui.view">
        <field name="name">education.lesson.content.list</field>
        <field name="model">education.lesson.content</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="lesson_id"/>
                <field name="content_type_id"/>
                <field name="visibility"/>
                <field name="state" widget="badge"/>
                <field name="version"/>
                <field name="proposed_by_id" optional="hide"/>
                <field name="approval_state" widget="badge" decoration-warning="approval_state == 'pending'" decoration-danger="approval_state == 'rejected'" decoration-success="approval_state == 'approved'"/>
                <field name="content_filename" column_invisible="1"/>
                <field name="external_url" column_invisible="1"/>
                <field name="id" widget="content_preview_button" string="Preview"/>
            </list>
        </field>
    </record>

    <record id="view_education_lesson_content_form" model="ir.ui.view">
        <field name="name">education.lesson.content.form</field>
        <field name="model">education.lesson.content</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve_proposal" type="object" string="Approve" class="btn-primary" invisible="approval_state != 'pending'"/>
                    <button name="action_reject_proposal" type="object" string="Reject" invisible="approval_state != 'pending'"/>
                    <button name="action_new_version" type="object" string="New Version" class="btn-secondary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <widget name="web_ribbon" title="Pending Review" bg_color="text-bg-warning" invisible="approval_state != 'pending'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="approval_state != 'rejected'"/>
                    <group>
                        <group>
                            <field name="lesson_id"/>
                            <field name="content_type_id"/>
                            <field name="content_category_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="visibility"/>
                            <field name="language_id"/>
                            <field name="publish_date"/>
                            <field name="expiry_date"/>
                            <field name="is_downloadable"/>
                            <field name="is_previewable"/>
                            <field name="version" readonly="1"/>
                            <field name="previous_version_id" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="approval_state == 'approved' and not proposed_by_id" string="Tutor Proposal">
                        <group>
                            <field name="proposed_by_id" readonly="1"/>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="review_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="review_notes" placeholder="Notes for the tutor (shown when rejecting)…"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="File / Link">
                            <group>
                                <field name="content_filename" invisible="1"/>
                                <field name="content_file" widget="binary" filename="content_filename" string="File"/>
                                <field name="external_url" placeholder="https://…"/>
                                <field name="id" widget="content_preview_button" string="Preview"/>
                            </group>
                        </page>
                        <page string="Rich Text">
                            <field name="body"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_education_lesson_content_search" model="ir.ui.view">
        <field name="name">education.lesson.content.search</field>
        <field name="model">education.lesson.content</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lesson_id"/>
                <field name="content_type_id"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="pending_review" string="Pending Review" domain="[('approval_state', '=', 'pending')]"/>
                <group>
                    <filter name="group_by_type" string="Content Type" context="{'group_by': 'content_type_id'}"/>
                    <filter name="group_by_lesson" string="Lesson" context="{'group_by': 'lesson_id'}"/>
                    <filter name="group_by_approval_state" string="Approval Status" context="{'group_by': 'approval_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_lesson_content" model="ir.actions.act_window">
        <field name="name">Lesson Content</field>
        <field name="res_model">education.lesson.content</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
