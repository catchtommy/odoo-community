<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ══════════════════════════════════════════════════════════════════════════
     ACTIONS — declared first so stat buttons can reference them via %(id)d
     ══════════════════════════════════════════════════════════════════════════ -->

    <record id="action_learning_country" model="ir.actions.act_window">
        <field name="name">Countries</field>
        <field name="res_model">learning.country</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="action_exam_board" model="ir.actions.act_window">
        <field name="name">Exam Boards</field>
        <field name="res_model">exam.board</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_grade_group" model="ir.actions.act_window">
        <field name="name">Grade Groups</field>
        <field name="res_model">grade.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_grade_level" model="ir.actions.act_window">
        <field name="name">Grade Levels</field>
        <field name="res_model">grade.level</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_curriculum_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">curriculum.subject</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_curriculum_topic" model="ir.actions.act_window">
        <field name="name">Topics</field>
        <field name="res_model">curriculum.topic</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_curriculum_skill" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">curriculum.skill</field>
        <field name="view_mode">list,form</field>
    </record>


<!-- ══════════════════════════════════════════════════════════════════════════
     LEARNING COUNTRY
     ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_learning_country_list" model="ir.ui.view">
        <field name="name">learning.country.list</field>
        <field name="model">learning.country</field>
        <field name="arch" type="xml">
            <list string="Countries" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="board_count" string="Exam Boards"/>
                <field name="group_count" string="Grade Groups"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_learning_country_form" model="ir.ui.view">
        <field name="name">learning.country.form</field>
        <field name="model">learning.country</field>
        <field name="arch" type="xml">
            <form string="Learning Country">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Country Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. UK, US, IN"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Exam Boards" name="boards">
                            <field name="board_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Grade Groups" name="groups">
                            <field name="group_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="level_count" string="Levels"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_learning_country_search" model="ir.ui.view">
        <field name="name">learning.country.search</field>
        <field name="model">learning.country</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>


<!-- ══════════════════════════════════════════════════════════════════════════
     EXAM BOARD
     ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_exam_board_list" model="ir.ui.view">
        <field name="name">exam.board.list</field>
        <field name="model">exam.board</field>
        <field name="arch" type="xml">
            <list string="Exam Boards" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="topic_count" string="Topics"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_exam_board_form" model="ir.ui.view">
        <field name="name">exam.board.form</field>
        <field name="model">exam.board</field>
        <field name="arch" type="xml">
            <form string="Exam Board">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Exam Board Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. GCSE, IB, SAT"/>
                            <field name="country_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_exam_board_search" model="ir.ui.view">
        <field name="name">exam.board.search</field>
        <field name="model">exam.board</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <group name="group_by">
                    <filter name="group_country" string="Country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>


<!-- ══════════════════════════════════════════════════════════════════════════
     GRADE GROUP
     ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_grade_group_list" model="ir.ui.view">
        <field name="name">grade.group.list</field>
        <field name="model">grade.group</field>
        <field name="arch" type="xml">
            <list string="Grade Groups" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="country_id"/>
                <field name="level_count" string="Levels"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_grade_group_form" model="ir.ui.view">
        <field name="name">grade.group.form</field>
        <field name="model">grade.group</field>
        <field name="arch" type="xml">
            <form string="Grade Group">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Primary, Secondary, GCSE"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="country_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Grade Levels" name="levels">
                            <field name="level_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="topic_count" string="Topics"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


<!-- ══════════════════════════════════════════════════════════════════════════
     GRADE LEVEL
     ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_grade_level_list" model="ir.ui.view">
        <field name="name">grade.level.list</field>
        <field name="model">grade.level</field>
        <field name="arch" type="xml">
            <list string="Grade Levels" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="group_id"/>
                <field name="country_id"/>
                <field name="topic_count" string="Topics"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_grade_level_form" model="ir.ui.view">
        <field name="name">grade.level.form</field>
        <field name="model">grade.level</field>
        <field name="arch" type="xml">
            <form string="Grade Level">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Grade 5, Year 9, Form 2"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. 5, 9, F2"/>
                            <field name="group_id"/>
                            <field name="country_id" readonly="1"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


<!-- ══════════════════════════════════════════════════════════════════════════
     CURRICULUM SUBJECT
     ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_curriculum_subject_list" model="ir.ui.view">
        <field name="name">curriculum.subject.list</field>
        <field name="model">curriculum.subject</field>
        <field name="arch" type="xml">
            <list string="Subjects" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="topic_count" string="Topics"/>
                <field name="skill_count" string="Skills"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_curriculum_subject_form" model="ir.ui.view">
        <field name="name">curriculum.subject.form</field>
        <field name="model">curriculum.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Subject Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. M, E, S, SCI"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_curriculum_subject_search" model="ir.ui.view">
        <field name="name">curriculum.subject.search</field>
        <field name="model">curriculum.subject</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>


<!-- ══════════════════════════════════════════════════════════════════════════
     CURRICULUM TOPIC
     ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_curriculum_topic_list" model="ir.ui.view">
        <field name="name">curriculum.topic.list</field>
        <field name="model">curriculum.topic</field>
        <field name="arch" type="xml">
            <list string="Topics" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="subject_id"/>
                <field name="grade_id"/>
                <field name="board_id"/>
                <field name="country_id"/>
                <field name="skill_count" string="Skills"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_curriculum_topic_form" model="ir.ui.view">
        <field name="name">curriculum.topic.form</field>
        <field name="model">curriculum.topic</field>
        <field name="arch" type="xml">
            <form string="Topic">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Topic Name"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="code" placeholder="e.g. F, GRA, CE"/>
                            <field name="subject_id"/>
                            <field name="board_id"/>
                            <field name="country_id" readonly="1"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Grade">
                            <field name="grade_id"/>
                            <field name="group_id" readonly="1"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Skills" name="skills">
                            <field name="skill_ids">
                                <list editable="bottom" default_order="sequence">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="Describe the skill / learning outcome..."/>
                                    <field name="unique_skill_code" readonly="1" optional="show"/>
                                    <field name="difficulty_level"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_curriculum_topic_search" model="ir.ui.view">
        <field name="name">curriculum.topic.search</field>
        <field name="model">curriculum.topic</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="subject_id"/>
                <field name="grade_id"/>
                <field name="board_id"/>
                <field name="country_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group name="group_by">
                    <filter name="group_subject" string="Subject" context="{'group_by': 'subject_id'}"/>
                    <filter name="group_grade" string="Grade" context="{'group_by': 'grade_id'}"/>
                    <filter name="group_board" string="Exam Board" context="{'group_by': 'board_id'}"/>
                    <filter name="group_country" string="Country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>


<!-- ══════════════════════════════════════════════════════════════════════════
     CURRICULUM SKILL
     ══════════════════════════════════════════════════════════════════════════ -->

    <record id="view_curriculum_skill_list" model="ir.ui.view">
        <field name="name">curriculum.skill.list</field>
        <field name="model">curriculum.skill</field>
        <field name="arch" type="xml">
            <list string="Skills" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="unique_skill_code" string="Code"/>
                <field name="name" string="Skill Description"/>
                <field name="topic_id"/>
                <field name="subject_id"/>
                <field name="grade_id"/>
                <field name="board_id"/>
                <field name="country_id"/>
                <field name="difficulty_level"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_curriculum_skill_form" model="ir.ui.view">
        <field name="name">curriculum.skill.form</field>
        <field name="model">curriculum.skill</field>
        <field name="arch" type="xml">
            <form string="Skill">
                <sheet>
                    <div class="oe_title">
                        <label for="unique_skill_code" string="Skill Code"/>
                        <h1>
                            <field name="unique_skill_code" readonly="1" placeholder="Auto-generated on save"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="topic_id"/>
                            <field name="subject_id" readonly="1"/>
                            <field name="grade_id" readonly="1"/>
                            <field name="board_id" readonly="1"/>
                            <field name="country_id" readonly="1"/>
                        </group>
                        <group string="Skill Details">
                            <field name="difficulty_level"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Skill Description">
                        <field name="name" nolabel="1" placeholder="Describe the micro learning outcome..."/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Additional context, examples, or references..."/>
                    </group>
                    <div class="oe_chatter" invisible="not id">
                        <button name="regenerate_skill_code" type="object"
                                string="↻ Regenerate Skill Code"
                                class="btn btn-sm btn-warning"
                                confirm="This will regenerate the skill code. Only use this if the code is incorrect. Continue?"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_curriculum_skill_search" model="ir.ui.view">
        <field name="name">curriculum.skill.search</field>
        <field name="model">curriculum.skill</field>
        <field name="arch" type="xml">
            <search string="Search Skills">
                <field name="name"/>
                <field name="unique_skill_code" string="Skill Code"/>
                <field name="topic_id"/>
                <field name="subject_id"/>
                <field name="grade_id"/>
                <field name="board_id"/>
                <field name="country_id"/>
                <field name="difficulty_level"/>
                <filter name="foundation" string="Foundation" domain="[('difficulty_level','=','foundation')]"/>
                <filter name="core" string="Core" domain="[('difficulty_level','=','core')]"/>
                <filter name="extended" string="Extended" domain="[('difficulty_level','=','extended')]"/>
                <filter name="advanced" string="Advanced" domain="[('difficulty_level','=','advanced')]"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group name="group_by">
                    <filter name="group_subject" string="Subject" context="{'group_by': 'subject_id'}"/>
                    <filter name="group_grade" string="Grade" context="{'group_by': 'grade_id'}"/>
                    <filter name="group_topic" string="Topic" context="{'group_by': 'topic_id'}"/>
                    <filter name="group_board" string="Exam Board" context="{'group_by': 'board_id'}"/>
                    <filter name="group_country" string="Country" context="{'group_by': 'country_id'}"/>
                    <filter name="group_difficulty" string="Difficulty" context="{'group_by': 'difficulty_level'}"/>
                </group>
            </search>
        </field>
    </record>


<!-- ══════════════════════════════════════════════════════════════════════════
     MENUS
     ══════════════════════════════════════════════════════════════════════════ -->

    <!-- App Root Menu -->
    <menuitem id="menu_curriculum_root"
              name="Curriculum"
              sequence="50"
              web_icon="shiningace_curriculum,static/description/icon.png"/>

    <!-- Curriculum Explorer -->
    <menuitem id="menu_curriculum_explorer"
              name="Curriculum Explorer"
              parent="menu_curriculum_root"
              sequence="10"
              action="action_curriculum_topic"/>

    <!-- Skills -->
    <menuitem id="menu_curriculum_skills"
              name="Skills"
              parent="menu_curriculum_root"
              sequence="20"
              action="action_curriculum_skill"/>

    <!-- Subjects -->
    <menuitem id="menu_curriculum_subjects"
              name="Subjects"
              parent="menu_curriculum_root"
              sequence="30"
              action="action_curriculum_subject"/>

    <!-- Configuration submenu -->
    <menuitem id="menu_curriculum_config"
              name="Configuration"
              parent="menu_curriculum_root"
              sequence="90"/>

    <menuitem id="menu_curriculum_countries"
              name="Countries"
              parent="menu_curriculum_config"
              sequence="10"
              action="action_learning_country"/>

    <menuitem id="menu_curriculum_boards"
              name="Exam Boards"
              parent="menu_curriculum_config"
              sequence="20"
              action="action_exam_board"/>

    <menuitem id="menu_curriculum_grade_groups"
              name="Grade Groups"
              parent="menu_curriculum_config"
              sequence="30"
              action="action_grade_group"/>

    <menuitem id="menu_curriculum_grade_levels"
              name="Grade Levels"
              parent="menu_curriculum_config"
              sequence="40"
              action="action_grade_level"/>

</odoo>
