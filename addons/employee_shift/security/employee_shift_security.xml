<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_employee_shift" model="ir.module.category">
    <field name="name">Employee Shift</field>
    <field name="sequence">30</field>
  </record>

  <record id="res_groups_privilege_employee_shift" model="res.groups.privilege">
    <field name="name">Employee Shift</field>
    <field name="category_id" ref="module_category_employee_shift"/>
  </record>

  <record id="group_employee_shift_manager" model="res.groups">
    <field name="name">Shift Manager</field>
    <field name="privilege_id" ref="res_groups_privilege_employee_shift"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
</odoo>
