<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_curriculum_tag_list" model="ir.ui.view">
        <field name="name">education.curriculum.tag.list</field>
        <field name="model">education.curriculum.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_education_curriculum_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">education.curriculum.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
