<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_academic_level_list" model="ir.ui.view">
        <field name="name">education.academic.level.list</field>
        <field name="model">education.academic.level</field>
        <field name="arch" type="xml">
            <list default_order="education_system_id, sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="level_type"/>
                <field name="parent_id"/>
                <field name="education_system_id"/>
            </list>
        </field>
    </record>

    <record id="view_education_academic_level_form" model="ir.ui.view">
        <field name="name">education.academic.level.form</field>
        <field name="model">education.academic.level</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Year 7, Grade 5, Key Stage 3"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="level_type"/>
                            <field name="education_system_id"/>
                        </group>
                        <group>
                            <field name="parent_id" domain="[('education_system_id', '=', education_system_id)]"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Child Levels">
                            <field name="child_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="level_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_education_academic_level_search" model="ir.ui.view">
        <field name="name">education.academic.level.search</field>
        <field name="model">education.academic.level</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="education_system_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_system" string="Education System" context="{'group_by': 'education_system_id'}"/>
                    <filter name="group_by_parent" string="Parent Level" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_academic_level" model="ir.actions.act_window">
        <field name="name">Academic Levels</field>
        <field name="res_model">education.academic.level</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
