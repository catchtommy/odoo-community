<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_education_system_list" model="ir.ui.view">
        <field name="name">education.education.system.list</field>
        <field name="model">education.education.system</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="board_count"/>
                <field name="academic_level_count"/>
            </list>
        </field>
    </record>

    <record id="view_education_education_system_form" model="ir.ui.view">
        <field name="name">education.education.system.form</field>
        <field name="model">education.education.system</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_exam_boards" type="object" class="oe_stat_button" icon="fa-institution">
                            <field name="board_count" widget="statinfo" string="Boards"/>
                        </button>
                        <button name="action_view_academic_levels" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="academic_level_count" widget="statinfo" string="Levels"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. UK National Curriculum"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_education_education_system_search" model="ir.ui.view">
        <field name="name">education.education.system.search</field>
        <field name="model">education.education.system</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_country" string="Country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_education_system" model="ir.actions.act_window">
        <field name="name">Education Systems</field>
        <field name="res_model">education.education.system</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
