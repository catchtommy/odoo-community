<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_refresh_discount_state" model="ir.cron">
        <field name="name">Tuition Subscription: Refresh discount status</field>
        <field name="model_id" ref="model_tuition_discount"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_state()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Midnight Europe/London, stored as UTC (Odoo cron times are always UTC). -->
        <field name="nextcall" eval="(datetime.now().replace(hour=23, minute=0, second=0, microsecond=0) + timedelta(days=1))"/>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_refresh_plan_line_state" model="ir.cron">
        <field name="name">Tuition Subscription: Refresh plan line status</field>
        <field name="model_id" ref="model_tuition_plan_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_state()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Midnight Europe/London, stored as UTC (Odoo cron times are always UTC). -->
        <field name="nextcall" eval="(datetime.now().replace(hour=23, minute=0, second=0, microsecond=0) + timedelta(days=1))"/>
        <field name="active">True</field>
    </record>
</odoo>
