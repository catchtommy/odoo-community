<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="tuition_management.M2MCheckboxDropdownField">
        <Dropdown disabled="props.readonly" menuClass="'o_tm_m2m_dropdown_menu p-1'">
            <button type="button" class="btn btn-light border d-flex align-items-center justify-content-between w-100 text-start o_tm_m2m_dropdown_toggle">
                <span class="text-truncate"><t t-esc="toggleLabel"/></span>
                <i class="fa fa-caret-down ms-2"/>
            </button>
            <t t-set-slot="content">
                <!-- Real checkboxes (not menu items), so ticking keeps the menu open
                     and the selection is obvious. -->
                <t t-foreach="items" t-as="item" t-key="item[0]">
                    <div class="px-2 py-1 o_tm_m2m_dropdown_option">
                        <CheckBox value="isSelected(item)" onChange="() => this.onToggle(item)">
                            <t t-esc="item[1]"/>
                        </CheckBox>
                    </div>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
