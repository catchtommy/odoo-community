<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="tuition_management.M2MCheckboxDropdownField">
        <Dropdown disabled="props.readonly">
            <button type="button" class="btn btn-light border d-flex align-items-center justify-content-between w-100 text-start o_tm_m2m_dropdown_toggle">
                <span class="text-truncate"><t t-esc="toggleLabel"/></span>
                <i class="fa fa-caret-down ms-2"/>
            </button>
            <t t-set-slot="content">
                <t t-foreach="items" t-as="item" t-key="item[0]">
                    <CheckboxItem checked="isSelected(item)"
                                  closingMode="'none'"
                                  onSelected="() => this.onToggle(item)">
                        <t t-esc="item[1]"/>
                    </CheckboxItem>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
