<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Tuition Management Permissions — Privilege + 21 Groups
         ============================================================ -->
    <record model="res.groups.privilege" id="privilege_tuition_management">
        <field name="name">Tuition Management</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <!-- — Tutor Management — -->
    <record id="group_tuition_tutor_pricing_view" model="res.groups">
        <field name="name">Tuition / View Tutor Pricing</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_tutor_pricing_edit" model="res.groups">
        <field name="name">Tuition / Edit Tutor Pricing</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_tutor_edit" model="res.groups">
        <field name="name">Tuition / Edit Tutor Info</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_tutor_delete" model="res.groups">
        <field name="name">Tuition / Delete Tutors</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_tutor_rates_edit" model="res.groups">
        <field name="name">Tuition / Edit Tutor Rates</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_parent_delete" model="res.groups">
        <field name="name">Tuition / Delete Parents</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_student_delete" model="res.groups">
        <field name="name">Tuition / Delete Students</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>

    <!-- — Finance — -->
    <record id="group_tuition_parent_invoice_view" model="res.groups">
        <field name="name">Tuition / View Parent Invoices</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_parent_invoice_generate" model="res.groups">
        <field name="name">Tuition / Generate Parent Invoices</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_payroll_view" model="res.groups">
        <field name="name">Tuition / View Tutor Payroll</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_payroll_generate" model="res.groups">
        <field name="name">Tuition / Generate Tutor Payroll</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>

    <!-- — Subscriptions — -->
    <record id="group_tuition_subscription_access" model="res.groups">
        <field name="name">Tuition / Access Subscriptions</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_subscription_plan" model="res.groups">
        <field name="name">Tuition / Subscription Add Plan</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_subscription_adjustment" model="res.groups">
        <field name="name">Tuition / Subscription Add Adjustment</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_subscription_discount" model="res.groups">
        <field name="name">Tuition / Subscription Add Discount</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_subscription_plan_delete" model="res.groups">
        <field name="name">Tuition / Delete Plan History Lines</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_subscription_approve" model="res.groups">
        <field name="name">Tuition / Approve Subscription Changes</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>

    <!-- — Content Management — -->
    <record id="group_tuition_subject_edit" model="res.groups">
        <field name="name">Tuition / Edit Subjects</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_subject_category_edit" model="res.groups">
        <field name="name">Tuition / Edit Subject Categories</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_grades_edit" model="res.groups">
        <field name="name">Tuition / Edit Grades</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>

    <!-- — Actions — -->
    <record id="group_tuition_enquiry_delete" model="res.groups">
        <field name="name">Tuition / Delete Enquiries</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_course_delete" model="res.groups">
        <field name="name">Tuition / Delete Courses</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_course_cancel" model="res.groups">
        <field name="name">Tuition / Cancel Courses</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>

    <!-- — System — -->
    <record id="group_tuition_settings_access" model="res.groups">
        <field name="name">Tuition / Access Settings</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>
    <record id="group_tuition_reports_access" model="res.groups">
        <field name="name">Tuition / Access Reports</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
    </record>

    <!-- ============================================================
         Tuition Admin — implies ALL 21 permission groups above
         ============================================================ -->
    <record id="group_tuition_admin" model="res.groups">
        <field name="name">Tuition / Administrator</field>
        <field name="privilege_id" ref="privilege_tuition_management"/>
        <field name="implied_ids" eval="[
            (4, ref('group_tuition_tutor_pricing_view')),
            (4, ref('group_tuition_tutor_pricing_edit')),
            (4, ref('group_tuition_tutor_edit')),
            (4, ref('group_tuition_tutor_delete')),
            (4, ref('group_tuition_tutor_rates_edit')),
            (4, ref('group_tuition_parent_delete')),
            (4, ref('group_tuition_student_delete')),
            (4, ref('group_tuition_parent_invoice_view')),
            (4, ref('group_tuition_parent_invoice_generate')),
            (4, ref('group_tuition_payroll_view')),
            (4, ref('group_tuition_payroll_generate')),
            (4, ref('group_tuition_subscription_access')),
            (4, ref('group_tuition_subscription_plan')),
            (4, ref('group_tuition_subscription_adjustment')),
            (4, ref('group_tuition_subscription_discount')),
            (4, ref('group_tuition_subscription_plan_delete')),
            (4, ref('group_tuition_subscription_approve')),
            (4, ref('group_tuition_subject_edit')),
            (4, ref('group_tuition_subject_category_edit')),
            (4, ref('group_tuition_grades_edit')),
            (4, ref('group_tuition_enquiry_delete')),
            (4, ref('group_tuition_course_delete')),
            (4, ref('group_tuition_course_cancel')),
            (4, ref('group_tuition_settings_access')),
            (4, ref('group_tuition_reports_access')),
        ]"/>
    </record>
</odoo>
