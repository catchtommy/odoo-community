<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_virtual_classroom">
        <field name="name">Virtual Classroom</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_virtual_classroom_manager" model="res.groups">
        <field name="name">Virtual Classroom Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_virtual_classroom"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_virtual_classroom_meeting_internal" model="ir.rule">
        <field name="name">Virtual classroom meetings: internal users only</field>
        <field name="model_id" ref="model_virtual_classroom_meeting"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
