<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tuition_enquiry_report_wizard_form" model="ir.ui.view">
        <field name="name">tuition.enquiry.report.wizard.form</field>
        <field name="model">tuition.enquiry.report.wizard</field>
        <field name="arch" type="xml">
            <form js_class="tm_report_form" string="Enquiry Report" create="false" delete="false" duplicate="false">
                <sheet>
                    <div class="tm-rf-filters-card">
                        <group>
                            <group>
                                <field name="from_date"/>
                                <field name="to_date"/>
                                <field name="report_tz" required="1"/>
                            </group>
                            <group>
                                <field name="group_by"/>
                            </group>
                        </group>
                        <div class="tm-rf-btn-row">
                            <button name="action_refresh" type="object" string="Apply" class="btn-primary tm-rf-btn-apply" icon="fa-filter"/>
                            <button name="action_export_excel" type="object" string="Export to Excel" class="btn-secondary tm-rf-btn" icon="fa-file-excel-o"/>
                        </div>
                    </div>
                    <div class="tm-rf-table-card">
                        <field name="line_ids" nolabel="1">
                            <list string="Enquiry Report" create="false" edit="false" delete="false" no_open="1">
                                <field name="period_label" string="Date Range"/>
                                <field name="report_date" column_invisible="1"/>
                                <field name="tz_abbr" string="TZ"/>
                                <field name="total_enquiries" string="Total Created" sum="Total Created"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_total'}"/>
                                <field name="new_enquiries" string="New" sum="Total New"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_new'}"/>
                                <field name="demo_scheduled" string="Demo Scheduled" sum="Total Demo Scheduled"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_demo_scheduled'}"/>
                                <field name="demo_completed" string="Demo Completed" sum="Total Demo Completed"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_demo_completed'}"/>
                                <field name="converted" string="Converted" sum="Total Converted"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_converted'}"/>
                                <field name="lost" string="Lost" sum="Total Lost"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_lost'}"/>
                                <field name="pending" string="Pending" sum="Total Pending"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_pending'}"/>
                            </list>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Drill-down enquiry list: creation time is shown in the report's
         timezone (passed as context['tz']) with its short code. -->
    <record id="view_report_enquiry_drilldown_list" model="ir.ui.view">
        <field name="name">enquiry.report.drilldown.list</field>
        <field name="model">enquiry</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Enquiries" create="false" edit="false" delete="false">
                <field name="create_local_display" string="Created On"/>
                <field name="enquiry_name"/>
                <field name="name" string="Parent Name"/>
                <field name="student_name"/>
                <field name="subject_id"/>
                <field name="grade_id"/>
                <field name="enquiry_source" optional="show"/>
                <field name="assigned_user_id" optional="show"/>
                <field name="stage_id"/>
                <field name="create_date" column_invisible="1"/>
            </list>
        </field>
    </record>
</odoo>
