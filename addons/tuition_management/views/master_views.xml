<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subject Category Views -->
    <record id="view_subject_category_list" model="ir.ui.view">
        <field name="name">subject.category.list</field>
        <field name="model">subject.category</field>
        <field name="arch" type="xml">
            <list js_class="subject_category_list" decoration-muted="not active"><field name="name"/><field name="subject_ids" widget="many2many_tags"/><field name="active" widget="boolean_toggle"/></list>
        </field>
    </record>
    <record id="view_subject_category_form" model="ir.ui.view">
        <field name="name">subject.category.form</field>
        <field name="model">subject.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <notebook>
                        <page string="Grades" name="grades">
                            <field name="grade_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Grade"/>
                                    <field name="category_ids" widget="many2many_tags" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subjects" name="subjects">
                            <field name="subject_ids">
                                <list editable="bottom" decoration-muted="not active">
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Subject Master Views -->
    <record id="view_subject_master_list" model="ir.ui.view">
        <field name="name">subject.master.list</field>
        <field name="model">subject.master</field>
        <field name="arch" type="xml">
            <list js_class="subject_master_list" string="Subjects" decoration-muted="not active"><field name="name"/><field name="category_id"/><field name="description"/><field name="active" widget="boolean_toggle"/></list>
        </field>
    </record>
    <record id="view_subject_master_form" model="ir.ui.view">
        <field name="name">subject.master.form</field>
        <field name="model">subject.master</field>
        <field name="arch" type="xml">
            <form><sheet><widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="active"/><group><field name="name"/><field name="category_id" domain="[('active', '=', True)]" options="{'no_create': True}"/><field name="description"/><field name="active" widget="boolean_toggle"/></group></sheet></form>
        </field>
    </record>

    <record id="view_subject_category_search" model="ir.ui.view">
        <field name="name">subject.category.search</field>
        <field name="model">subject.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="view_subject_master_search" model="ir.ui.view">
        <field name="name">subject.master.search</field>
        <field name="model">subject.master</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Grade Master Views -->
    <record id="view_grade_master_list" model="ir.ui.view">
        <field name="name">grade.master.list</field>
        <field name="model">grade.master</field>
        <field name="arch" type="xml">
            <list js_class="grade_master_list"><field name="name"/><field name="category_ids" widget="many2many_tags"/><field name="sequence"/></list>
        </field>
    </record>
    <record id="view_grade_master_form" model="ir.ui.view">
        <field name="name">grade.master.form</field>
        <field name="model">grade.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="category_ids" widget="many2many_tags" domain="[('active', '=', True)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Time Slot Views -->
    <record id="view_tuition_time_slot_tree" model="ir.ui.view">
        <field name="name">tuition.time.slot.tree</field>
        <field name="model">tuition.time.slot</field>
        <field name="arch" type="xml">
            <list><field name="hour"/><field name="minute"/><field name="name"/></list>
        </field>
    </record>
    <record id="view_tuition_time_slot_form" model="ir.ui.view">
        <field name="name">tuition.time.slot.form</field>
        <field name="model">tuition.time.slot</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="hour"/><field name="minute"/><field name="name" readonly="1"/></group></sheet></form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_subject_categories" model="ir.actions.act_window">
        <field name="name">Subject Categories</field>
        <field name="res_model">subject.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="action_subject_masters" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">subject.master</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="action_grade_masters" model="ir.actions.act_window">
        <field name="name">Grades</field>
        <field name="res_model">grade.master</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_tuition_time_slots" model="ir.actions.act_window">
        <field name="name">Time Slots</field>
        <field name="res_model">tuition.time.slot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
