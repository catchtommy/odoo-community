<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subject Category Views -->
    <record id="view_subject_category_list" model="ir.ui.view">
        <field name="name">subject.category.list</field>
        <field name="model">subject.category</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="description"/></list>
        </field>
    </record>
    <record id="view_subject_category_form" model="ir.ui.view">
        <field name="name">subject.category.form</field>
        <field name="model">subject.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Grades" name="grades">
                            <field name="grade_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Grade"/>
                                    <field name="category_ids" widget="many2many_tags" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Subject Master Views -->
    <record id="view_subject_master_list" model="ir.ui.view">
        <field name="name">subject.master.list</field>
        <field name="model">subject.master</field>
        <field name="arch" type="xml">
            <list string="Subjects"><field name="category_id"/><field name="name"/><field name="description"/></list>
        </field>
    </record>
    <record id="view_subject_master_form" model="ir.ui.view">
        <field name="name">subject.master.form</field>
        <field name="model">subject.master</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="name"/><field name="category_id"/><field name="description"/></group></sheet></form>
        </field>
    </record>

    <!-- Grade Master Views -->
    <record id="view_grade_master_list" model="ir.ui.view">
        <field name="name">grade.master.list</field>
        <field name="model">grade.master</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="category_ids" widget="many2many_tags"/><field name="sequence"/></list>
        </field>
    </record>
    <record id="view_grade_master_form" model="ir.ui.view">
        <field name="name">grade.master.form</field>
        <field name="model">grade.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="category_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Time Slot Views -->
    <record id="view_tuition_time_slot_tree" model="ir.ui.view">
        <field name="name">tuition.time.slot.tree</field>
        <field name="model">tuition.time.slot</field>
        <field name="arch" type="xml">
            <list><field name="hour"/><field name="minute"/><field name="name"/></list>
        </field>
    </record>
    <record id="view_tuition_time_slot_form" model="ir.ui.view">
        <field name="name">tuition.time.slot.form</field>
        <field name="model">tuition.time.slot</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="hour"/><field name="minute"/><field name="name" readonly="1"/></group></sheet></form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_subject_categories" model="ir.actions.act_window">
        <field name="name">Subject Categories</field>
        <field name="res_model">subject.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_subject_masters" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">subject.master</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_grade_masters" model="ir.actions.act_window">
        <field name="name">Grades</field>
        <field name="res_model">grade.master</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_tuition_time_slots" model="ir.actions.act_window">
        <field name="name">Time Slots</field>
        <field name="res_model">tuition.time.slot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
