<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tuition_login_as_log_list" model="ir.ui.view">
        <field name="name">tuition.login.as.log.list</field>
        <field name="model">tuition.login.as.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date" string="When"/>
                <field name="admin_user_id" string="Admin"/>
                <field name="role" widget="badge"/>
                <field name="profile_name" string="Profile"/>
                <field name="target_user_id" string="Logged In As"/>
            </list>
        </field>
    </record>

    <record id="view_tuition_login_as_log_form" model="ir.ui.view">
        <field name="name">tuition.login.as.log.form</field>
        <field name="model">tuition.login.as.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="create_date" string="When"/>
                        <field name="admin_user_id"/>
                        <field name="target_user_id" string="Logged In As"/>
                        <field name="role"/>
                        <field name="profile_name"/>
                    </group>
                    <button name="action_open_profile" type="object" string="Open Profile" class="btn-secondary"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tuition_login_as_log" model="ir.actions.act_window">
        <field name="name">Login As — Audit Log</field>
        <field name="res_model">tuition.login.as.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No admin has used "Login as" yet.
            </p>
            <p>
                Every time an admin uses the "Login as Student/Tutor/Parent" button
                to view the portal as that user for debugging, it's recorded here.
            </p>
        </field>
    </record>

</odoo>
