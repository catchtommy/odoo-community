<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ═══════════════════════════════════════════════ -->
<!-- PARENT DASHBOARD                                -->
<!-- ═══════════════════════════════════════════════ -->
<template id="portal_parent_dashboard">
    <t t-call="tuition_management.portal_sidebar_layout">
        <t t-set="page_title">Dashboard</t>
        <t t-set="page_name">dashboard</t>

        <p class="tm-page-subtitle">Welcome back, <strong><t t-esc="user.name"/></strong></p>

        <div class="tm-stat-grid">
            <a href="/my/parent/children" class="tm-stat-card">
                <div class="tm-stat-card-top">
                    <div>
                        <div class="tm-stat-value"><t t-esc="child_count or 0"/></div>
                        <div class="tm-stat-label">Children</div>
                    </div>
                    <div class="tm-stat-icon purple"><i class="fa fa-child"/></div>
                </div>
                <div class="tm-stat-action">View Children →</div>
            </a>
            <a href="/my/tuition/invoices" class="tm-stat-card">
                <div class="tm-stat-card-top">
                    <div>
                        <div class="tm-stat-value"><t t-esc="unpaid_invoices or 0"/></div>
                        <div class="tm-stat-label">Unpaid Invoices</div>
                        <t t-if="amount_due">
                            <div class="tm-stat-sub">£<t t-esc="'%.2f' % amount_due"/> Due</div>
                        </t>
                    </div>
                    <div class="tm-stat-icon red"><i class="fa fa-file-text-o"/></div>
                </div>
                <div class="tm-stat-action">View Invoices →</div>
            </a>
            <div class="tm-stat-card">
                <div class="tm-stat-card-top">
                    <div>
                        <div class="tm-stat-value"><t t-esc="total_enrollments or 0"/></div>
                        <div class="tm-stat-label">Active Enrollments</div>
                    </div>
                    <div class="tm-stat-icon green"><i class="fa fa-book"/></div>
                </div>
            </div>
        </div>

        <t t-if="child_data">
            <t t-foreach="child_data" t-as="cd">
                <div class="tm-card">
                    <div class="tm-card-header">
                        <div class="tm-card-title">
                            <i class="fa fa-user-circle"/>
                            <t t-esc="cd['student'].name"/>
                            <t t-if="cd['student'].grade_id">
                                <span class="tm-badge tm-badge-purple" style="font-size:11px;margin-left:8px;">
                                    <t t-esc="cd['student'].grade_id.name"/>
                                </span>
                            </t>
                        </div>
                        <a t-attf-href="/my/parent/children/#{cd['student'].id}" class="tm-card-action">View Profile</a>
                    </div>
                    <t t-if="cd['enrollments']">
                        <table class="tm-table">
                            <thead><tr><th>Course</th><th>Subject</th><th>Tutor</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                                <t t-foreach="cd['enrollments']" t-as="enr">
                                    <tr>
                                        <td class="fw-bold"><t t-esc="enr.course_id.name"/></td>
                                        <td><t t-esc="enr.course_id.subject_id.name or '—'"/></td>
                                        <td><t t-esc="enr.course_id.tutor_id.name or '—'"/></td>
                                        <td><span class="tm-badge tm-badge-green">Active</span></td>
                                        <td><a t-attf-href="/my/courses/#{enr.id}" class="tm-btn tm-btn-outline tm-btn-sm">View</a></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else=""><div class="tm-empty"><i class="fa fa-book"/><p>Not enrolled in any courses.</p></div></t>
                </div>
            </t>
        </t>
    </t>
</template>

<!-- ═══════════════════════════════════════════════ -->
<!-- PARENT: CHILD DETAIL                            -->
<!-- ═══════════════════════════════════════════════ -->
<template id="portal_parent_child_detail">
    <t t-call="tuition_management.portal_sidebar_layout">
        <t t-set="page_name">parent_children</t>

        <div style="margin-bottom:16px;">
            <a href="/my/parent/children" class="tm-btn tm-btn-outline tm-btn-sm"><i class="fa fa-arrow-left"/> Back to Children</a>
        </div>

        <div class="tm-card" style="margin-bottom:20px;">
            <div class="tm-card-body">
                <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
                    <div style="width:56px;height:56px;border-radius:50%;background:var(--tm-primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;flex-shrink:0;">
                        <t t-esc="(child.name or 'S')[:1].upper()"/>
                    </div>
                    <div style="flex:1;">
                        <h2 style="font-size:18px;font-weight:700;margin:0 0 4px;"><t t-esc="child.name"/></h2>
                        <div style="font-size:13px;color:var(--tm-text-light);display:flex;gap:16px;flex-wrap:wrap;">
                            <t t-if="child.grade_id"><span><i class="fa fa-graduation-cap"/> <t t-esc="child.grade_id.name"/></span></t>
                            <t t-if="child.email"><span><i class="fa fa-envelope"/> <t t-esc="child.email"/></span></t>
                            <t t-if="child.phone"><span><i class="fa fa-phone"/> <t t-esc="child.phone"/></span></t>
                            <span><i class="fa fa-calendar-check-o"/> Attendance: <strong><t t-esc="attendance_rate"/></strong></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tm-card" style="margin-bottom:20px;">
            <div class="tm-card-header"><div class="tm-card-title"><i class="fa fa-book"/> Active Courses</div></div>
            <t t-if="enrollments">
                <table class="tm-table">
                    <thead><tr><th>Course</th><th>Subject</th><th>Tutor</th><th></th></tr></thead>
                    <tbody>
                        <t t-foreach="enrollments" t-as="enr">
                            <tr>
                                <td class="fw-bold"><t t-esc="enr.course_id.name"/></td>
                                <td><t t-esc="enr.course_id.subject_id.name or '—'"/></td>
                                <td><t t-esc="enr.course_id.tutor_id.name or '—'"/></td>
                                <td><a t-attf-href="/my/courses/#{enr.id}" class="tm-btn tm-btn-outline tm-btn-sm">View</a></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <t t-else=""><div class="tm-empty"><i class="fa fa-book"/><p>No active courses.</p></div></t>
        </div>

        <div class="tm-card" style="margin-bottom:20px;">
            <div class="tm-card-header"><div class="tm-card-title"><i class="fa fa-line-chart"/> Progress Reports</div></div>
            <t t-if="progress_reports">
                <table class="tm-table">
                    <thead><tr><th>Date</th><th>Course</th><th>Title</th><th>Rating</th><th>Score</th><th></th></tr></thead>
                    <tbody>
                        <t t-foreach="progress_reports" t-as="rpt">
                            <tr>
                                <td style="white-space:nowrap;"><t t-esc="rpt.report_date"/></td>
                                <td><t t-esc="rpt.course_id.name"/></td>
                                <td><t t-esc="rpt.name"/></td>
                                <td>
                                    <t t-if="rpt.overall_rating">
                                        <span t-attf-class="tm-badge #{rpt.overall_rating == 'excellent' and 'tm-badge-green' or rpt.overall_rating == 'good' and 'tm-badge-blue' or rpt.overall_rating == 'satisfactory' and 'tm-badge-orange' or 'tm-badge-red'}">
                                            <t t-esc="rpt.overall_rating.replace('_',' ').capitalize()"/>
                                        </span>
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                                <td><t t-esc="rpt.score and ('%.0f / %.0f' % (rpt.score, rpt.max_score)) or '—'"/></td>
                                <td><a t-attf-href="/my/progress-report/#{rpt.id}" class="tm-btn tm-btn-outline tm-btn-sm"><i class="fa fa-eye"/> View</a></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <t t-else=""><div class="tm-empty"><i class="fa fa-line-chart"/><p>No progress reports yet.</p></div></t>
        </div>

        <div class="tm-card">
            <div class="tm-card-header"><div class="tm-card-title"><i class="fa fa-calendar-check-o"/> Recent Attendance</div></div>
            <t t-if="attendance_records">
                <table class="tm-table">
                    <thead><tr><th>Date</th><th>Course</th><th>Status</th></tr></thead>
                    <tbody>
                        <t t-foreach="attendance_records" t-as="att">
                            <tr>
                                <td><t t-esc="att.class_schedule_occurrence_id.start_datetime and att.class_schedule_occurrence_id.start_datetime.strftime('%d %b %Y') or '—'"/></td>
                                <td><t t-esc="att.class_schedule_occurrence_id.course_id.name or '—'"/></td>
                                <td><span t-attf-class="tm-badge #{att.status == 'present' and 'tm-badge-green' or att.status == 'absent' and 'tm-badge-red' or 'tm-badge-orange'}"><t t-esc="att.status.capitalize()"/></span></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <t t-else=""><div class="tm-empty"><i class="fa fa-calendar"/><p>No attendance records.</p></div></t>
        </div>
    </t>
</template>

<!-- ═══════════════════════════════════════════════ -->
<!-- PARENT: SCHEDULE                                -->
<!-- ═══════════════════════════════════════════════ -->
<template id="portal_parent_schedule">
    <t t-call="tuition_management.portal_sidebar_layout">
        <t t-set="page_name">parent_schedule</t>

        <h5 style="margin:0 0 16px;font-weight:700;"><i class="fa fa-calendar"/> Schedules</h5>

        <div class="tm-card">
            <div class="tm-card-header">
                <div class="tm-card-title"><i class="fa fa-list"/> Sessions</div>
            </div>
            <div style="padding:10px 16px;border-bottom:1px solid var(--tm-border);display:flex;justify-content:space-between;align-items:center;">
                <a t-attf-href="/my/parent/schedule?week_offset=#{(week_offset or 0) - 1}" class="tm-btn tm-btn-outline tm-btn-sm"><i class="fa fa-chevron-left"/> Prev</a>
                <span style="font-size:12px;font-weight:600;color:var(--tm-text);"><t t-esc="week_label or 'This Week'"/></span>
                <a t-attf-href="/my/parent/schedule?week_offset=#{(week_offset or 0) + 1}" class="tm-btn tm-btn-outline tm-btn-sm">Next <i class="fa fa-chevron-right"/></a>
            </div>
            <t t-if="occ_data">
                <table class="tm-table">
                    <thead><tr><th>Date</th><th>Time</th><th>Course</th><th>Tutor</th><th>Status</th><th>Attendance</th></tr></thead>
                    <tbody>
                        <t t-foreach="occ_data" t-as="od">
                            <tr>
                                <td class="fw-bold" style="white-space:nowrap;"><t t-esc="od['date_str']"/></td>
                                <td><t t-esc="od['time_str']"/></td>
                                <td><t t-esc="od['occ'].course_id.name or '—'"/></td>
                                <td><t t-esc="od['occ'].tutor_id.name or '—'"/></td>
                                <td>
                                    <span t-attf-class="tm-badge #{od['occ'].lesson_status == 'completed' and 'tm-badge-green' or od['occ'].lesson_status == 'cancelled' and 'tm-badge-red' or od['occ'].lesson_status == 'no_show' and 'tm-badge-orange' or 'tm-badge-blue'}">
                                        <t t-esc="od['occ'].lesson_status.capitalize()"/>
                                    </span>
                                </td>
                                <td>
                                    <t t-if="od['attendance']">
                                        <t t-foreach="od['attendance']" t-as="att_rec">
                                            <div style="font-size:11px;margin-bottom:2px;">
                                                <strong><t t-esc="att_rec['student_name']"/>:</strong>
                                                <span t-attf-class="tm-badge tm-btn-sm #{att_rec['status'] == 'present' and 'tm-badge-green' or att_rec['status'] == 'absent' and 'tm-badge-red' or att_rec['status'] == 'late' and 'tm-badge-orange' or 'tm-badge-grey'}">
                                                    <t t-esc="att_rec['status'].capitalize()"/>
                                                </span>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else=""><span class="tm-badge tm-badge-grey">—</span></t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <t t-else=""><div class="tm-empty"><i class="fa fa-calendar"/><p>No sessions this week.</p></div></t>
        </div>
    </t>
</template>

<!-- ═══════════════════════════════════════════════ -->
<!-- PARENT: PROGRESS                                -->
<!-- ═══════════════════════════════════════════════ -->
<template id="portal_parent_progress">
    <t t-call="tuition_management.portal_sidebar_layout">
        <t t-set="page_name">parent_progress</t>

        <h5 style="margin:0 0 16px;font-weight:700;"><i class="fa fa-line-chart"/> Progress</h5>

        <t t-if="child_data">
            <t t-foreach="child_data" t-as="cd">
                <div class="tm-card" style="margin-bottom:20px;">
                    <div class="tm-card-header">
                        <div class="tm-card-title">
                            <i class="fa fa-user-circle"/>
                            <t t-esc="cd['student'].name"/>
                            <t t-if="cd['student'].grade_id">
                                <span class="tm-badge tm-badge-purple" style="font-size:11px;margin-left:8px;">
                                    <t t-esc="cd['student'].grade_id.name"/>
                                </span>
                            </t>
                        </div>
                        <span class="tm-badge tm-badge-blue" style="font-size:11px;">
                            Attendance: <t t-esc="cd['attendance_rate']"/>
                        </span>
                    </div>
                    <t t-if="cd['reports']">
                        <table class="tm-table">
                            <thead><tr><th>Date</th><th>Course</th><th>Title</th><th>Rating</th><th>Score</th><th>Comments</th><th></th></tr></thead>
                            <tbody>
                                <t t-foreach="cd['reports']" t-as="rpt">
                                    <tr>
                                        <td style="white-space:nowrap;"><t t-esc="rpt.report_date"/></td>
                                        <td><t t-esc="rpt.course_id.name"/></td>
                                        <td class="fw-bold"><t t-esc="rpt.name"/></td>
                                        <td>
                                            <t t-if="rpt.overall_rating">
                                                <span t-attf-class="tm-badge #{rpt.overall_rating == 'excellent' and 'tm-badge-green' or rpt.overall_rating == 'good' and 'tm-badge-blue' or rpt.overall_rating == 'satisfactory' and 'tm-badge-orange' or 'tm-badge-red'}">
                                                    <t t-esc="rpt.overall_rating.replace('_',' ').capitalize()"/>
                                                </span>
                                            </t>
                                            <t t-else="">—</t>
                                        </td>
                                        <td><t t-esc="rpt.score and ('%.0f / %.0f' % (rpt.score, rpt.max_score)) or '—'"/></td>
                                        <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                            <t t-esc="rpt.comments or rpt.strengths or '—'"/>
                                        </td>
                                        <td><a t-attf-href="/my/progress-report/#{rpt.id}" class="tm-btn tm-btn-outline tm-btn-sm"><i class="fa fa-eye"/> View</a></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else=""><div class="tm-empty"><i class="fa fa-line-chart"/><p>No progress reports yet for <t t-esc="cd['student'].name"/>.</p></div></t>
                </div>
            </t>
        </t>
        <t t-else="">
            <div class="tm-card"><div class="tm-empty"><i class="fa fa-child"/><p>No children found.</p></div></div>
        </t>
    </t>
</template>

<!-- ═══════════════════════════════════════════════ -->
<!-- PARENT: INVOICES                                -->
<!-- ═══════════════════════════════════════════════ -->
<template id="portal_parent_invoices" name="Parent: Invoices">
    <t t-call="tuition_management.portal_sidebar_layout">
        <t t-set="page_name">tuition_invoices</t>
        <t t-set="page_title">Invoices</t>

        <h5 style="margin:0 0 16px;font-weight:700;"><i class="fa fa-file-text-o"/> Invoices</h5>

        <div class="tm-stat-grid" style="margin-bottom:20px;">
            <div class="tm-stat-card">
                <div class="tm-stat-card-top">
                    <div>
                        <div class="tm-stat-value"><t t-esc="len(invoices)"/></div>
                        <div class="tm-stat-label">Total Invoices</div>
                    </div>
                    <div class="tm-stat-icon blue"><i class="fa fa-file-text-o"/></div>
                </div>
            </div>
            <div class="tm-stat-card">
                <div class="tm-stat-card-top">
                    <div>
                        <div class="tm-stat-value" style="color:var(--tm-green);"><t t-esc="len(invoices.filtered(lambda i: i.payment_state == 'paid'))"/></div>
                        <div class="tm-stat-label">Paid</div>
                    </div>
                    <div class="tm-stat-icon green"><i class="fa fa-check-circle"/></div>
                </div>
            </div>
            <div class="tm-stat-card">
                <div class="tm-stat-card-top">
                    <div>
                        <div class="tm-stat-value" style="color:var(--tm-orange);"><t t-esc="len(invoices.filtered(lambda i: i.payment_state != 'paid' and i.state == 'posted'))"/></div>
                        <div class="tm-stat-label">Unpaid</div>
                    </div>
                    <div class="tm-stat-icon orange"><i class="fa fa-clock-o"/></div>
                </div>
            </div>
        </div>

        <t t-if="not invoices">
            <div class="tm-card">
                <div class="tm-empty">
                    <i class="fa fa-file-o"/>
                    <p>No invoices found.</p>
                </div>
            </div>
        </t>
        <t t-if="invoices">
            <div class="tm-card">
                <div class="tm-card-header">
                    <div class="tm-card-title"><i class="fa fa-list"/> All Invoices</div>
                </div>
                <div class="table-responsive">
                    <table class="tm-table">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Date</th>
                                <th>Due Date</th>
                                <th>Student</th>
                                <th style="text-align:right;">Amount</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="invoices" t-as="inv">
                                <tr>
                                    <td class="fw-bold"><t t-esc="inv.name"/></td>
                                    <td style="white-space:nowrap;">
                                        <t t-if="inv.invoice_date" t-esc="inv.invoice_date" t-options='{"widget": "date"}'/>
                                        <t t-else="">—</t>
                                    </td>
                                    <td style="white-space:nowrap;">
                                        <t t-if="inv.invoice_date_due">
                                            <span style="color:var(--tm-orange);font-weight:600;"><t t-esc="inv.invoice_date_due" t-options='{"widget": "date"}'/></span>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td>
                                        <t t-if="inv.tuition_subscription_id and inv.tuition_subscription_id.student_id">
                                            <span class="tm-badge tm-badge-purple" style="font-size:10px;"><t t-esc="inv.tuition_subscription_id.student_id.name"/></span>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td style="text-align:right;font-weight:600;">
                                        <t t-esc="'%.2f' % inv.amount_total"/> <t t-esc="inv.currency_id.symbol"/>
                                    </td>
                                    <td>
                                        <span t-if="inv.payment_state == 'paid'" class="tm-badge tm-badge-green">Paid</span>
                                        <span t-elif="inv.payment_state == 'partial'" class="tm-badge tm-badge-orange">Partial</span>
                                        <span t-elif="inv.state == 'posted'" class="tm-badge tm-badge-red">Unpaid</span>
                                        <span t-elif="inv.state == 'draft'" class="tm-badge tm-badge-grey">Draft</span>
                                        <span t-else="" class="tm-badge tm-badge-grey"><t t-esc="inv.state"/></span>
                                    </td>
                                    <td>
                                        <a t-attf-href="/my/invoices/#{inv.id}" class="tm-btn tm-btn-outline tm-btn-sm">
                                            <i class="fa fa-eye"/> View
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </t>
</template>

<!-- ═══════════════════════════════════════════════ -->
<!-- PARENT: INVOICE DETAIL                          -->
<!-- ═══════════════════════════════════════════════ -->
<template id="portal_parent_invoice_detail" name="Parent: Invoice Detail">
    <t t-call="tuition_management.portal_sidebar_layout">
        <t t-set="page_name">tuition_invoices</t>
        <t t-set="page_title">Invoice</t>

        <div style="margin-bottom:16px;">
            <a href="/my/tuition/invoices" class="tm-btn tm-btn-outline tm-btn-sm"><i class="fa fa-arrow-left"/> Back to Invoices</a>
        </div>

        <div class="tm-card" style="margin-bottom:20px;">
            <div class="tm-card-body">
                <div style="display:flex;align-items:flex-start;gap:16px;flex-wrap:wrap;justify-content:space-between;">
                    <div style="display:flex;align-items:center;gap:16px;">
                        <div style="width:52px;height:52px;border-radius:10px;background:var(--tm-primary-light);color:var(--tm-primary);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;">
                            <i class="fa fa-file-text-o"/>
                        </div>
                        <div>
                            <h2 style="font-size:18px;font-weight:700;margin:0 0 6px;"><t t-esc="invoice.name"/></h2>
                            <div style="font-size:13px;color:var(--tm-text-light);display:flex;gap:16px;flex-wrap:wrap;">
                                <t t-if="invoice.invoice_date">
                                    <span><i class="fa fa-calendar"/> <t t-esc="invoice.invoice_date" t-options='{"widget": "date"}'/></span>
                                </t>
                                <t t-if="invoice.invoice_date_due">
                                    <span><i class="fa fa-clock-o"/> Due: <t t-esc="invoice.invoice_date_due" t-options='{"widget": "date"}'/></span>
                                </t>
                                <t t-if="invoice.tuition_subscription_id and invoice.tuition_subscription_id.student_id">
                                    <span><i class="fa fa-child"/> <t t-esc="invoice.tuition_subscription_id.student_id.name"/></span>
                                </t>
                                <span t-if="invoice.payment_state == 'paid'" class="tm-badge tm-badge-green">Paid</span>
                                <span t-elif="invoice.payment_state == 'partial'" class="tm-badge tm-badge-orange">Partially Paid</span>
                                <span t-elif="invoice.state == 'posted'" class="tm-badge tm-badge-red">Unpaid</span>
                                <span t-elif="invoice.state == 'draft'" class="tm-badge tm-badge-grey">Draft</span>
                                <span t-elif="invoice.state == 'cancel'" class="tm-badge tm-badge-red">Cancelled</span>
                                <span t-else="" class="tm-badge tm-badge-grey"><t t-esc="invoice.state"/></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tm-card" style="margin-bottom:20px;">
            <div class="tm-card-header">
                <div class="tm-card-title"><i class="fa fa-info-circle"/> Invoice Details</div>
            </div>
            <div class="tm-card-body">
                <div class="tm-label">Invoice Number</div>
                <div class="tm-value fw-bold"><t t-esc="invoice.name"/></div>
                <div class="tm-label">Invoice Date</div>
                <div class="tm-value"><t t-if="invoice.invoice_date" t-esc="invoice.invoice_date" t-options='{"widget": "date"}'/><t t-else="">—</t></div>
                <div class="tm-label">Due Date</div>
                <div class="tm-value">
                    <t t-if="invoice.invoice_date_due">
                        <span style="font-weight:600;color:var(--tm-orange);"><t t-esc="invoice.invoice_date_due" t-options='{"widget": "date"}'/></span>
                    </t>
                    <t t-else="">—</t>
                </div>
                <t t-if="invoice.ref">
                    <div class="tm-label">Reference</div>
                    <div class="tm-value"><t t-esc="invoice.ref"/></div>
                </t>
                <t t-if="invoice.invoice_origin">
                    <div class="tm-label">Source</div>
                    <div class="tm-value"><t t-esc="invoice.invoice_origin"/></div>
                </t>
            </div>
        </div>

        <div class="tm-card" style="margin-bottom:20px;">
            <div class="tm-card-header">
                <div class="tm-card-title"><i class="fa fa-user"/> Billing Information</div>
            </div>
            <div class="tm-card-body">
                <div class="tm-label">Billed To</div>
                <div class="tm-value fw-bold"><t t-esc="invoice.partner_id.name"/></div>
                <t t-if="invoice.partner_id.email">
                    <div class="tm-label">Email</div>
                    <div class="tm-value"><t t-esc="invoice.partner_id.email"/></div>
                </t>
                <t t-if="invoice.partner_id.phone">
                    <div class="tm-label">Phone</div>
                    <div class="tm-value"><t t-esc="invoice.partner_id.phone"/></div>
                </t>
                <t t-if="invoice.tuition_subscription_id">
                    <div class="tm-label">Student</div>
                    <div class="tm-value">
                        <span class="tm-badge tm-badge-purple">
                            <t t-esc="invoice.tuition_subscription_id.student_id.name"/>
                        </span>
                    </div>
                    <t t-if="invoice.tuition_subscription_id.current_plan_product">
                        <div class="tm-label">Plan</div>
                        <div class="tm-value"><t t-esc="invoice.tuition_subscription_id.current_plan_product"/></div>
                    </t>
                </t>
            </div>
        </div>

        <div class="tm-card" style="margin-bottom:20px;">
            <div class="tm-card-header">
                <div class="tm-card-title"><i class="fa fa-list"/> Invoice Lines</div>
            </div>
            <table class="tm-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th style="text-align:right;">Qty</th>
                        <th style="text-align:right;">Unit Price</th>
                        <th style="text-align:right;">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="invoice.invoice_line_ids.filtered(lambda l: not l.display_type)" t-as="line">
                        <tr>
                            <td class="fw-bold"><t t-esc="line.name or line.product_id.name or '—'"/></td>
                            <td style="text-align:right;"><t t-esc="'%.2f' % line.quantity"/></td>
                            <td style="text-align:right;"><t t-esc="'%.2f' % line.price_unit"/> <t t-esc="invoice.currency_id.symbol"/></td>
                            <td style="text-align:right;font-weight:600;"><t t-esc="'%.2f' % line.price_subtotal"/> <t t-esc="invoice.currency_id.symbol"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>

        <div class="tm-card" style="margin-bottom:20px;">
            <div class="tm-card-header">
                <div class="tm-card-title"><i class="fa fa-calculator"/> Summary</div>
            </div>
            <div class="tm-card-body">
                <div style="max-width:380px;margin-left:auto;">
                    <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:13px;border-bottom:1px solid var(--tm-border);">
                        <span style="color:var(--tm-text-light);">Untaxed Amount</span>
                        <span><t t-esc="'%.2f' % invoice.amount_untaxed"/> <t t-esc="invoice.currency_id.symbol"/></span>
                    </div>
                    <t t-if="invoice.amount_tax">
                        <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:13px;border-bottom:1px solid var(--tm-border);">
                            <span style="color:var(--tm-text-light);">Tax</span>
                            <span><t t-esc="'%.2f' % invoice.amount_tax"/> <t t-esc="invoice.currency_id.symbol"/></span>
                        </div>
                    </t>
                    <div style="display:flex;justify-content:space-between;padding:12px 0;font-size:16px;font-weight:700;border-bottom:1px solid var(--tm-border);">
                        <span>Total</span>
                        <span><t t-esc="'%.2f' % invoice.amount_total"/> <t t-esc="invoice.currency_id.symbol"/></span>
                    </div>
                    <t t-if="invoice.payment_state == 'paid'">
                        <div style="display:flex;justify-content:space-between;padding:12px 0;font-size:14px;font-weight:600;color:var(--tm-green);">
                            <span><i class="fa fa-check-circle"/> Paid</span>
                            <span><t t-esc="'%.2f' % invoice.amount_total"/> <t t-esc="invoice.currency_id.symbol"/></span>
                        </div>
                    </t>
                    <t t-if="invoice.payment_state != 'paid' and invoice.state == 'posted'">
                        <div style="display:flex;justify-content:space-between;padding:12px 0;font-size:14px;font-weight:600;color:var(--tm-orange);">
                            <span>Amount Due</span>
                            <span><t t-esc="'%.2f' % invoice.amount_residual"/> <t t-esc="invoice.currency_id.symbol"/></span>
                        </div>
                        <div style="padding:12px 0;text-align:right;">
                            <a t-attf-href="/my/invoices/#{invoice.id}" class="tm-btn tm-btn-green" style="padding:10px 28px;">
                                <i class="fa fa-credit-card"/> Pay Now
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </div>

        <t t-if="invoice.narration">
            <div class="tm-card" style="margin-bottom:20px;">
                <div class="tm-card-header">
                    <div class="tm-card-title"><i class="fa fa-sticky-note"/> Notes</div>
                </div>
                <div class="tm-card-body">
                    <div style="font-size:13px;" t-raw="invoice.narration"/>
                </div>
            </div>
        </t>
    </t>
</template>

</odoo>
