<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="portal_tuition_css" name="Tuition Portal CSS">
    <style>
        :root {
            --tm-blue: #4A7CC9;
            --tm-blue-dark: #3A6AB5;
            --tm-indigo: #4A7CC9;
            --tm-indigo-dark: #3A6AB5;
            --tm-teal: #4DB6AC;
            --tm-teal-dark: #3A9E94;
            --tm-green: #66BB6A;
            --tm-green-dark: #4CAF50;
            --tm-orange: #FF8A65;
            --tm-red: #E57373;
            --tm-purple: #9575CD;
            --tm-grey: #78909C;
            --tm-rose: #E07092;
            --tm-rose-dark: #C75B7E;
            --tm-text: #37474F;
            --tm-text-light: #90A4AE;
            --tm-bg: #F5F7FA;
            --tm-border: #E8ECF0;
        }
        .tm-page { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: var(--tm-text); }
        .tm-hero { padding: 24px 28px; border-radius: 14px; margin-bottom: 20px; color: #fff; }
        .tm-hero h2 { font-weight: 700; margin: 0 0 4px; font-size: 20px; }
        .tm-hero p { margin: 0; opacity: 0.7; font-size: 13px; }
        .tm-hero-stat { background: rgba(255,255,255,0.18); border-radius: 10px; padding: 12px 16px; text-align: center; min-width: 90px; backdrop-filter: blur(4px); }
        .tm-hero-stat .num { font-size: 24px; font-weight: 800; line-height: 1; }
        .tm-hero-stat .lbl { font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.8; margin-top: 2px; }
        .tm-card { border: 1px solid var(--tm-border); border-radius: 10px; overflow: hidden; margin-bottom: 16px; background: #fff; border-top: none; }
        .tm-card-header { padding: 12px 18px; font-weight: 600; font-size: 13px; background: #4A7CC9; color: #fff; display: flex; justify-content: space-between; align-items: center; cursor: pointer; border-radius: 10px 10px 0 0; }
        .tm-card-header a, .tm-card-header .tm-card-title { color: #fff !important; text-decoration: none; }
        .tm-card-header .tm-btn { color: #fff; border-color: rgba(255,255,255,0.5); }
        .tm-card-header .tm-btn:hover { background: rgba(255,255,255,0.15); color: #fff; }
        .tm-card-header .tm-btn-blue { background: rgba(255,255,255,0.2); color: #fff; border: 1.5px solid rgba(255,255,255,0.4); }
        .tm-card-header .tm-btn-outline { background: transparent; border-color: rgba(255,255,255,0.5); color: #fff; }
        .tm-card-header i.tm-chevron { transition: transform 0.25s; font-size: 12px; color: rgba(255,255,255,0.8); }
        .tm-card-header.collapsed i.tm-chevron { transform: rotate(-90deg); }
        .tm-card-body { padding: 18px; }
        .tm-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--tm-text-light); font-weight: 700; margin-bottom: 2px; }
        .tm-value { font-size: 13px; color: var(--tm-text); font-weight: 500; margin-bottom: 12px; }
        .tm-badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
        .tm-badge-blue { background: #E8EEF7; color: var(--tm-blue); }
        .tm-badge-green { background: #EDF7ED; color: #4a8a4e; }
        .tm-badge-orange { background: #FFF0E8; color: #c26030; }
        .tm-badge-red { background: #FDEAEA; color: #c05050; }
        .tm-badge-grey { background: #ECEFF1; color: var(--tm-grey); }
        .tm-badge-purple { background: #F0ECF7; color: #7554a8; }
        .tm-badge-teal { background: #E5F5F3; color: #3a8a80; }
        .tm-btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 16px; border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none; border: none; cursor: pointer; transition: all 0.15s; }
        .tm-btn:hover { filter: brightness(0.94); text-decoration: none; }
        .tm-btn-primary { background: #4A7CC9; color: #fff; border: none; }
        .tm-btn-primary:hover { background: #3A6AB5; color: #fff; }
        .tm-btn-blue { background: var(--tm-blue); color: #fff; }
        .tm-btn-blue:hover { color: #fff; }
        .tm-btn-green { background: var(--tm-green-dark); color: #fff; }
        .tm-btn-green:hover { color: #fff; }
        .tm-btn-teal { background: var(--tm-teal); color: #fff; }
        .tm-btn-teal:hover { color: #fff; }
        .tm-btn-outline { background: transparent; border: 1.5px solid var(--tm-border); color: var(--tm-grey); }
        .tm-btn-sm { padding: 5px 12px; font-size: 11px; border-radius: 6px; }
        .tm-table { width: 100%; border-collapse: separate; border-spacing: 0; }
        .tm-table thead th { background: var(--tm-bg); padding: 9px 14px; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--tm-text-light); font-weight: 700; border-bottom: 1px solid var(--tm-border); }
        .tm-table tbody td { padding: 10px 14px; font-size: 13px; border-bottom: 1px solid #f5f5f5; vertical-align: middle; }
        .tm-table tbody tr:hover { background: #fafbfc; }
        .tm-empty { text-align: center; padding: 36px 20px; color: #b0bec5; }
        .tm-empty i { font-size: 40px; margin-bottom: 10px; display: block; opacity: 0.5; }
        .tm-empty p { font-size: 13px; margin: 0; }
        .tm-avatar { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; flex-shrink: 0; }
        .tm-avatar-blue { background: #E8EEF7; color: var(--tm-blue); }
        .tm-avatar-green { background: #EDF7ED; color: #4a8a4e; }
        .tm-avatar-teal { background: #E5F5F3; color: #3a8a80; }
        .tm-avatar-purple { background: #F0ECF7; color: #7554a8; }
        .tm-avatar-rose { background: #FCEDF1; color: var(--tm-rose); }
        .tm-course-card { border: 1px solid var(--tm-border); border-radius: 10px; overflow: hidden; height: 100%; transition: transform 0.15s, box-shadow 0.15s; background: #fff; }
        .tm-course-card:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,0.06); }
        .tm-course-card .card-top { padding: 18px; color: #fff; }
        .tm-course-card .card-top h6 { font-weight: 700; font-size: 14px; margin: 0; }
        .tm-course-card .card-middle { padding: 14px 18px; }
        .tm-course-card .card-bottom { padding: 10px 18px; border-top: 1px solid var(--tm-border); }
        .tm-course-card .meta-row { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--tm-grey); margin-bottom: 6px; }
        .tm-course-card .meta-row i { width: 14px; text-align: center; color: var(--tm-text-light); }
        .tm-pill-tab { display: inline-block; padding: 6px 16px; border-radius: 20px; font-size: 11px; font-weight: 600; text-decoration: none; margin-right: 6px; transition: all 0.15s; }
        .tm-pill-tab.active { background: var(--tm-indigo); color: #fff; }
        .tm-pill-tab:not(.active) { background: #eceff1; color: var(--tm-grey); }
        .tm-pill-tab:hover { text-decoration: none; }
        .tm-progress-item { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f5f5f5; }
        .tm-progress-item:last-child { border-bottom: none; }
        .tm-assignment-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; border-bottom: 1px solid #f5f5f5; transition: background 0.1s; }
        .tm-assignment-row:last-child { border-bottom: none; }
        .tm-assignment-row:hover { background: #fafbfc; }
        .tm-file-link { font-size: 12px; display: flex; align-items: center; gap: 6px; color: var(--tm-blue); text-decoration: none; padding: 3px 0; }
        .tm-file-link:hover { color: var(--tm-blue-dark); }
        .tm-quick-tile { border: 1px solid var(--tm-border); border-radius: 10px; text-align: center; padding: 20px 14px; background: #fff; transition: box-shadow 0.15s; display: block; text-decoration: none; color: inherit; }
        .tm-quick-tile:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.06); text-decoration: none; color: inherit; }
        .tm-quick-tile i { font-size: 24px; margin-bottom: 6px; }
        .tm-quick-tile .tile-label { font-size: 12px; font-weight: 600; color: var(--tm-text); }
        .tm-quick-tile .tile-sub { font-size: 10px; color: var(--tm-text-light); }
        .tm-course-row { display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-bottom: 1px solid #f5f5f5; text-decoration: none; color: inherit; transition: background 0.1s; }
        .tm-course-row:hover { background: var(--tm-bg); text-decoration: none; color: inherit; }
        .tm-course-row:last-child { border-bottom: none; }

        /* ── Form field sizing ── */
        .tm-portal-layout .form-control,
        .tm-portal-layout .form-select {
            font-size: 14px; padding: 9px 12px; border-radius: 8px;
            border: 1px solid var(--tm-border); max-width: 100%;
            box-sizing: border-box; height: auto; line-height: 1.5;
            background: #fff; color: var(--tm-text);
        }
        .tm-portal-layout .form-control:focus,
        .tm-portal-layout .form-select:focus {
            border-color: var(--tm-blue);
            box-shadow: 0 0 0 3px rgba(74,124,201,0.15); outline: none;
        }
        .tm-portal-layout .form-control-sm,
        .tm-portal-layout .form-select-sm { font-size: 13px; padding: 6px 10px; border-radius: 6px; }
        .tm-portal-layout textarea.form-control { resize: vertical; min-height: 80px; }
        .tm-portal-layout .form-label,
        .tm-portal-layout label {
            font-size: 13px; font-weight: 600; color: var(--tm-text);
            margin-bottom: 6px; display: block;
        }
        /* ── Form group helper ── */
        .tm-form-group { margin-bottom: 16px; }
        .tm-form-label { font-size: 13px; font-weight: 600; color: var(--tm-text); margin-bottom: 6px; display: block; }
        .tm-portal-layout .mb-3 { margin-bottom: 14px !important; }
        .tm-portal-layout .input-group .form-control { border-radius: 6px 0 0 6px; }
        .tm-portal-layout .input-group .input-group-text {
            font-size: 11px; padding: 5px 8px; border-radius: 0 6px 6px 0;
            background: var(--tm-bg); border: 1px solid var(--tm-border); border-left: none;
        }
        .tm-portal-layout .row.g-2 > [class*="col-"] { margin-bottom: 8px; }

        /* ── Dropdown menu ── */
        .tm-dropdown-menu {
            display: none; position: absolute; right: 0; top: 100%; margin-top: 4px;
            background: #fff; border: 1px solid var(--tm-border); border-radius: 8px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.1); z-index: 100; min-width: 200px; overflow: hidden;
        }
        .tm-dropdown-menu.tm-dropdown-open { display: block; }
        .tm-dropdown-item {
            display: block; padding: 8px 12px; font-size: 12px;
            color: var(--tm-text); text-decoration: none; transition: background 0.1s;
        }
        .tm-dropdown-item:hover { background: var(--tm-bg); color: var(--tm-blue); text-decoration: none; }
    </style>
</template>

</odoo>
