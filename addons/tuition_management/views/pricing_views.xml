<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tuition_pricing_wizard_form" model="ir.ui.view">
        <field name="name">tuition.pricing.wizard.form</field>
        <field name="model">tuition.pricing.wizard</field>
        <field name="arch" type="xml">
            <form string="Pricing" create="false" delete="false" duplicate="false">
                <sheet>
                    <field name="allowed_currency_ids" invisible="1"/>
                    <field name="allowed_product_ids" invisible="1"/>
                    <field name="allowed_pricelist_ids" invisible="1"/>
                    <div class="tm-rf-filters-card">
                        <group string="Filters">
                            <field name="filter_company_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                            <field name="filter_currency_id" domain="[('id', 'in', allowed_currency_ids)]" options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                            <field name="filter_product_id" domain="[('id', 'in', allowed_product_ids)]" options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                            <field name="filter_pricelist_id" domain="[('id', 'in', allowed_pricelist_ids)]" options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                            <field name="filter_number_of_classes"/>
                        </group>
                        <div class="tm-rf-btn-row">
                            <button name="action_refresh" type="object" string="Apply" class="btn-primary tm-rf-btn-apply" icon="fa-filter"/>
                            <button name="action_clear_filters" type="object" string="Clear Filters" class="btn-secondary tm-rf-btn" icon="fa-times"/>
                        </div>
                    </div>
                    <div class="tm-rf-table-card">
                        <field name="line_ids" nolabel="1">
                            <list string="Pricing" create="false" edit="false" delete="false" no_open="1">
                                <field name="product_id" options="{'no_open': True}"/>
                                <field name="pricelist_id" options="{'no_open': True}"/>
                                <field name="company_id" options="{'no_open': True}"/>
                                <field name="number_of_classes" string="Number of Classes"/>
                                <field name="price" widget="monetary"/>
                                <field name="currency_id" options="{'no_open': True}"/>
                            </list>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pre-create wizard so form opens with a real res_id (same pattern as other reports) -->
    <record id="action_open_tuition_pricing" model="ir.actions.server">
        <field name="name">Open Pricing</field>
        <field name="model_id" ref="model_tuition_pricing_wizard"/>
        <field name="state">code</field>
        <field name="code">
rec = env['tuition.pricing.wizard'].create({})
action = {
    'type': 'ir.actions.act_window',
    'name': 'Pricing',
    'res_model': 'tuition.pricing.wizard',
    'view_mode': 'form',
    'res_id': rec.id,
    'target': 'current',
}
        </field>
    </record>

    <menuitem id="menu_tuition_pricing" name="Pricing" parent="menu_tuition_reports"
              action="action_open_tuition_pricing" sequence="40"
              groups="tuition_management.group_tuition_reports_access,base.group_system"/>
</odoo>
