<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tuition_class_status_wizard_form" model="ir.ui.view">
        <field name="name">tuition.class.status.wizard.form</field>
        <field name="model">tuition.class.status.wizard</field>
        <field name="arch" type="xml">
            <form js_class="tm_report_form" string="Class Status Report" create="false" delete="false" duplicate="false">
                <sheet>
                    <div class="tm-rf-filters-card">
                        <group>
                            <group>
                                <field name="from_date"/>
                                <field name="to_date"/>
                                <field name="report_tz" required="1"/>
                            </group>
                            <group>
                                <field name="group_by"/>
                            </group>
                        </group>
                        <div class="tm-rf-btn-row">
                            <button name="action_refresh" type="object" string="Apply" class="btn-primary tm-rf-btn-apply" icon="fa-filter"/>
                            <button name="action_export_excel" type="object" string="Export to Excel" class="btn-secondary tm-rf-btn" icon="fa-file-excel-o"/>
                        </div>
                    </div>
                    <div class="tm-rf-table-card">
                        <field name="line_ids" nolabel="1">
                            <list string="Class Status Report" create="false" edit="false" delete="false" no_open="1">
                                <field name="report_date" string="Date"/>
                                <field name="tz_abbr" string="TZ"/>
                                <field name="total_scheduled_classes" string="Scheduled" sum="Total Scheduled"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_scheduled'}"/>
                                <field name="pending_classes" string="Pending (All)" sum="Total Pending"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_pending'}"/>
                                <field name="total_demos" string="Demos" sum="Total Demos"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_demos'}"/>
                                <field name="completed_classes" string="Completed" sum="Total Completed"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_completed'}"/>
                                <field name="cancelled_classes" string="Cancelled" sum="Total Cancelled"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_cancelled'}"/>
                                <field name="rescheduled_classes" string="Rescheduled" sum="Total Rescheduled"
                                       widget="tm_drilldown_stat" options="{'action': 'action_view_rescheduled'}"/>
                            </list>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Drill-down lesson list shared by the Class Status, Subject-wise and
         Tutor-wise reports: times are shown in the report's timezone (passed
         as context['tz']) with its short code, e.g. "21 Oct 2026, 14:00 IST". -->
    <record id="view_report_occurrence_drilldown_list" model="ir.ui.view">
        <field name="name">class.schedule.occurrence.report.drilldown.list</field>
        <field name="model">class.schedule.occurrence</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Lessons" create="false" edit="false" delete="false">
                <field name="lesson_time_user_display" string="Date &amp; Time"/>
                <field name="name"/>
                <field name="course_id"/>
                <field name="tutor_id"/>
                <field name="lesson_status" widget="badge"
                       decoration-success="lesson_status == 'completed'"
                       decoration-warning="lesson_status == 'scheduled'"
                       decoration-muted="lesson_status == 'cancelled'"
                       decoration-info="lesson_status == 'under_review'"/>
                <field name="is_demo" string="Demo"/>
                <field name="is_rescheduled" string="Rescheduled"/>
                <field name="attendance_marked"/>
                <field name="start_datetime" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Legacy act_window kept for backward compatibility (external bookmarks / other refs) -->
    <record id="action_tuition_class_status_report" model="ir.actions.act_window">
        <field name="name">Class Status Report</field>
        <field name="res_model">tuition.class.status.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
