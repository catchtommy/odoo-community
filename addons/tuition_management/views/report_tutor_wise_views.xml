<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tuition_tutor_wise_wizard_form" model="ir.ui.view">
        <field name="name">tuition.tutor.wise.wizard.form</field>
        <field name="model">tuition.tutor.wise.wizard</field>
        <field name="arch" type="xml">
            <form string="Tutor-wise Report" create="false" delete="false" duplicate="false">
                <sheet>
                    <div class="tm-rf-filters-card">
                        <group string="Filters">
                            <group>
                                <field name="from_date"/>
                                <field name="to_date"/>
                                <field name="filter_tutor_id"/>
                            </group>
                            <group>
                                <field name="filter_category_id"/>
                                <field name="filter_subject_id" domain="[('category_id','=',filter_category_id)] if filter_category_id else []"/>
                                <field name="group_by"/>
                            </group>
                        </group>
                        <div class="tm-rf-btn-row">
                            <button name="action_refresh" type="object" string="Apply" class="btn-primary tm-rf-btn-apply" icon="fa-filter"/>
                            <button name="action_clear_filters" type="object" string="Clear Filters" class="btn-secondary tm-rf-btn" icon="fa-times"/>
                            <button name="action_export_excel" type="object" string="Export to Excel" class="btn-secondary tm-rf-btn" icon="fa-file-excel-o"/>
                            <button name="action_close_report" type="object" string="Close" class="btn-secondary tm-rf-btn" icon="fa-sign-out"/>
                        </div>
                    </div>
                    <div class="tm-rf-table-card">
                        <field name="line_ids" nolabel="1">
                            <list string="Tutor-wise Report" create="false" edit="false" delete="false">
                                <field name="tutor_id"/>
                                <field name="category_subject"/>
                                <field name="category_id" optional="hide"/>
                                <field name="subject_id" optional="hide"/>
                                <field name="total_classes" sum="Classes"/>
                                <button name="action_open_classes" type="object" icon="fa-external-link" string="Details"/>
                                <field name="total_demos" sum="Demos"/>
                                <button name="action_open_demos" type="object" icon="fa-external-link" string="Details"/>
                                <field name="completed_classes" sum="Completed"/>
                                <button name="action_open_completed" type="object" icon="fa-external-link" string="Details"/>
                                <field name="cancelled_classes" sum="Cancelled"/>
                                <button name="action_open_cancelled" type="object" icon="fa-external-link" string="Details"/>
                                <field name="effective_classes" sum="Effective"/>
                                <button name="action_open_effective" type="object" icon="fa-external-link" string="Details"/>
                            </list>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Legacy act_window kept for backward compatibility -->
    <record id="action_tuition_tutor_wise_report" model="ir.actions.act_window">
        <field name="name">Tutor-wise Report</field>
        <field name="res_model">tuition.tutor.wise.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
