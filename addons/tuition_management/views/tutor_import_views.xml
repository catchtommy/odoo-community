<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Tutor Import / Export Wizard
    ============================================================ -->
    <record id="view_tutor_import_wizard_form" model="ir.ui.view">
        <field name="name">tutor.import.wizard.form</field>
        <field name="model">tutor.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Tutor Import / Export">
                <sheet>

                    <field name="state" invisible="1"/>

                    <!-- ══════════════════════════════════════════════
                         STATE: ready  –  upload / export
                    ══════════════════════════════════════════════ -->
                    <div invisible="state != 'ready'">

                        <div class="alert alert-info mb-3" role="alert">
                            <h5 class="alert-heading">
                                <i class="fa fa-info-circle me-1"/> How to use
                            </h5>
                            <ul class="mb-0">
                                <li>
                                    <strong>Export all tutors</strong> — download a
                                    CSV of every existing tutor profile.
                                </li>
                                <li>
                                    <strong>Download blank template</strong> — get an
                                    empty CSV with the correct headers and an example row.
                                </li>
                                <li>
                                    <strong>Bulk import</strong> — fill in the template,
                                    upload it below, then click
                                    <em>Preview Import</em> to review before confirming.
                                    A tutor is matched only when
                                    <em>both Email and Full Name match</em>
                                    (case-insensitive).
                                </li>
                            </ul>
                        </div>

                        <group string="Export">
                            <div class="d-flex gap-2 flex-wrap">
                                <button name="action_download_template"
                                        type="object"
                                        string="⬇  Download Import Template"
                                        class="btn btn-secondary"/>
                                <button name="action_export_tutors"
                                        type="object"
                                        string="⬇  Export All Tutors"
                                        class="btn btn-secondary"/>
                            </div>
                        </group>

                        <group string="Import Tutors">
                            <field name="import_file"
                                   widget="binary"
                                   filename="import_filename"
                                   string="Upload CSV File"/>
                            <field name="import_filename" invisible="1"/>
                        </group>

                    </div>

                    <!-- ══════════════════════════════════════════════
                         STATE: preview  –  show parsed rows
                    ══════════════════════════════════════════════ -->
                    <div invisible="state != 'preview'">

                        <!-- Summary banner -->
                        <div class="row mb-3">
                            <div class="col-3">
                                <div class="card text-center border-secondary">
                                    <div class="card-body py-2">
                                        <div class="fs-4 fw-bold">
                                            <field name="preview_count" readonly="1"/>
                                        </div>
                                        <small class="text-muted">Total Rows</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="card text-center border-success">
                                    <div class="card-body py-2">
                                        <div class="fs-4 fw-bold text-success">
                                            <field name="preview_create_count" readonly="1"/>
                                        </div>
                                        <small class="text-muted">To Create</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="card text-center border-primary">
                                    <div class="card-body py-2">
                                        <div class="fs-4 fw-bold text-primary">
                                            <field name="preview_update_count" readonly="1"/>
                                        </div>
                                        <small class="text-muted">To Update</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="card text-center border-danger">
                                    <div class="card-body py-2">
                                        <div class="fs-4 fw-bold text-danger">
                                            <field name="preview_error_count" readonly="1"/>
                                        </div>
                                        <small class="text-muted">Rows with Issues</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning mb-2" role="alert"
                             invisible="preview_error_count == 0">
                            <i class="fa fa-exclamation-triangle me-1"/>
                            Rows highlighted in red have errors and will be
                            <strong>skipped</strong> during import. Fix them in your
                            CSV and re-upload, or correct inline and re-preview.
                        </div>

                        <div class="alert alert-success mb-2" role="alert"
                             invisible="preview_error_count != 0">
                            <i class="fa fa-check-circle me-1"/>
                            All rows are valid. Review below, then click
                            <strong>Confirm Import</strong>.
                        </div>

                        <!-- Editable preview list -->
                        <field name="preview_line_ids"
                               nolabel="1"
                               widget="one2many">
                            <list
                                decoration-danger="has_error"
                                decoration-success="action == 'create' and not has_error"
                                decoration-info="action == 'update' and not has_error"
                                editable="bottom">
                                <field name="row_num" string="#" readonly="1" width="40"/>
                                <field name="action" widget="badge" readonly="1" width="70"/>
                                <field name="name" string="Full Name"/>
                                <field name="email"/>
                                <field name="country_code" string="Cty Code" width="80"/>
                                <field name="phone"/>
                                <field name="timezone"/>
                                <field name="status" widget="badge"/>
                                <field name="categories"/>
                                <field name="subjects"/>
                                <field name="grades"/>
                                <field name="warning" string="Notes" readonly="1"/>
                                <field name="has_error" column_invisible="1"/>
                            </list>
                        </field>

                    </div>

                    <!-- ══════════════════════════════════════════════
                         STATE: export_done  –  download link
                    ══════════════════════════════════════════════ -->
                    <div invisible="state != 'export_done'">
                        <div class="alert alert-success mb-3" role="alert">
                            <i class="fa fa-check-circle me-1"/>
                            Your file is ready — click the link below to download it.
                        </div>
                        <group string="Download">
                            <field name="output_file"
                                   widget="binary"
                                   filename="output_filename"
                                   string="File"/>
                            <field name="output_filename" invisible="1"/>
                        </group>
                    </div>

                    <!-- ══════════════════════════════════════════════
                         STATE: import_done  –  result summary
                    ══════════════════════════════════════════════ -->
                    <div invisible="state != 'import_done'">
                        <group string="Import Result">
                            <field name="result_log"
                                   widget="text"
                                   string="Summary"
                                   readonly="1"
                                   style="font-family: monospace; white-space: pre;"/>
                        </group>
                    </div>

                </sheet>

                <footer>
                    <!-- Step 1: preview button (ready state) -->
                    <button name="action_preview"
                            type="object"
                            string="Preview Import"
                            class="btn btn-primary"
                            invisible="state != 'ready'"/>

                    <!-- Step 2: confirm button (preview state) -->
                    <button name="action_confirm_import"
                            type="object"
                            string="✔  Confirm Import"
                            class="btn btn-primary"
                            invisible="state != 'preview'"/>

                    <!-- Back to upload (preview state) -->
                    <button name="action_reset"
                            type="object"
                            string="↩  Re-upload"
                            class="btn btn-secondary"
                            invisible="state != 'preview'"/>

                    <!-- Start over (export_done / import_done) -->
                    <button name="action_reset"
                            type="object"
                            string="↩  Start Over"
                            class="btn btn-secondary"
                            invisible="state == 'ready' or state == 'preview'"/>

                    <button special="cancel"
                            string="Close"
                            class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_tutor_import_wizard" model="ir.actions.act_window">
        <field name="name">Tutor Import / Export</field>
        <field name="res_model">tutor.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Server action bound to tutor.profile → appears in Action ▾ menu
         binding_view_types='list' ensures it shows in the list control panel -->
    <record id="action_tutor_import_server" model="ir.actions.server">
        <field name="name">Import / Export Tutors</field>
        <field name="model_id" ref="tuition_management.model_tutor_profile"/>
        <field name="binding_model_id" ref="tuition_management.model_tutor_profile"/>
        <field name="binding_view_types">list</field>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Tutor Import / Export',
    'res_model': 'tutor.import.wizard',
    'view_mode': 'form',
    'target': 'new',
}
        </field>
    </record>

</odoo>
