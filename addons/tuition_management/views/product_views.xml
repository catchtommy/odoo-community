<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_variant_easy_edit_inherit_tuition" model="ir.ui.view">
        <field name="name">product.product.view.form.easy.inherit.tuition</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Tuition" name="tuition_group">
                    <field name="tuition_classes_per_week"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
