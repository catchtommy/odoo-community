<!-- Student Profile Views -->
<record id="view_student_profile_list" model="ir.ui.view">
<field name="name">student.profile.list</field>
<field name="model">student.profile</field>
<field name="arch" type="xml">
<list>
<field name="name" string="Full Name"/>
<field name="email"/>
<field name="phone"/>
<field name="grade_id"/>
</list>
</field>
</record>

<record id="view_student_profile_form" model="ir.ui.view">
<field name="name">student.profile.form</field>
<field name="model">student.profile</field>
<field name="arch" type="xml">
<form>
<header>
<button name="action_invite_to_portal" type="object" string="Invite to Portal" class="btn-primary" icon="fa-globe" invisible="has_portal_access or not id"/>
</header>
<sheet>
<div class="oe_button_box" name="button_box">
<button class="oe_stat_button" icon="fa-globe" invisible="not has_portal_access" disabled="1">
<span class="o_stat_text text-success">Portal Active</span>
</button>
</div>
<field name="has_portal_access" invisible="1"/>
<group string="Personal Information">
<field name="name" string="Full Name"/>
<field name="email"/>
<label for="phone" string="Phone Number"/>
<div style="display: grid; grid-template-columns: 25% 75%; gap: 8px;">
<field name="country_code" placeholder="Country Code"/>
<field name="phone" class="o_field_char" placeholder="Phone Number"/>
</div>
</group>
<group string="Academic Information">
<field name="grade_id"/>
<field name="subjects_ids" widget="many2many_tags"/>
</group>
<group string="Parent">
<field name="parent_id"/>
<button name="action_view_parent" type="object" string="View Parent" class="btn-link" icon="fa-external-link" invisible="not parent_id"/>
</group>
<group string="Address">
<field name="address_line_1" placeholder="Address Line 1"/>
<field name="address_line_2" placeholder="Address Line 2"/>
<field name="address_line_3" placeholder="Address Line 3"/>
<field name="address_line_4" placeholder="Address Line 4"/>
<field name="zip_code"/>
</group>
</sheet>
</form>
</field>
</record>

<!-- Tutor Availability Views -->
<record id="view_tutor_availability_list" model="ir.ui.view">
<field name="name">tutor.availability.list</field>
<field name="model">tutor.availability</field>
