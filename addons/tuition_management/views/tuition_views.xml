</field>
</record>

<record id="view_tutor_availability_form" model="ir.ui.view">
<field name="name">tutor.availability.form</field>
<field name="model">tutor.availability</field>
<field name="arch" type="xml">
<form string="Tutor Availability">
<sheet>
<group>
<field name="tutor_id"/>
<field name="day_of_week"/>
<field name="start_time"/>
<field name="end_time"/>
</group>
</sheet>
</form>
</field>
</record>

<!-- Tutor Profile Form View -->
<record id="view_tutor_profile_form" model="ir.ui.view">
<field name="name">tutor.profile.form</field>
<field name="model">tutor.profile</field>
<field name="arch" type="xml">
<form>
<header>
<button name="action_invite_to_portal" type="object" string="Invite to Portal" class="btn-primary" icon="fa-globe" invisible="has_portal_access or not id"/>
</header>
<sheet>
<div class="oe_button_box" name="button_box">
<button class="oe_stat_button" icon="fa-globe" invisible="not has_portal_access" disabled="1">
<span class="o_stat_text text-success">Portal Active</span>
</button>
</div>
<field name="has_portal_access" invisible="1"/>
<group string="Personal Information">
<field name="name" string="Full Name"/>
<field name="email"/>
<label for="phone" string="Phone Number"/>
<div style="display: grid; grid-template-columns: 25% 75%; gap: 8px;">
<field name="country_code" placeholder="Country Code"/>
<field name="phone" class="o_field_char" placeholder="Phone Number"/>
</div>
</group>
<group string="Subjects">
<field name="subject_ids" widget="many2many_tags"/>
</group>
<notebook>
<page string="Availability">
<field name="availability_ids">
<list string="Availability" editable="bottom">
<field name="day_of_week"/>
<field name="start_time" widget="float_time"/>
<field name="end_time" widget="float_time"/>
</list>
</field>
</page>
</notebook>
</sheet>
</form>
</field>
</record>

