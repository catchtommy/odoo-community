<!-- Enquiry Views -->
<record id="view_enquiry_form" model="ir.ui.view">
<field name="name">enquiry.form</field>
<field name="model">enquiry</field>
<field name="arch" type="xml">
<form string="Enquiry">
<header>
<field name="is_enrolled_stage" invisible="1"/>
<field name="is_enrolled" invisible="1"/>
<button name="action_enroll_to_course" type="object" string="Convert to Course" class="btn-primary" icon="fa-graduation-cap" invisible="not is_enrolled_stage or is_enrolled"/>
</header>
<div class="alert alert-success" role="status" invisible="not is_enrolled">
<strong><i class="fa fa-check-circle"/> Enrolled!</strong> This enquiry has been converted to a course enrollment.
</div>
<div class="alert alert-info" role="status">
<field name="stage_id" nolabel="1" widget="statusbar" options="{'clickable': True}" readonly="is_enrolled"/>
</div>
<sheet>
<div class="oe_button_box" name="button_box">
<button name="action_delete_enquiry" type="object" class="oe_stat_button" icon="fa-trash" invisible="not id or is_enrolled" confirm="Are you sure you want to permanently delete this enquiry?">
<span>Discard</span>
</button>
</div>
<group string="Course Information" invisible="not is_enrolled">
<field name="course_id"/>
<field name="enrollment_id"/>
<field name="parent_profile_id"/>
<field name="student_profile_id"/>
</group>
<group string="Enquiry Information">
<field name="enquiry_name" readonly="1"/>
<field name="enquiry_date" readonly="is_enrolled"/>
</group>
<group string="Parent Information">
<field name="name" string="Parent Name" readonly="is_enrolled"/>
<field name="email" readonly="is_enrolled"/>
<field name="partner_id" readonly="is_enrolled"/>
<label for="phone" string="Phone Number"/>
<div style="display: grid; grid-template-columns: 25% 75%; gap: 8px;">
<field name="country_code" placeholder="Country Code" readonly="is_enrolled"/>
<field name="phone" class="o_field_char" placeholder="Phone Number" readonly="is_enrolled"/>
</div>
</group>
<group string="Student Information">
<field name="student_name" readonly="is_enrolled"/>
</group>
<group string="Academic Information">
<field name="subject_id" readonly="is_enrolled"/>
<field name="grade_id" readonly="is_enrolled"/>
</group>
<group string="Demo Sessions">
<field name="demo_session_ids" readonly="is_enrolled"/>
</group>
<group string="Notes">
<field name="notes" nolabel="1" readonly="is_enrolled"/>
</group>
</sheet>
</form>
</field>
</record>

