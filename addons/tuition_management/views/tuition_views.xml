<!-- Enquiry Kanban View -->
<record id="view_enquiry_kanban" model="ir.ui.view">
<field name="name">enquiry.kanban</field>
<field name="model">enquiry</field>
<field name="arch" type="xml">
<kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
<field name="enquiry_name"/>
<field name="name"/>
<field name="student_name"/>
<field name="email"/>
<field name="phone"/>
<field name="subject_id"/>
<field name="grade_id"/>
<field name="stage_id"/>
<field name="enquiry_date"/>
<templates>
<t t-name="card">
<div class="oe_kanban_content">
<div class="o_kanban_record_top mb-0">
<div class="o_kanban_record_headings">
<strong class="o_kanban_record_title">
<field name="enquiry_name"/>
</strong>
</div>
</div>
<div class="o_kanban_record_body">
<div class="mb-1">
<strong>Parent:</strong> <field name="name"/>
</div>
<div class="mb-1">
<strong>Student:</strong> <field name="student_name"/>
</div>
<div class="mb-1" t-if="record.subject_id.value">
<strong>Subject:</strong> <field name="subject_id"/>
</div>
<div class="mb-1" t-if="record.grade_id.value">
<strong>Grade:</strong> <field name="grade_id"/>
</div>
<div class="text-muted" t-if="record.email.value">
<i class="fa fa-envelope me-1" title="Email"/><field name="email"/>
</div>
<div class="text-muted" t-if="record.phone.value">
<i class="fa fa-phone me-1" title="Phone"/><field name="phone"/>
</div>
</div>
<div class="o_kanban_record_bottom">
<div class="oe_kanban_bottom_left">
<field name="enquiry_date" widget="date"/>
</div>
</div>
</div>
</t>
</templates>
</kanban>
</field>
</record>

