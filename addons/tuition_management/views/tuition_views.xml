<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Enquiry Views -->
    <record id="view_enquiry_form" model="ir.ui.view">
        <field name="name">enquiry.form</field>
        <field name="model">enquiry</field>
        <field name="arch" type="xml">
            <form string="Enquiry">
                <header>
                    <field name="is_enrolled_stage" invisible="1"/>
                    <field name="is_enrolled" invisible="1"/>
                    <field name="can_convert_course" invisible="1"/>
                    <field name="possible_duplicate_parent_id" invisible="1"/>
                    <button name="action_attach_existing_parent" type="object" string="Attach to Existing Parent"
                            class="btn-primary" icon="fa-link" invisible="not possible_duplicate_parent_id"/>
                    <button name="action_create_new_parent_and_student" type="object" string="Create New Parent &amp; Student"
                            class="btn-secondary" icon="fa-user-plus" invisible="not possible_duplicate_parent_id"
                            confirm="Create a brand new parent and student profile even though this matches an existing family?"/>
                    <button name="action_enroll_to_course" type="object" string="Convert to Course" class="btn-primary" icon="fa-graduation-cap" invisible="not can_convert_course"/>
                </header>
                <div class="alert alert-warning" role="status" invisible="not possible_duplicate_parent_id">
                    <strong><i class="fa fa-exclamation-triangle"/> Possible duplicate found.</strong>
                    This enquiry's email/phone matches an existing parent — no parent or student profile has
                    been created yet. Review the match below, then use "Attach to Existing Parent" if it's the
                    same family, or "Create New Parent &amp; Student" if it's a different person.
                    <div class="mt-2">
                        <field name="possible_duplicate_parent_id" readonly="1" nolabel="1"/>
                        <span invisible="not possible_duplicate_parent_email"> — <field name="possible_duplicate_parent_email" readonly="1" nolabel="1" class="oe_inline"/></span>
                        <span invisible="not possible_duplicate_parent_phone"> — <field name="possible_duplicate_parent_phone" readonly="1" nolabel="1" class="oe_inline"/></span>
                    </div>
                </div>
                <div class="alert alert-success" role="status" invisible="not is_enrolled">
                    <strong><i class="fa fa-check-circle"/> Enrolled!</strong> This enquiry has been converted to a course enrollment.
                </div>
                <div class="alert alert-info" role="status">
                    <field name="stage_id" nolabel="1" widget="statusbar" options="{'clickable': True}" readonly="is_enrolled"/>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="sibling_enquiry_count" invisible="1"/>
                        <button name="action_view_sibling_enquiries" type="object" class="oe_stat_button" icon="fa-users" invisible="not sibling_enquiry_count">
                            <field name="sibling_enquiry_count" widget="statinfo" string="Related Enquiries"/>
                        </button>
                        <button name="action_delete_enquiry" type="object" class="oe_stat_button" icon="fa-trash" invisible="not id or is_enrolled" confirm="Are you sure you want to permanently delete this enquiry?">
                            <span>Discard</span>
                        </button>
                    </div>
                    <field name="can_edit_enquiry" invisible="1"/>
                    <group string="Course Information" invisible="not is_enrolled">
                        <field name="course_id"/><field name="enrollment_id"/>
                        <field name="parent_profile_id"/><field name="student_profile_id"/>
                    </group>
                    <group string="Enquiry Information" readonly="not can_edit_enquiry">
                        <field name="enquiry_name" readonly="1"/>
                        <field name="enquiry_date" readonly="is_enrolled"/>
                        <field name="assigned_user_id" readonly="is_enrolled"/>
                        <field name="enquiry_source" readonly="is_enrolled"/>
                        <field name="status" invisible="1"/>
                    </group>
                    <group string="Parent Information" readonly="not can_edit_enquiry">
                        <field name="parent_profile_id" string="Parent" readonly="is_enrolled" invisible="is_enrolled" required="not possible_duplicate_parent_id"/>
                        <field name="name" string="Parent Name" readonly="1" force_save="1"/>
                        <field name="email" readonly="1" force_save="1"/>
                        <field name="partner_id" readonly="1" force_save="1"/>
                        <label for="phone" string="Phone Number"/>
                        <div style="display: grid; grid-template-columns:25% 75%; gap: 2px;">
                            <field name="country_code" placeholder="Country Code" readonly="1" force_save="1"/>
                            <field name="phone" class="o_field_char" placeholder="Phone Number" readonly="1" force_save="1"/>
                        </div>
                    </group>
                    <group string="Student Information" readonly="not can_edit_enquiry">
                        <field name="student_profile_id" string="Student" domain="[('parent_id', '=', parent_profile_id)]" readonly="is_enrolled" invisible="is_enrolled or not parent_profile_id" required="not possible_duplicate_parent_id"/>
                        <field name="student_name" readonly="1" force_save="1"/>
                        <field name="student_age" string="Student Age"/>
                    </group>
                    <group string="Academic Information" readonly="not can_edit_enquiry">
                        <field name="category_id" readonly="is_enrolled" options="{'no_create': True, 'no_open': True}"/>
                        <field name="subject_id" domain="[('category_id', '=', category_id)]" readonly="is_enrolled" options="{'no_create': True, 'no_open': True}"/>
                        <field name="grade_id" domain="[('category_ids', 'in', [category_id])]" readonly="is_enrolled" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group string="Notes" readonly="not can_edit_enquiry">
                        <field name="notes" nolabel="1" readonly="is_enrolled"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_enquiry_list" model="ir.ui.view">
        <field name="name">enquiry.list</field>
        <field name="model">enquiry</field>
        <field name="arch" type="xml">
            <list string="Enquiries" decoration-warning="possible_duplicate_parent_id">
                <field name="enquiry_name"/><field name="name" string="Parent Name"/>
                <field name="student_name"/><field name="student_age"/><field name="email"/><field name="phone"/>
                <field name="subject_id"/><field name="grade_id"/><field name="stage_id"/>
                <field name="possible_duplicate_parent_id" string="Possible Duplicate Of" readonly="1" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_enquiry_search" model="ir.ui.view">
        <field name="name">enquiry.search</field>
        <field name="model">enquiry</field>
        <field name="arch" type="xml">
            <search string="Enquiries">
                <field name="enquiry_name"/>
                <field name="name" string="Parent Name"/>
                <field name="student_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="subject_id"/>
                <field name="grade_id"/>
                <filter name="possible_duplicates" string="Possible Duplicates"
                        domain="[('possible_duplicate_parent_id', '!=', False)]"/>
                <group>
                    <filter name="group_by_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_enquiry_kanban" model="ir.ui.view">
        <field name="name">enquiry.kanban</field>
        <field name="model">enquiry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
                <field name="enquiry_name"/>
                <field name="name"/>
                <field name="student_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="subject_id"/>
                <field name="grade_id"/>
                <field name="stage_id"/>
                <field name="enquiry_date"/>
                <field name="possible_duplicate_parent_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="enquiry_name"/></strong>
                                </div>
                                <span t-if="record.possible_duplicate_parent_id.raw_value" class="badge text-bg-warning">
                                    <i class="fa fa-exclamation-triangle me-1"/>Possible Duplicate
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="mb-1"><strong>Parent:</strong> <field name="name"/></div>
                                <div class="mb-1"><strong>Student:</strong> <field name="student_name"/></div>
                                <div class="mb-1" t-if="record.subject_id.raw_value"><strong>Subject:</strong> <field name="subject_id"/></div>
                                <div class="mb-1" t-if="record.grade_id.raw_value"><strong>Grade:</strong> <field name="grade_id"/></div>
                                <div class="text-muted" t-if="record.email.raw_value"><i class="fa fa-envelope me-1"/><field name="email"/></div>
                                <div class="text-muted" t-if="record.phone.raw_value"><i class="fa fa-phone me-1"/><field name="phone"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left"><field name="enquiry_date" widget="date"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_enquiry_attach_parent_wizard_form" model="ir.ui.view">
        <field name="name">enquiry.attach.parent.wizard.form</field>
        <field name="model">enquiry.attach.parent.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Attach to Existing Parent">
                <field name="enquiry_id" invisible="1"/>
                <field name="is_new_student" invisible="1"/>
                <group string="Attaching to this Parent">
                    <field name="parent_id" readonly="1"/>
                    <field name="parent_email" readonly="1" invisible="not parent_email"/>
                    <field name="parent_phone" readonly="1" invisible="not parent_phone"/>
                </group>
                <div class="alert alert-info mb-0" role="status" invisible="not is_new_student">
                    <i class="fa fa-user-plus me-1"/>
                    A new student profile "<field name="student_name" readonly="1" class="oe_inline fw-bold" nolabel="1"/>"
                    will be created under this parent.
                </div>
                <div class="alert alert-success mb-0" role="status" invisible="is_new_student">
                    <i class="fa fa-check-circle me-1"/>
                    This matches an existing student under this parent — the enquiry will attach to:
                    <group>
                        <field name="matching_student_id" readonly="1"/>
                        <field name="matching_student_grade_id" readonly="1" string="Grade" invisible="not matching_student_grade_id"/>
                    </group>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_enquiry_form_quick_create" model="ir.ui.view">
        <field name="name">enquiry.form.quick_create</field>
        <field name="model">enquiry</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="enquiry_name" placeholder="e.g., SAT Enquiry for John"/>
                    <field name="name" string="Parent Name" placeholder="Parent Full Name"/>
                    <field name="student_name" placeholder="Student Full Name"/>
                    <field name="partner_id"/><field name="email" placeholder="Email"/>
                    <field name="phone" placeholder="Phone"/>
                    <field name="subject_id" options="{'no_create': True, 'no_open': True}"/><field name="grade_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
            </form>
        </field>
    </record>
    <record id="action_enquiry" model="ir.actions.act_window">
        <field name="name">Enquiries</field>
        <field name="res_model">enquiry</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Enquiry Batch Wizard (multi-student entry) -->
    <record id="view_enquiry_batch_wizard_form" model="ir.ui.view">
        <field name="name">enquiry.batch.wizard.form</field>
        <field name="model">enquiry.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="New Enquiry (Multiple Students)">
                <group string="Parent / Guardian">
                    <field name="parent_profile_id"/>
                    <field name="name" string="Parent Name"/>
                    <field name="email"/>
                    <label for="phone" string="Phone Number"/>
                    <div style="display: grid; grid-template-columns:25% 75%; gap: 2px;">
                        <field name="country_code" placeholder="Country Code"/>
                        <field name="phone" class="o_field_char" placeholder="Phone Number"/>
                    </div>
                    <field name="enquiry_source"/>
                </group>
                <group string="Students">
                    <field name="student_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="student_name"/>
                            <field name="student_age"/>
                            <field name="category_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="subject_id" domain="[('category_id', '=', category_id)]" options="{'no_create': True, 'no_open': True}"/>
                            <field name="grade_id" domain="[('category_ids', 'in', [category_id])]" options="{'no_create': True, 'no_open': True}"/>
                        </list>
                    </field>
                </group>
                <group string="Notes">
                    <field name="notes" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_create_enquiries" type="object" string="Create Enquiries" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_enquiry_batch_wizard" model="ir.actions.act_window">
        <field name="name">New Enquiry (Multiple Students)</field>
        <field name="res_model">enquiry.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Demo Session Views -->
    <record id="view_demo_session_list" model="ir.ui.view">
        <field name="name">demo.session.list</field>
        <field name="model">demo.session</field>
        <field name="arch" type="xml">
            <list string="Demo Sessions">
                <field name="course_id"/><field name="subject_id"/><field name="tutor_id"/>
                <field name="scheduled_datetime"/><field name="duration_minutes"/>
                <field name="status"/><field name="rating"/>
            </list>
        </field>
    </record>
    <record id="view_demo_session_form" model="ir.ui.view">
        <field name="name">demo.session.form</field>
        <field name="model">demo.session</field>
        <field name="arch" type="xml">
            <form string="Demo Session">
                <sheet>
                    <group>
                        <field name="course_id" readonly="1" invisible="not course_id"/>
                        <field name="subject_id" options="{'no_open': True, 'no_create': True}"/>
                    </group>
                    <group>
                        <field name="scheduled_datetime"/>
                        <field name="timezone"/>
                        <field name="duration_minutes" string="Duration (Minutes)"/>
                    </group>
                    <group string="Tutor Selection">
                        <field name="available_tutor_ids" invisible="1"/>
                        <field name="no_tutor_available" invisible="1"/>
                        <div colspan="2" invisible="no_tutor_available">
                            <p class="text-muted mb-1"><i class="fa fa-check-circle text-success"/> Tutors available for the selected date and time:</p>
                            <field name="available_tutor_ids" widget="many2many_tags" readonly="1" nolabel="1" class="mb-2"/>
                        </div>
                        <div colspan="2" invisible="not no_tutor_available">
                            <div class="alert alert-warning mb-2" role="alert">
                                <i class="fa fa-exclamation-triangle"/> <strong>No tutors available</strong> for the selected date and time.
                            </div>
                        </div>
                        <field name="tutor_id" string="Assign Tutor"/>
                    </group>
                    <group>
                        <field name="status"/><field name="rating"/>
                    </group>
                    <group string="Feedback">
                        <field name="feedback" nolabel="1" widget="text" colspan="2" style="width: 100%; min-height: 200px;"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_demo_sessions" model="ir.actions.act_window">
        <field name="name">Demo Sessions</field>
        <field name="res_model">demo.session</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
