<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Reusable wizard layout macros
    ============================================================ -->

    <!-- ============================================================
         SUBJECT CATEGORY  Import / Export Wizard
    ============================================================ -->
    <record id="view_subject_category_import_wizard_form" model="ir.ui.view">
        <field name="name">subject.category.import.wizard.form</field>
        <field name="model">subject.category.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Subject Category Import / Export">
                <sheet>
                    <field name="state" invisible="1"/>

                    <!-- ── READY ── -->
                    <div invisible="state != 'ready'">
                        <div class="alert alert-info mb-3" role="alert">
                            <h5 class="alert-heading">
                                <i class="fa fa-info-circle me-1"/> How to use
                            </h5>
                            <ul class="mb-0">
                                <li><strong>Export all categories</strong> — download existing data as CSV.</li>
                                <li><strong>Download blank template</strong> — get headers + example row.</li>
                                <li><strong>Bulk import</strong> — fill in the template, upload it, then click
                                    <em>Preview Import</em>. A category is matched by <em>Category Name</em> (case-insensitive).</li>
                            </ul>
                        </div>
                        <group string="Export">
                            <div class="d-flex gap-2 flex-wrap">
                                <button name="action_download_template" type="object"
                                        string="⬇  Download Import Template" class="btn btn-secondary"/>
                                <button name="action_export" type="object"
                                        string="⬇  Export All Subject Categories" class="btn btn-secondary"/>
                            </div>
                        </group>
                        <group string="Import Subject Categories">
                            <field name="import_file" widget="binary"
                                   filename="import_filename" string="Upload CSV File"/>
                            <field name="import_filename" invisible="1"/>
                        </group>
                    </div>

                    <!-- ── PREVIEW ── -->
                    <div invisible="state != 'preview'">
                        <div class="row mb-3">
                            <div class="col-3">
                                <div class="card text-center border-secondary">
                                    <div class="card-body py-2">
                                        <div class="fs-4 fw-bold"><field name="preview_count" readonly="1"/></div>
                                        <small class="text-muted">Total Rows</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="card text-center border-success">
                                    <div class="card-body py-2">
                                        <div class="fs-4 fw-bold text-success"><field name="preview_create_count" readonly="1"/></div>
                                        <small class="text-muted">To Create</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="card text-center border-primary">
                                    <div class="card-body py-2">
                                        <div class="fs-4 fw-bold text-primary"><field name="preview_update_count" readonly="1"/></div>
                                        <small class="text-muted">To Update</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="card text-center border-danger">
                                    <div class="card-body py-2">
                                        <div class="fs-4 fw-bold text-danger"><field name="preview_error_count" readonly="1"/></div>
                                        <small class="text-muted">Rows with Issues</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-warning mb-2" invisible="preview_error_count == 0">
                            <i class="fa fa-exclamation-triangle me-1"/>
                            Rows highlighted in <strong>red</strong> have errors and will be skipped.
                        </div>
                        <div class="alert alert-success mb-2" invisible="preview_error_count != 0">
                            <i class="fa fa-check-circle me-1"/>
                            All rows valid. Review then click <strong>Confirm Import</strong>.
                        </div>
                        <field name="preview_line_ids" nolabel="1" widget="one2many">
                            <list decoration-danger="has_error"
                                  decoration-success="action == 'create' and not has_error"
                                  decoration-info="action == 'update' and not has_error"
                                  editable="bottom">
                                <field name="row_num" string="#" readonly="1" width="40"/>
                                <field name="action" widget="badge" readonly="1" width="70"/>
                                <field name="name" string="Category Name"/>
                                <field name="description"/>
                                <field name="grades"/>
                                <field name="warning" string="Notes" readonly="1"/>
                                <field name="has_error" column_invisible="1"/>
                            </list>
                        </field>
                    </div>

                    <!-- ── EXPORT DONE ── -->
                    <div invisible="state != 'export_done'">
                        <div class="alert alert-success mb-3">
                            <i class="fa fa-check-circle me-1"/> Your file is ready — click to download.
                        </div>
                        <group string="Download">
                            <field name="output_file" widget="binary"
                                   filename="output_filename" string="File"/>
                            <field name="output_filename" invisible="1"/>
                        </group>
                    </div>

                    <!-- ── IMPORT DONE ── -->
                    <div invisible="state != 'import_done'">
                        <group string="Import Result">
                            <field name="result_log" widget="text" string="Summary"
                                   readonly="1" style="font-family: monospace; white-space: pre;"/>
                        </group>
                    </div>
                </sheet>
                <footer>
                    <button name="action_preview" type="object" string="Preview Import"
                            class="btn btn-primary" invisible="state != 'ready'"/>
                    <button name="action_confirm_import" type="object" string="✔  Confirm Import"
                            class="btn btn-primary" invisible="state != 'preview'"/>
                    <button name="action_reset" type="object" string="↩  Re-upload"
                            class="btn btn-secondary" invisible="state != 'preview'"/>
                    <button name="action_reset" type="object" string="↩  Start Over"
                            class="btn btn-secondary"
                            invisible="state == 'ready' or state == 'preview'"/>
                    <button special="cancel" string="Close" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

