<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Class Schedule Views -->
    <record id="view_class_schedule_list" model="ir.ui.view">
        <field name="name">class.schedule.list</field>
        <field name="model">class.schedule</field>
        <field name="arch" type="xml">
            <list string="Class Schedules">
                <field name="course_id"/><field name="schedule_type"/>
                <field name="schedule_hour"/><field name="schedule_minute"/>
                <field name="virtual_provider_default"/>
                <field name="timezone"/><field name="status"/>
            </list>
        </field>
    </record>
    <record id="view_class_schedule_form" model="ir.ui.view">
        <field name="name">class.schedule.form</field>
        <field name="model">class.schedule</field>
        <field name="arch" type="xml">
            <form string="Class Schedule">
                <sheet>
                    <group>
                        <field name="course_id"/><field name="schedule_type"/>
                        <div style="display:flex;align-items:center;gap:8px;padding:4px 0;" colspan="2">
                            <span class="o_form_label" style="min-width:120px;">Class Time</span>
                            <field name="schedule_hour_sel" string="Hour" nolabel="1" style="width:90px;"/>
                            <span style="font-size:18px;font-weight:bold;line-height:1;">:</span>
                            <field name="schedule_minute_sel" string="Minute" nolabel="1" style="width:90px;"/>
                        </div>
                        <field name="schedule_duration" string="Duration (Minutes)"/>
                        <field name="timezone"/><field name="status"/>
                    </group>
                    <!-- One Time: single date picker -->
                    <group invisible="schedule_type != 'one_time'">
                        <field name="schedule_date" required="schedule_type == 'one_time'"/>
                        <field name="one_time_reason" required="schedule_type == 'one_time'"
                               placeholder="Why is this a one-time session? (e.g. makeup class, special request)"/>
                    </group>
                    <!-- One Time: reschedule linkage -->
                    <group string="Reschedule" invisible="schedule_type != 'one_time'">
                        <field name="is_reschedule"/>
                        <field name="rescheduled_from_id" invisible="not is_reschedule"
                               required="is_reschedule and schedule_type == 'one_time'"/>
                    </group>
                    <!-- Recurring: days of week -->
                    <group string="Days of Week" invisible="schedule_type == 'one_time'">
                        <div colspan="2" style="display:flex;gap:24px;flex-wrap:wrap;">
                            <div style="display:flex;gap:16px;">
                                <field name="monday" widget="boolean_toggle" options="{'autosave': False}" on_change="1"/><span style="line-height:2;">Monday</span>
                                <field name="tuesday" widget="boolean_toggle" options="{'autosave': False}" on_change="1"/><span style="line-height:2;">Tuesday</span>
                                <field name="wednesday" widget="boolean_toggle" options="{'autosave': False}" on_change="1"/><span style="line-height:2;">Wednesday</span>
                                <field name="thursday" widget="boolean_toggle" options="{'autosave': False}" on_change="1"/><span style="line-height:2;">Thursday</span>
                            </div>
                            <div style="display:flex;gap:16px;">
                                <field name="friday" widget="boolean_toggle" options="{'autosave': False}" on_change="1"/><span style="line-height:2;">Friday</span>
                                <field name="saturday" widget="boolean_toggle" options="{'autosave': False}" on_change="1"/><span style="line-height:2;">Saturday</span>
                                <field name="sunday" widget="boolean_toggle" options="{'autosave': False}" on_change="1"/><span style="line-height:2;">Sunday</span>
                            </div>
                        </div>
                    </group>
                    <!-- Recurring: start/end date range -->
                    <group string="Recurrence Period" invisible="schedule_type == 'one_time'">
                        <div style="display:flex;align-items:center;gap:8px;padding:4px 0;" colspan="2">
                            <span class="o_form_label" style="min-width:80px;">Start Date</span>
                            <field name="start_date" nolabel="1" style="width:140px;"
                                   required="schedule_type == 'recurring'"/>
                            <span class="o_form_label" style="min-width:80px;margin-left:16px;">End Date</span>
                            <field name="end_date" nolabel="1" style="width:140px;"
                                   required="schedule_type == 'recurring'"/>
                        </div>
                    </group>
                    <group string="Tutor Selection" invisible="not course_id">
                        <!-- These fields drive the div visibility below.
                             Use style="display:none" (not invisible="1") so the
                             Odoo web client still includes them in fields_spec and
                             processes their values in onchange responses. -->
                        <div style="display:none;" colspan="2">
                            <field name="no_tutor_available"/>
                            <field name="available_tutor_ids"/>
                            <field name="fallback_tutor_ids"/>
                            <field name="all_eligible_tutor_ids"/>
                            <field name="partial_tutor_ids"/>
                            <field name="assignable_tutor_ids"/>
                        </div>
                        <!-- No days selected: show all course/category/subject tutors for reference -->
                        <div colspan="2" invisible="available_tutor_ids or partial_tutor_ids or no_tutor_available or not all_eligible_tutor_ids">
                            <p class="text-muted mb-1"><i class="fa fa-info-circle text-info"/> Tutors configured for this course category and subject (select day(s) to check availability):</p>
                            <field name="all_eligible_tutor_ids" widget="many2many_tags" readonly="1" nolabel="1" class="mb-2"/>
                        </div>
                        <!-- Days selected and some tutors are fully available on every selected day/time -->
                        <div colspan="2" invisible="not available_tutor_ids">
                            <p class="text-muted mb-1"><i class="fa fa-check-circle text-success"/> <strong>Available</strong> — tutors available for every selected day and time:</p>
                            <field name="available_tutor_ids" widget="many2many_tags" readonly="1" nolabel="1" class="mb-2"/>
                        </div>
                        <!-- Days selected but NO tutors are available at that time -->
                        <div colspan="2" invisible="not no_tutor_available">
                            <div class="alert alert-warning mb-2" role="alert">
                                <i class="fa fa-exclamation-triangle"/> <strong>Not Available</strong> — no tutors available for the selected schedule.
                                <ul class="small text-muted mb-0 mt-1">
                                    <li>Tutor has an active rate configured for this course's Category and Subject, effective on the schedule date.</li>
                                    <li>Tutor's weekly availability fully covers every selected day and the entire time range (checked in the tutor's own timezone).</li>
                                </ul>
                            </div>
                            <p class="text-muted mb-1" invisible="not fallback_tutor_ids">All eligible tutors (for reference):</p>
                            <field name="fallback_tutor_ids" widget="many2many_tags" readonly="1" nolabel="1" class="mb-2"/>
                        </div>
                        <field name="tutor_id" string="Assign Tutor"
                               domain="[('id', 'in', assignable_tutor_ids)]"
                               help="Select any tutor configured for this course category and subject."/>
                    </group>
                    <group string="Tutor Selection" invisible="course_id">
                        <field name="tutor_id" string="Assign Tutor"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Schedule Delete Wizard -->
    <record id="view_schedule_delete_wizard_form" model="ir.ui.view">
        <field name="name">schedule.delete.wizard.form</field>
        <field name="model">schedule.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Schedule Deletion">
                <field name="schedule_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <strong><i class="fa fa-exclamation-triangle"/> Warning</strong>
                    <p><field name="message" nolabel="1" readonly="1"/></p>
                </div>
                <group string="Past Lessons Without Attendance">
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list string="Unmarked Lessons" create="false" delete="false">
                            <field name="lesson_date" string="Date"/>
                            <field name="lesson_name" string="Lesson"/>
                            <field name="tutor_name" string="Tutor"/>
                        </list>
                    </field>
                </group>
                <div class="alert alert-danger mt-2" role="alert">
                    <strong>On deletion:</strong>
                    <ul class="mb-0">
                        <li>All past lessons without attendance will be permanently deleted</li>
                        <li>All future lessons without attendance will be permanently deleted</li>
                        <li>Lessons with recorded attendance will be kept</li>
                        <li>The schedule itself will be deleted</li>
                    </ul>
                </div>
                <footer>
                    <button name="action_confirm_delete" type="object" string="Delete Schedule" class="btn-danger"/>
                    <button name="action_cancel" type="object" string="Go Back" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Class Schedule Occurrence Views -->
    <record id="view_class_schedule_occurrence_calendar" model="ir.ui.view">
        <field name="name">class.schedule.occurrence.calendar</field>
        <field name="model">class.schedule.occurrence</field>
        <field name="arch" type="xml">
            <calendar string="Class Schedules" date_start="start_datetime" date_stop="stop_datetime"
                      color="course_id" mode="month" event_open_popup="false" quick_create="false">
                <field name="name"/>
                <field name="course_id"/>
                <field name="tutor_id"/>
                <field name="start_local_display"/>
                <field name="lesson_status"/>
            </calendar>
        </field>
    </record>
    <record id="view_cancellation_details_form" model="ir.ui.view">
        <field name="name">class.schedule.occurrence.cancellation.details.form</field>
        <field name="model">class.schedule.occurrence</field>
        <!-- Always explicitly pinned via action_view_cancellation_details() below — never meant to
             be resolved as the model's generic default form (see the matching comment on
             view_attendance_report_form in report_attendance_views.xml for why this matters). -->
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Cancellation Details" create="false" edit="false" delete="false">
                <sheet>
                    <group string="Lesson">
                        <field name="name" readonly="1"/>
                        <field name="course_id" readonly="1"/>
                        <field name="start_local_display" string="Scheduled Time" readonly="1"/>
                    </group>
                    <group string="Cancellation Details">
                        <field name="cancelled_by" readonly="1"/>
                        <field name="cancellation_date" readonly="1"/>
                        <field name="cancellation_reason" readonly="1"/>
                        <field name="cancellation_note" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_class_schedule_occurrence_list" model="ir.ui.view">
        <field name="name">class.schedule.occurrence.list</field>
        <field name="model">class.schedule.occurrence</field>
        <field name="arch" type="xml">
            <list string="Schedule Occurrences" create="false" edit="false">
                <field name="name"/><field name="course_id"/><field name="tutor_id"/>
                <field name="start_datetime" string="Start (UTC)"/><field name="stop_datetime" string="Stop (UTC)"/>
                <field name="start_local_display" string="Local Time" optional="show"/>
                <field name="lesson_status"/><field name="is_demo" string="Demo"/><field name="is_rescheduled" string="Rescheduled"/><field name="virtual_provider"/><field name="attendance_marked"/>
                <button name="action_view_cancellation_details" type="object"
                        string="View Cancellation" icon="fa-info-circle"
                        class="btn-link text-danger"
                        invisible="lesson_status != 'cancelled'"/>
                <field name="payable_hours" optional="hide"/>
                <field name="tutor_rate_used" optional="hide"/>
                <field name="tutor_calculated_amount" optional="hide"/>
                <field name="tutor_payment_status" optional="hide"/>
                <field name="exclude_from_payroll" optional="hide"
                       widget="confirm_boolean"
                       string="Excl. Payroll" groups="base.group_user"/>
            </list>
        </field>
    </record>
    <record id="action_new_class_schedule" model="ir.actions.act_window">
        <field name="name">New Schedule</field>
        <field name="res_model">class.schedule</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_class_schedule_occurrence_form" model="ir.ui.view">
        <field name="name">class.schedule.occurrence.form</field>
        <field name="model">class.schedule.occurrence</field>
        <field name="arch" type="xml">
            <form string="Schedule Occurrence" delete="false">
                <header>
                    <button name="action_open_virtual_classroom_wizard" type="object"
                            string="Start Virtual Class" class="btn-success" icon="fa-video-camera"
                            invisible="not id or lesson_status in ('cancelled', 'completed')"/>
                    <button name="action_mark_attendance" type="object"
                            string="Mark / Edit Attendance" class="btn-primary" icon="fa-check-square-o"
                            invisible="not id or lesson_status == 'cancelled'"/>
                    <button name="action_cancel_lesson" type="object"
                            string="Cancel Lesson" class="btn-danger" icon="fa-ban"
                            invisible="not id or lesson_status == 'cancelled'"
                            groups="tuition_management.group_tuition_lesson_cancel,base.group_system"/>
                    <button name="action_revert_cancellation" type="object"
                            string="Revert Cancellation" class="btn-secondary" icon="fa-undo"
                            invisible="not id or lesson_status != 'cancelled'"
                            confirm="Revert this lesson's cancellation and set it back to Scheduled?"
                            groups="tuition_management.group_tuition_lesson_uncancel,base.group_system"/>
                    <field name="lesson_status" widget="statusbar" readonly="1"
                           statusbar_visible="scheduled,completed,cancelled,under_review"
                           invisible="not id"/>
                </header>
                <sheet>
                    <group string="Lesson Details">
                        <group>
                            <field name="name" readonly="id"/>
                            <field name="course_id" readonly="id"/>
                            <field name="tutor_id" readonly="id"/>
                        </group>
                        <group>
                            <field name="start_datetime" readonly="id"/>
                            <field name="stop_datetime" readonly="id"/>
                            <field name="start_local_display" readonly="1" string="Local Time"/>
                            <field name="is_demo" string="Demo Session" readonly="id"/>
                        </group>
                    </group>
                    <!-- Cancellation details — visible to all internal users when cancelled or under review -->
                    <group string="Cancellation Details"
                           invisible="lesson_status not in ('cancelled', 'under_review')">
                        <field name="cancelled_by" readonly="1"/>
                        <field name="cancellation_date" readonly="1"/>
                        <field name="cancellation_reason" readonly="1"/>
                        <field name="cancellation_note" readonly="1"/>
                    </group>
                    <group string="Virtual Classroom" invisible="not id">
                        <group>
                            <field name="virtual_provider" readonly="1"/>
                            <field name="virtual_meeting_state" readonly="1"/>
                        </group>
                        <group>
                            <field name="virtual_meeting_id" readonly="1"/>
                        </group>
                    </group>
                    <!-- Payroll override — internal users only -->
                    <group string="Payroll" groups="base.group_user"
                           invisible="lesson_status == 'cancelled'">
                        <field name="exclude_from_payroll"
                               widget="confirm_boolean"
                               string="Exclude from Tutor Payroll"
                               help="If checked, this lesson will not be included in any tutor payroll run."/>
                    </group>
                    <!-- Reschedule section — only shown when creating a new event -->
                    <group string="Reschedule" invisible="id">
                        <field name="is_rescheduled" string="Is this a reschedule?"/>
                        <field name="rescheduled_from_id" string="Rescheduled From (Cancelled Lesson)"
                               invisible="not is_rescheduled"
                               domain="[('course_id', '=', course_id), ('lesson_status', '=', 'cancelled')]"
                               options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_class_schedules" model="ir.actions.act_window">
        <field name="name">Class Schedules</field>
        <field name="res_model">class.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Search view for schedule occurrences -->
    <record id="view_class_schedule_occurrence_search" model="ir.ui.view">
        <field name="name">class.schedule.occurrence.search</field>
        <field name="model">class.schedule.occurrence</field>
        <field name="arch" type="xml">
            <search string="Search Schedule">
                <field name="name" string="Lesson"/>
                <field name="course_id" string="Course"/>
                <field name="tutor_id" string="Tutor"/>
                <filter string="Scheduled" name="filter_scheduled" domain="[('lesson_status', '=', 'scheduled')]"/>
                <filter string="Completed" name="filter_completed" domain="[('lesson_status', '=', 'completed')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('lesson_status', '=', 'cancelled')]"/>
                <group>
                    <filter string="Tutor" name="group_tutor" context="{'group_by': 'tutor_id'}"/>
                    <filter string="Course" name="group_course" context="{'group_by': 'course_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'lesson_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Original calendar action kept intact to avoid XML ID model conflict -->
    <record id="action_class_schedule_calendar" model="ir.actions.act_window">
        <field name="name">Schedule Calendar (Classic)</field>
        <field name="res_model">class.schedule.occurrence</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

    <!-- Schedule Viewer client action (timezone dropdown + student/tutor filters) -->
    <record id="action_schedule_viewer" model="ir.actions.client">
        <field name="name">Schedule Calendar</field>
        <field name="tag">tm_schedule_viewer</field>
    </record>
</odoo>
