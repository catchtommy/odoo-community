<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_virtual_classroom_meeting_list" model="ir.ui.view">
        <field name="name">virtual.classroom.meeting.list</field>
        <field name="model">virtual.classroom.meeting</field>
        <field name="arch" type="xml">
            <list string="Virtual Classroom Meetings" create="false">
                <field name="occurrence_id"/>
                <field name="course_id"/>
                <field name="tutor_id"/>
                <field name="provider"/>
                <field name="state"/>
                <field name="meeting_id"/>
                <field name="last_sync_at"/>
            </list>
        </field>
    </record>

    <record id="view_virtual_classroom_meeting_form" model="ir.ui.view">
        <field name="name">virtual.classroom.meeting.form</field>
        <field name="model">virtual.classroom.meeting</field>
        <field name="arch" type="xml">
            <form string="Virtual Classroom Meeting" create="false">
                <header>
                    <button name="action_retry" type="object" string="Retry" class="btn-primary" invisible="state not in ('failed', 'expired')"/>
                    <button name="action_mark_cancelled" type="object" string="Mark Cancelled" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="occurrence_id"/>
                        <field name="course_id"/>
                        <field name="tutor_id"/>
                        <field name="provider"/>
                        <field name="meeting_id"/>
                        <field name="external_id"/>
                    </group>
                    <group string="Links">
                        <field name="join_url" widget="url"/>
                        <field name="host_url" widget="url"/>
                        <field name="moderator_url" widget="url"/>
                    </group>
                    <group string="Google Meet">
                        <field name="google_event_id"/>
                        <field name="google_conference_id"/>
                    </group>
                    <group string="Diagnostics">
                        <field name="last_sync_at"/>
                        <field name="expires_at"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_virtual_classroom_meetings" model="ir.actions.act_window">
        <field name="name">Virtual Classroom Meetings</field>
        <field name="res_model">virtual.classroom.meeting</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_virtual_classroom_start_wizard_form" model="ir.ui.view">
        <field name="name">virtual.classroom.start.wizard.form</field>
        <field name="model">virtual.classroom.start.wizard</field>
        <field name="arch" type="xml">
            <form string="Start Virtual Class">
                <sheet>
                    <group>
                        <field name="occurrence_id" readonly="1"/>
                        <field name="provider" readonly="1" string="Provider (from Course)"/>
                    </group>
                    <div class="alert alert-info" role="alert" style="margin-top:8px;">
                        <i class="fa fa-info-circle"/> The provider is set at course level. To change it, edit the course's Virtual Classroom Settings.
                    </div>
                </sheet>
                <footer>
                    <button name="action_start_class" type="object" string="Start Class" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
