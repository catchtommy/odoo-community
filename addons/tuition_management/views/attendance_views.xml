<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mark Attendance Wizard -->
    <record id="view_mark_attendance_wizard_form" model="ir.ui.view">
        <field name="name">mark.attendance.wizard.form</field>
        <field name="model">mark.attendance.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark Attendance">
                <group><field name="occurrence_id" readonly="1"/></group>
                <separator string="Student Attendance"/>
                <field name="line_ids">
                    <list string="Students" editable="bottom" delete="true" create="false">
                        <field name="student_id" readonly="1"/>
                        <field name="status"/><field name="billable"/><field name="remarks"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Attendance" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Attendance Record Views -->
    <record id="view_attendance_record_list" model="ir.ui.view">
        <field name="name">attendance.record.list</field>
        <field name="model">attendance.record</field>
        <field name="arch" type="xml">
            <list string="Attendance Records" create="true">
                <field name="class_schedule_occurrence_id"/>
                <field name="student_id"/><field name="attendance_date"/>
                <field name="status"/><field name="billable"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_record_form" model="ir.ui.view">
        <field name="name">attendance.record.form</field>
        <field name="model">attendance.record</field>
        <field name="arch" type="xml">
            <form string="Attendance Record">
                <sheet>
                    <group>
                        <field name="class_schedule_occurrence_id"/>
                        <field name="course_id" readonly="1"/><field name="tutor_id" readonly="1"/>
                        <field name="student_id"/><field name="attendance_date"/>
                        <field name="status"/><field name="billable"/><field name="remarks"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Cancel Lesson Wizard -->
    <record id="view_cancel_lesson_wizard_form" model="ir.ui.view">
        <field name="name">cancel.lesson.wizard.form</field>
        <field name="model">cancel.lesson.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Lesson">
                <field name="occurrence_id" invisible="1"/>
                <group>
                    <field name="reason" required="1"/>
                    <field name="note"/>
                </group>
                <group string="Reschedule">
                    <field name="reschedule"/>
                    <field name="new_date" invisible="not reschedule" required="reschedule"/>
                    <field name="new_tutor_id" invisible="not reschedule"/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" type="object" string="Confirm Cancellation" class="btn-danger"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_attendance_records" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">attendance.record</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': True}</field>
    </record>
</odoo>
