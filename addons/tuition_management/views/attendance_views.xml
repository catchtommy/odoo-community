<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mark Attendance Wizard -->
    <record id="view_mark_attendance_wizard_form" model="ir.ui.view">
        <field name="name">mark.attendance.wizard.form</field>
        <field name="model">mark.attendance.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark Attendance">
                <group><field name="occurrence_id" readonly="1"/></group>
                <field name="any_student_present" invisible="1"/>

                <separator string="Lesson Summary"/>
                <group>
                    <group>
                        <field name="topic_covered"
                               required="any_student_present"
                               placeholder="Describe what was covered in today's class..." colspan="2"/>
                        <field name="class_rating"
                               required="any_student_present"
                               widget="radio"/>
                    </group>
                    <group>
                        <field name="next_steps" placeholder="What do students need to focus on next?"/>
                        <field name="homework" placeholder="Any homework assigned?"/>
                        <field name="tutor_comments" placeholder="Any additional comments..."/>
                    </group>
                </group>

                <separator string="Technical Issues"/>
                <group>
                    <field name="has_technical_issues" widget="boolean_toggle"/>
                    <field name="technical_issue_type"
                           invisible="not has_technical_issues"
                           required="has_technical_issues"/>
                    <field name="technical_issue_details"
                           invisible="not has_technical_issues"
                           required="has_technical_issues"
                           placeholder="Describe the technical issues encountered..."/>
                </group>

                <separator string="Student Attendance"/>
                <field name="line_ids">
                    <list string="Students" editable="bottom" delete="true" create="false"
                          decoration-success="status == 'present'"
                          decoration-danger="status == 'absent'">
                        <field name="student_id" readonly="1"/>
                        <field name="status"/>
                        <field name="remarks"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Attendance" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Cancel Lesson Wizard -->
    <record id="view_cancel_lesson_wizard_form" model="ir.ui.view">
        <field name="name">cancel.lesson.wizard.form</field>
        <field name="model">cancel.lesson.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Lesson">
                <field name="occurrence_id" invisible="1"/>
                <group>
                    <field name="reason" required="1"/>
                    <field name="note"/>
                </group>
                <group string="Reschedule">
                    <field name="reschedule"/>
                </group>
                <div class="alert alert-info" role="status" invisible="not reschedule">
                    <i class="fa fa-globe me-1"/>
                    The new date and time are taken in this lesson's scheduled timezone:
                    <strong><field name="lesson_timezone" readonly="1" class="d-inline"/></strong>.
                    Current lesson time: <field name="lesson_time_display" readonly="1" class="d-inline"/>
                </div>
                <group invisible="not reschedule">
                    <field name="new_lesson_date" required="reschedule"/>
                    <label for="new_lesson_hour" string="New Time"/>
                    <div class="d-flex align-items-center gap-1">
                        <field name="new_lesson_hour" required="reschedule" nolabel="1" placeholder="Hour" style="max-width: 5rem;"/>
                        <span>:</span>
                        <field name="new_lesson_minute" required="reschedule" nolabel="1" placeholder="Min" style="max-width: 5rem;"/>
                        <field name="new_lesson_ampm" required="reschedule" nolabel="1" placeholder="AM/PM" style="max-width: 5rem;"/>
                        <span class="text-muted ms-2">(<field name="lesson_timezone" readonly="1" nolabel="1" class="d-inline"/>)</span>
                    </div>
                    <field name="new_tutor_id"/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" type="object" string="Confirm Cancellation" class="btn-danger"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
