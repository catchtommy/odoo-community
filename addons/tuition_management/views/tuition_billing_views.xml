<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_tuition_subscription_form" model="ir.ui.view">
    <field name="name">tuition.subscription.form</field>
    <field name="model">tuition.subscription</field>
    <field name="arch" type="xml">
        <form string="Subscription">
            <header>
                <button name="action_generate_invoice" string="Generate Invoice"
                        type="object" class="oe_highlight"
                        invisible="state != 'active'"/>
                <button name="action_schedule_plan_change" string="Schedule Plan Change"
                        type="object" class="btn-secondary"
                        invisible="state != 'active'"/>
                <button name="action_add_adjustment" string="Add Adjustment"
                        type="object" class="btn-secondary"/>
                <button name="action_pause" string="Pause"
                        type="object"
                        invisible="state != 'active'"/>
                <button name="action_activate" string="Activate"
                        type="object"
                        invisible="state == 'active'"/>
                <button name="action_cancel" string="Cancel"
                        type="object"
                        invisible="state == 'cancelled'"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="active,paused,cancelled"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                </div>
                <group>
                    <group>
                        <field name="student_id"/>
                        <field name="enrollment_id"/>
                        <field name="next_billing_date"/>
                    </group>
                    <group>
                        <field name="current_plan_product" readonly="1"/>
                        <field name="current_plan_price" readonly="1"/>
                        <field name="monthly_revenue" readonly="1"/>
                        <field name="total_adjustments_applied" readonly="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Plan History" name="plan_history">
                        <field name="plan_line_ids">
                            <list editable="bottom" decoration-success="state=='active'"
                                  decoration-info="state=='scheduled'"
                                  decoration-muted="state=='expired'">
                                <field name="product_id"/>
                                <field name="price"/>
                                <field name="classes_per_week"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="state" readonly="1"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </page>
                    <page string="Discounts" name="discounts">
                        <field name="discount_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="discount_type"/>
                                <field name="value"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="active"/>
                                <field name="description"/>
                            </list>
                        </field>
                    </page>
                    <page string="Adjustments" name="adjustments">
                        <field name="adjustment_ids">
                            <list decoration-success="adjustment_type == 'extra_charge'"
                                  decoration-danger="adjustment_type in ('discount','refund')">
                                <field name="date"/>
                                <field name="adjustment_type"/>
                                <field name="description"/>
                                <field name="amount"/>
                                <field name="signed_amount" readonly="1"/>
                                <field name="applied_in_invoice" readonly="1"/>
                                <field name="invoice_id" readonly="1" optional="show"/>
                            </list>
                        </field>
                    </page>
                    <page string="Invoices" name="invoices">
                        <field name="invoice_ids" readonly="1" domain="[('state', '!=', 'cancel')]">
                            <list>
                                <field name="name"/>
                                <field name="invoice_date"/>
                                <field name="amount_total"/>
                                <field name="payment_state"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

<record id="view_tuition_subscription_list" model="ir.ui.view">
    <field name="name">tuition.subscription.list</field>
    <field name="model">tuition.subscription</field>
    <field name="arch" type="xml">
        <list decoration-success="state=='active'"
              decoration-warning="state=='paused'"
              decoration-muted="state=='cancelled'">
            <field name="name"/>
            <field name="student_id"/>
            <field name="current_plan_product"/>
            <field name="current_plan_price"/>
            <field name="next_billing_date"/>
            <field name="unapplied_adjustment_count"/>
            <field name="invoice_count"/>
            <field name="state"/>
        </list>
    </field>
</record>

<record id="view_tuition_subscription_search" model="ir.ui.view">
    <field name="name">tuition.subscription.search</field>
    <field name="model">tuition.subscription</field>
    <field name="arch" type="xml">
        <search>
            <field name="student_id"/>
            <field name="state"/>
            <filter string="Active" name="active" domain="[('state','=','active')]"/>
            <filter string="Paused" name="paused" domain="[('state','=','paused')]"/>
            <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
            <separator/>
            <filter string="Group by Student" name="by_student" context="{'group_by': 'student_id'}"/>
            <filter string="Group by Status" name="by_state" context="{'group_by': 'state'}"/>
        </search>
    </field>
</record>

<record id="action_tuition_subscriptions" model="ir.actions.act_window">
    <field name="name">Subscriptions</field>
    <field name="res_model">tuition.subscription</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_tuition_subscription_search"/>
</record>

<record id="view_tuition_invoice_preview_wizard" model="ir.ui.view">
    <field name="name">tuition.invoice.preview.wizard.form</field>
    <field name="model">tuition.invoice.preview.wizard</field>
    <field name="arch" type="xml">
        <form string="Invoice Preview">
            <group>
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="month_label" readonly="1"/>
                </group>
                <group>
                    <field name="base_price" readonly="1"/>
                    <field name="total_discounts" readonly="1"/>
                    <field name="total_adjustments" readonly="1"/>
                    <field name="total_amount" readonly="1" class="fw-bold"/>
                </group>
            </group>
            <field name="line_ids" readonly="1">
                <list>
                    <field name="description"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="unit_price"/>
                    <field name="subtotal"/>
                </list>
            </field>
            <footer>
                <button name="action_confirm" type="object" string="Confirm &amp; Create Order" class="btn-primary"/>
                <button name="action_discard" type="object" string="Discard" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>

<record id="view_tuition_invoice_confirm_wizard" model="ir.ui.view">
    <field name="name">tuition.invoice.confirm.wizard.form</field>
    <field name="model">tuition.invoice.confirm.wizard</field>
    <field name="arch" type="xml">
        <form string="Duplicate Invoice Warning">
            <div class="alert alert-warning" role="alert">
                <strong>An invoice already exists for this subscription this month.</strong>
            </div>
            <group string="Existing Invoice">
                <field name="existing_invoice_name" readonly="1"/>
                <field name="existing_invoice_date" readonly="1"/>
                <field name="existing_invoice_amount" readonly="1"/>
                <field name="existing_invoice_state" readonly="1"/>
            </group>
            <p>Do you want to generate another invoice anyway?</p>
            <footer>
                <button name="action_proceed" type="object" string="Generate Anyway" class="btn-warning"/>
                <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>

<record id="view_tuition_plan_change_wizard" model="ir.ui.view">
    <field name="name">tuition.plan.change.wizard.form</field>
    <field name="model">tuition.plan.change.wizard</field>
    <field name="arch" type="xml">
        <form string="Schedule Plan Change">
            <group>
                <field name="subscription_id" readonly="1"/>
                <field name="product_id"/>
                <field name="price"/>
                <field name="classes_per_week"/>
                <field name="start_date"/>
                <field name="notes"/>
            </group>
            <div class="alert alert-info" role="status" style="margin:12px 0;">
                <i class="fa fa-info-circle"/> Plan changes take effect on the
                <strong>1st of the selected month</strong>. The current plan will be
                automatically closed at the end of the previous month.
            </div>
            <footer>
                <button name="action_confirm" string="Confirm" type="object"
                        class="oe_highlight"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>

<record id="view_tuition_adjustment_wizard" model="ir.ui.view">
    <field name="name">tuition.adjustment.wizard.form</field>
    <field name="model">tuition.adjustment.wizard</field>
    <field name="arch" type="xml">
        <form string="Add Adjustment">
            <group>
                <field name="subscription_id" readonly="1"/>
                <field name="adjustment_type"/>
                <field name="description"/>
                <field name="amount"
                       help="Positive = extra charge, Negative = credit or refund"/>
                <field name="date"/>
            </group>
            <div class="alert alert-warning" role="alert" style="margin:12px 0;">
                <i class="fa fa-exclamation-triangle"/>
                This adjustment will be included automatically in the
                <strong>next invoice</strong> and marked as applied.
            </div>
            <footer>
                <button name="action_confirm" string="Add Adjustment" type="object"
                        class="oe_highlight"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>

<menuitem id="menu_tuition_billing_root"
          name="Billing"
          parent="menu_tuition_root"
          sequence="30"/>

<menuitem id="menu_tuition_generate_bulk_invoices"
          name="Generate Invoices"
          parent="menu_tuition_billing_root"
          action="action_bulk_billing_wizard"
          sequence="5"/>

<menuitem id="menu_tuition_subscriptions"
          name="Subscriptions"
          parent="menu_tuition_billing_root"
          action="action_tuition_subscriptions"
          sequence="10"/>

<record id="ir_cron_generate_tuition_invoices" model="ir.cron">
    <field name="name">Tuition: Generate Monthly Invoices</field>
    <field name="model_id" ref="model_tuition_subscription"/>
    <field name="state">code</field>
    <field name="code">model._cron_generate_monthly_invoices()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
</record>

</odoo>