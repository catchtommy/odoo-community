<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_tuition_subscription_form" model="ir.ui.view">
    <field name="name">tuition.subscription.form</field>
    <field name="model">tuition.subscription</field>
    <field name="arch" type="xml">
        <form string="Subscription">
            <header>
                <button name="action_schedule_plan_change" string="Schedule Plan Change"
                        type="object" class="btn-secondary"
                        invisible="state != 'active'"
                        groups="tuition_management.group_tuition_subscription_plan,base.group_system"/>
                <button name="action_add_adjustment" string="Add Adjustment"
                        type="object" class="btn-secondary"
                        groups="tuition_management.group_tuition_subscription_adjustment,base.group_system"/>
                <button name="action_pause" string="Pause"
                        type="object"
                        invisible="state != 'active'"/>
                <button name="action_activate" string="Activate"
                        type="object"
                        invisible="state == 'active'"/>
                <button name="action_cancel" string="Cancel"
                        type="object"
                        invisible="state == 'cancelled'"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="active,paused,cancelled"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                </div>
                <group>
                    <group>
                        <field name="student_id"/>
                        <field name="parent_id" readonly="1"/>
                        <field name="enrollment_id"/>
                        <field name="next_billing_date"
                               readonly="not can_edit_billing_date"
                               help="Auto-calculated from last invoice date or plan start date. Users with 'Edit Next Billing Date' permission can override manually."/>
                        <field name="can_edit_billing_date" invisible="1"/>
                    </group>
                    <group>
                        <field name="current_plan_product" readonly="1"/>
                        <field name="current_plan_price" readonly="1"/>
                        <field name="monthly_revenue" readonly="1"/>
                        <field name="total_adjustments_applied" readonly="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Plan History" name="plan_history">
                        <field name="plan_line_ids">
                            <list editable="bottom" delete="0"
                                  decoration-success="state == 'active'"
                                  decoration-info="state == 'scheduled'"
                                  decoration-muted="state == 'expired'"
                                  decoration-warning="state == 'pending_approval'">
                                <field name="product_id"/>
                                <field name="price"/>
                                <field name="classes_per_week"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="state" readonly="1" widget="badge"
                                       decoration-warning="state == 'pending_approval'"
                                       decoration-success="state == 'active'"
                                       decoration-info="state == 'scheduled'"
                                       decoration-muted="state == 'expired'"/>
                                <field name="notes"/>
                                <button name="action_approve" type="object"
                                        icon="fa-check" title="Approve"
                                        invisible="state != 'pending_approval'"
                                        groups="tuition_management.group_tuition_subscription_approve,base.group_system"/>
                                <button name="action_set_draft" type="object"
                                        icon="fa-undo" title="Reset to Pending Approval"
                                        invisible="state == 'pending_approval' or state == 'expired'"
                                        groups="tuition_management.group_tuition_subscription_approve,base.group_system"/>
                                <button name="unlink" type="object"
                                        icon="fa-trash" title="Delete plan line"
                                        groups="tuition_management.group_tuition_subscription_plan_delete,base.group_system"/>
                            </list>
                        </field>
                    </page>
                    <page string="Discounts" name="discounts" groups="tuition_management.group_tuition_subscription_discount,base.group_system">
                        <field name="discount_ids">
                            <list editable="bottom"
                                  decoration-success="state == 'active'"
                                  decoration-muted="state == 'inactive'"
                                  decoration-warning="state == 'pending_approval'">
                                <field name="name"/>
                                <field name="discount_type"/>
                                <field name="value"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="active" string="Enabled"/>
                                <field name="description"/>
                                <field name="state" readonly="1" widget="badge"
                                       decoration-warning="state == 'pending_approval'"
                                       decoration-success="state == 'active'"
                                       decoration-muted="state == 'inactive'"/>
                                <button name="action_approve" type="object"
                                        icon="fa-check" title="Approve"
                                        invisible="state != 'pending_approval'"
                                        groups="tuition_management.group_tuition_subscription_approve,base.group_system"/>
                                <button name="action_set_draft" type="object"
                                        icon="fa-undo" title="Reset to Pending Approval"
                                        invisible="state == 'pending_approval'"
                                        groups="tuition_management.group_tuition_subscription_approve,base.group_system"/>
                            </list>
                        </field>
                    </page>
                    <page string="Adjustments" name="adjustments" groups="tuition_management.group_tuition_subscription_adjustment,base.group_system">
                        <field name="adjustment_ids">
                            <list decoration-success="adjustment_type == 'extra_charge' and state == 'approved'"
                                  decoration-danger="adjustment_type in ('discount','refund') and state == 'approved'"
                                  decoration-muted="state == 'applied'"
                                  decoration-warning="state == 'pending_approval'">
                                <field name="date"/>
                                <field name="adjustment_type"/>
                                <field name="description"/>
                                <field name="amount"/>
                                <field name="signed_amount" readonly="1"/>
                                <field name="state" readonly="1" widget="badge"
                                       decoration-warning="state == 'pending_approval'"
                                       decoration-success="state == 'approved'"
                                       decoration-muted="state == 'applied'"/>
                                <field name="invoice_id" readonly="1" optional="show"/>
                                <button name="action_approve" type="object"
                                        icon="fa-check" title="Approve"
                                        invisible="state != 'pending_approval'"
                                        groups="tuition_management.group_tuition_subscription_approve,base.group_system"/>
                                <button name="action_set_draft" type="object"
                                        icon="fa-undo" title="Reset to Pending Approval"
                                        invisible="state == 'pending_approval' or state == 'applied'"
                                        groups="tuition_management.group_tuition_subscription_approve,base.group_system"/>
                            </list>
                        </field>
                    </page>
                    <page string="Invoices" name="invoices" groups="tuition_management.group_tuition_parent_invoice_view,base.group_system">
                        <field name="invoice_ids" readonly="1" domain="[('state', '!=', 'cancel')]">
                            <list>
                                <field name="name"/>
                                <field name="invoice_date"/>
                                <field name="amount_total"/>
                                <field name="payment_state"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

<record id="view_tuition_subscription_list" model="ir.ui.view">
    <field name="name">tuition.subscription.list</field>
    <field name="model">tuition.subscription</field>
    <field name="arch" type="xml">
        <list decoration-success="state=='active'"
              decoration-warning="state=='paused'"
              decoration-muted="state=='cancelled'">
            <field name="name"/>
            <field name="student_id"/>
            <field name="parent_id" optional="show"/>
            <field name="current_plan_product"/>
            <field name="current_plan_price"/>
            <field name="next_billing_date"/>
            <field name="unapplied_adjustment_count"/>
            <field name="invoice_count"/>
            <field name="state"/>
        </list>
    </field>
</record>

<record id="view_tuition_subscription_search" model="ir.ui.view">
    <field name="name">tuition.subscription.search</field>
    <field name="model">tuition.subscription</field>
    <field name="arch" type="xml">
        <search>
            <field name="student_id"/>
            <field name="parent_id"/>
            <field name="state"/>
            <filter string="Active" name="active" domain="[('state','=','active')]"/>
            <filter string="Paused" name="paused" domain="[('state','=','paused')]"/>
            <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
            <separator/>
            <filter string="Group by Student" name="by_student" context="{'group_by': 'student_id'}"/>
            <filter string="Group by Status" name="by_state" context="{'group_by': 'state'}"/>
        </search>
    </field>
</record>

<record id="action_tuition_subscriptions" model="ir.actions.act_window">
    <field name="name">Subscriptions</field>
    <field name="res_model">tuition.subscription</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_tuition_subscription_search"/>
</record>

<record id="view_tuition_plan_change_wizard" model="ir.ui.view">
    <field name="name">tuition.plan.change.wizard.form</field>
    <field name="model">tuition.plan.change.wizard</field>
    <field name="arch" type="xml">
        <form string="Schedule Plan Change">
            <group>
                <field name="subscription_id" readonly="1"/>
                <field name="product_id"/>
                <field name="price"/>
                <field name="classes_per_week"/>
                <field name="start_date"/>
                <field name="notes"/>
            </group>
            <div class="alert alert-info" role="status" style="margin:12px 0;">
                <i class="fa fa-info-circle"/> Plan changes take effect on the
                <strong>1st of the selected month</strong>. The current plan will be
                automatically closed at the end of the previous month.
            </div>
            <footer>
                <button name="action_confirm" string="Confirm" type="object"
                        class="oe_highlight"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>

<record id="view_tuition_adjustment_wizard" model="ir.ui.view">
    <field name="name">tuition.adjustment.wizard.form</field>
    <field name="model">tuition.adjustment.wizard</field>
    <field name="arch" type="xml">
        <form string="Add Adjustment">
            <group>
                <field name="subscription_id" readonly="1"/>
                <field name="adjustment_type"/>
                <field name="description"/>
                <field name="amount"
                       help="Positive = extra charge, Negative = credit or refund"/>
                <field name="date"/>
            </group>
            <div class="alert alert-warning" role="alert" style="margin:12px 0;">
                <i class="fa fa-exclamation-triangle"/>
                This adjustment will be included automatically in the
                <strong>next invoice</strong> and marked as applied.
            </div>
            <footer>
                <button name="action_confirm" string="Add Adjustment" type="object"
                        class="oe_highlight"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>

<menuitem id="menu_tuition_billing_root"
          name="Billing"
          parent="menu_tuition_root"
          sequence="30"/>
<!-- Force-set groups so Billing menu is only visible to users with Access Billing permission -->
<record id="menu_tuition_billing_root" model="ir.ui.menu">
    <field name="group_ids" eval="[(6, 0, [
        ref('tuition_management.group_tuition_subscription_access'),
        ref('base.group_system'),
    ])]"/>
</record>

<menuitem id="menu_tuition_subscriptions"
          name="Subscriptions"
          parent="menu_tuition_billing_root"
          action="action_tuition_subscriptions"
          sequence="10"/>

</odoo>