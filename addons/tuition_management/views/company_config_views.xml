<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─────────────────────────────────────────────────
         Company Currency Configuration — List
    ───────────────────────────────────────────────── -->
    <record id="view_company_tuition_currency_list" model="ir.ui.view">
        <field name="name">res.company.tuition.currency.list</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <list string="Company Currency Configuration" editable="bottom">
                <field name="name" readonly="1"/>
                <field name="currency_id" string="Base Currency" readonly="1"/>
                <field name="tuition_currency_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- ─────────────────────────────────────────────────
         Company Currency Configuration — Form
    ───────────────────────────────────────────────── -->
    <record id="view_company_tuition_currency_form" model="ir.ui.view">
        <field name="name">res.company.tuition.currency.form</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <form string="Company Currency Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="currency_id" string="Base Currency" readonly="1"/>
                        <field name="tuition_currency_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_company_tuition_currency_config" model="ir.actions.act_window">
        <field name="name">Company Currency Configuration</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_company_tuition_currency_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_company_tuition_currency_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure which currencies each company is allowed to bill tuition subscriptions in.
            </p>
        </field>
    </record>

</odoo>
