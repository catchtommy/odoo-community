<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== STUDENT PROFILE ==================== -->
    <record id="view_student_profile_list" model="ir.ui.view">
        <field name="name">student.profile.list</field>
        <field name="model">student.profile</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'active'" decoration-muted="status == 'inactive'">
                <field name="name" string="Full Name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="age"/>
                <field name="grade_id"/>
                <field name="parent_id"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_student_profile_form" model="ir.ui.view">
        <field name="name">student.profile.form</field>
        <field name="model">student.profile</field>
        <field name="arch" type="xml">
            <form string="Student Profile">
                <header>
                    <button name="action_invite_to_portal" type="object"
                            string="Invite to Portal" class="btn-primary"
                            invisible="has_portal_access or not id"/>
                    <button name="action_invite_to_portal" type="object"
                            string="Manage Portal Access" class="btn-secondary"
                            invisible="not has_portal_access or not id"/>
                </header>
                <sheet>
                    <field name="has_portal_access" invisible="1"/>
                    <field name="can_edit_student" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-globe"
                                name="action_invite_to_portal" type="object"
                                invisible="not has_portal_access">
                            <span class="o_stat_text text-success">Portal Active</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="not can_edit_student" placeholder="Full Name"/></h1>
                    </div>
                    <group readonly="not can_edit_student">
                        <group string="Student Information">
                            <field name="age"/>
                            <field name="email"/>
                            <label for="phone" string="Phone"/>
                            <div class="d-flex gap-2">
                                <field name="country_code" nolabel="1" style="max-width:130px;"/>
                                <field name="phone" nolabel="1"/>
                            </div>
                            <field name="timezone" required="1"/>
                            <field name="status"/>
                            <field name="partner_id" invisible="1"/>
                        </group>
                        <group string="Academic Information">
                            <field name="grade_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="subjects_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="parent_id"/>
                        </group>
                    </group>
                    <group string="Address" readonly="not can_edit_student">
                        <field name="address_line_1"/>
                        <field name="address_line_2"/>
                        <field name="address_line_3"/>
                        <field name="address_line_4"/>
                        <field name="zip_code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_student_profiles" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.profile</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_student_profile_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_student_profile_form')}),
        ]"/>
    </record>

    <!-- ==================== TUTOR PROFILE ==================== -->
    <record id="view_tutor_profile_list" model="ir.ui.view">
        <field name="name">tutor.profile.list</field>
        <field name="model">tutor.profile</field>
        <field name="arch" type="xml">
            <list js_class="tutor_profile_list" decoration-success="status == 'active'" decoration-muted="status == 'inactive'">
                <field name="name" string="Full Name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="category_ids" widget="many2many_tags"/>
                <field name="subject_ids" widget="many2many_tags"/>
                <field name="grade_ids" widget="many2many_tags"/>
                <field name="employment_type" widget="badge"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_tutor_profile_form" model="ir.ui.view">
        <field name="name">tutor.profile.form</field>
        <field name="model">tutor.profile</field>
        <field name="arch" type="xml">
            <form string="Tutor Profile">
                <header>
                    <button name="action_invite_to_portal" type="object"
                            string="Invite to Portal" class="btn-primary"
                            invisible="has_portal_access or not id"/>
                    <button name="action_invite_to_portal" type="object"
                            string="Manage Portal Access" class="btn-secondary"
                            invisible="not has_portal_access or not id"/>
                </header>
                <sheet>
                    <field name="has_portal_access" invisible="1"/>
                    <field name="can_edit_tutor" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-globe"
                                name="action_invite_to_portal" type="object"
                                invisible="not has_portal_access">
                            <span class="o_stat_text text-success">Portal Active</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="not can_edit_tutor" placeholder="Full Name"/></h1>
                    </div>
                    <group readonly="not can_edit_tutor">
                        <group string="Contact Information">
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="email"/>
                            <label for="phone" string="Phone"/>
                            <div class="d-flex gap-2">
                                <field name="country_code" nolabel="1" style="max-width:130px;"/>
                                <field name="phone" nolabel="1"/>
                            </div>
                            <field name="timezone"/>
                            <field name="status"/>
                            <field name="employment_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Teaching Information">
                            <field name="category_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="subject_ids" widget="many2many_tags"
                                  domain="[('category_id', 'in', category_ids)] if category_ids else []"
                                  options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="grade_ids" widget="many2many_tags"
                                  domain="[('category_ids', 'in', category_ids)] if category_ids else []"
                                  options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Availability">
                            <div class="mb-2">
                                <button name="action_open_availability_matrix"
                                        type="object"
                                        string="Edit Availability Matrix"
                                        class="btn btn-primary"/>
                            </div>
                            <field name="availability_matrix_html" widget="html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Pricing Matrix" invisible="employment_type != 'contract'"
                              groups="tuition_management.group_tuition_tutor_pricing_view,base.group_system">
                            <field name="tutor_subject_rate_ids">
                                <list editable="bottom">
                                    <field name="active_flag" widget="boolean_toggle"/>
                                    <field name="category_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="subject_id" domain="[('category_id', '=', category_id)] if category_id else []" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="standard_hourly_rate"/>
                                    <field name="demo_rate_type"/>
                                    <field name="demo_percentage" invisible="demo_rate_type != 'percentage'"/>
                                    <field name="demo_hourly_rate" invisible="demo_rate_type != 'custom'"/>
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fixed Pricing Matrix" invisible="employment_type != 'permanent'"
                              groups="tuition_management.group_tuition_tutor_pricing_view,base.group_system">
                            <field name="tutor_fixed_rate_ids">
                                <list editable="bottom">
                                    <field name="active_flag" widget="boolean_toggle"/>
                                    <field name="fixed_amount"/>
                                    <field name="pay_frequency"/>
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tutor_availability_overview_form" model="ir.ui.view">
        <field name="name">tutor.availability.overview.form</field>
        <field name="model">tutor.availability.overview</field>
        <field name="arch" type="xml">
            <form string="Tutor Availability Schedule" create="false" delete="false">
                <header>
                    <button name="action_search" type="object"
                            string="Search" class="btn-primary"/>
                    <button name="action_show_all" type="object"
                            string="Show All Tutors" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tutor_id"
                                   placeholder="Select a tutor to filter…"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <field name="show_all" invisible="1"/>
                    <separator/>
                    <field name="result_html" widget="html" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tutor_availability_server" model="ir.actions.server">
        <field name="name">Tutor Availability</field>
        <field name="model_id" ref="tuition_management.model_tutor_availability_overview"/>
        <field name="state">code</field>
        <field name="code">action = env['tutor.availability.overview'].action_open()</field>
    </record>

    <record id="view_tutor_availability_matrix_wizard_form" model="ir.ui.view">
        <field name="name">tutor.availability.matrix.wizard.form</field>
        <field name="model">tutor.availability.matrix.wizard</field>
        <field name="arch" type="xml">
            <form string="Edit Availability Matrix">
                <sheet>
                    <div class="alert alert-info mb-3" role="alert">
                        Enter each slot as <strong>HH:MM-HH:MM</strong> (e.g. <em>09:00-17:00</em>).
                        Leave a cell blank for no availability on that day.
                        Add extra rows for multiple slots per day. Overlapping times will be rejected.
                    </div>
                    <field name="tutor_id" invisible="1"/>
                    <field name="line_ids">
                        <list editable="bottom" string="Time Slots">
                            <field name="mon" string="Monday" placeholder="09:00-17:00"/>
                            <field name="tue" string="Tuesday" placeholder="09:00-17:00"/>
                            <field name="wed" string="Wednesday" placeholder="09:00-17:00"/>
                            <field name="thu" string="Thursday" placeholder="09:00-17:00"/>
                            <field name="fri" string="Friday" placeholder="09:00-17:00"/>
                            <field name="sat" string="Saturday" placeholder="09:00-17:00"/>
                            <field name="sun" string="Sunday" placeholder="09:00-17:00"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn btn-primary"/>
                    <button special="cancel" string="Discard" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tutor_profiles" model="ir.actions.act_window">
        <field name="name">Tutors</field>
        <field name="res_model">tutor.profile</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_tutor_profile_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_tutor_profile_form')}),
        ]"/>
    </record>


    <!-- ==================== PARENT PROFILE ==================== -->
    <record id="view_parent_profile_list" model="ir.ui.view">
        <field name="name">parent.profile.list</field>
        <field name="model">parent.profile</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'active'" decoration-muted="status == 'inactive'">
                <field name="name" string="Full Name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_parent_profile_form" model="ir.ui.view">
        <field name="name">parent.profile.form</field>
        <field name="model">parent.profile</field>
        <field name="arch" type="xml">
            <form string="Parent Profile">
                <header>
                    <button name="action_invite_to_portal" type="object"
                            string="Invite to Portal" class="btn-primary"
                            invisible="has_portal_access or not id"/>
                    <button name="action_invite_to_portal" type="object"
                            string="Manage Portal Access" class="btn-secondary"
                            invisible="not has_portal_access or not id"/>
                </header>
                <sheet>
                    <field name="has_portal_access" invisible="1"/>
                    <field name="can_edit_parent" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-globe"
                                name="action_invite_to_portal" type="object"
                                invisible="not has_portal_access">
                            <span class="o_stat_text text-success">Portal Active</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="not can_edit_parent" placeholder="Full Name"/></h1>
                    </div>
                    <group readonly="not can_edit_parent">
                        <group string="Contact Information">
                            <field name="email"/>
                            <label for="phone" string="Phone"/>
                            <div class="d-flex gap-2">
                                <field name="country_code" nolabel="1" style="max-width:130px;"/>
                                <field name="phone" nolabel="1"/>
                            </div>
                            <field name="timezone"/>
                            <field name="status"/>
                            <field name="partner_id" invisible="1"/>
                        </group>
                        <group string="Address">
                            <field name="address_line_1"/>
                            <field name="address_line_2"/>
                            <field name="address_line_3"/>
                            <field name="address_line_4"/>
                            <field name="zip_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students">
                            <field name="student_ids">
                                <list>
                                    <field name="name" string="Student Name"/>
                                    <field name="grade_id"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_parent_profiles" model="ir.actions.act_window">
        <field name="name">Parents</field>
        <field name="res_model">parent.profile</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_parent_profile_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_parent_profile_form')}),
        ]"/>
    </record>

    <!-- ==================== PORTAL ACCESS WIZARD ==================== -->
    <record id="view_portal_access_wizard_form" model="ir.ui.view">
        <field name="name">portal.access.wizard.form</field>
        <field name="model">portal.access.wizard</field>
        <field name="arch" type="xml">
            <form string="Manage Portal Access">
                <field name="profile_model" invisible="1"/>
                <field name="profile_id" invisible="1"/>
                <field name="is_existing_user" invisible="1"/>
                <field name="existing_user_id" invisible="1"/>
                <group string="User Details">
                    <field name="name" readonly="1"/>
                    <field name="email" readonly="1"/>
                    <field name="login"/>
                </group>
                <group string="Password">
                    <field name="password"/>
                    <field name="confirm_password"/>
                </group>
                <div>
                    <button name="action_generate_password" type="object"
                            string="Generate New Password" class="btn-secondary"/>
                </div>
                <footer>
                    <button name="action_create_portal_user" type="object"
                            string="Activate Portal Access" class="btn-primary"
                            invisible="is_existing_user"/>
                    <button name="action_create_portal_user" type="object"
                            string="Update Credentials" class="btn-primary"
                            invisible="not is_existing_user"/>
                    <button name="action_deactivate_portal_user" type="object"
                            string="Deactivate" class="btn-danger"
                            invisible="not is_existing_user"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
