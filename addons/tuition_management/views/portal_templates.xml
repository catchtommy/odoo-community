<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ═══════════════════════════════════════════════ -->
<!-- USER PROFILE: VIEW & UPDATE                     -->
<!-- ═══════════════════════════════════════════════ -->
<template id="portal_user_profile" name="Portal: User Profile">
    <t t-call="tuition_management.portal_sidebar_layout">
        
        <div class="tm-page mt-3">
            <div class="tm-hero" style="background: linear-gradient(135deg, var(--tm-indigo), var(--tm-indigo-dark));">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="tm-avatar" style="width:56px;height:56px;font-size:22px;background:rgba(255,255,255,0.2);color:#fff;">
                            <t t-esc="(profile.name or user.name or 'U')[:1].upper()"/>
                        </div>
                        <div>
                            <h2 class="mb-0"><t t-esc="profile.name if profile else user.name"/></h2>
                            <p class="mb-0"><span class="tm-badge" style="background:rgba(255,255,255,0.2); color:#fff;"><t t-esc="role"/></span>
                                <span style="opacity:0.7; margin-left:8px; font-size:12px;"><t t-esc="user.login"/></span>
                            </p>
                        </div>
                    </div>
                    <div>
                        <t t-if="is_tutor"><a href="/my/tutor/courses" class="tm-btn tm-btn-outline" style="background:rgba(255,255,255,0.15); color:#fff; border-color:rgba(255,255,255,0.3);"><i class="fa fa-arrow-left"/> Dashboard</a></t>
                        <t t-elif="is_student"><a href="/my/courses" class="tm-btn tm-btn-outline" style="background:rgba(255,255,255,0.15); color:#fff; border-color:rgba(255,255,255,0.3);"><i class="fa fa-arrow-left"/> Dashboard</a></t>
                        <t t-elif="is_parent"><a href="/my/parent/children" class="tm-btn tm-btn-outline" style="background:rgba(255,255,255,0.15); color:#fff; border-color:rgba(255,255,255,0.3);"><i class="fa fa-arrow-left"/> Dashboard</a></t>
                    </div>
                </div>
            </div>

            <t t-if="success">
                <div class="alert d-flex align-items-center gap-2" style="border-radius:10px; border:none; background:#EDF7ED; color:#4a8a4e;">
                    <i class="fa fa-check-circle" style="font-size:16px;"/> Profile updated successfully!
                </div>
            </t>
            <t t-if="error">
                <div class="alert d-flex align-items-center gap-2" style="border-radius:10px; border:none; background:#FDEAEA; color:#c05050;">
                    <i class="fa fa-exclamation-circle" style="font-size:16px;"/> <t t-esc="error"/>
                </div>
            </t>

            <form action="/my/profile/save" method="POST">
                <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                <div class="row">
                    <!-- Personal Information -->
                    <div class="col-lg-6">
                        <div class="tm-card">
                            <div class="tm-card-header" style="background: linear-gradient(135deg, var(--tm-blue), var(--tm-blue-dark));">
                                <span><i class="fa fa-user me-2"/>Personal Information</span>
                            </div>
                            <div class="tm-card-body">
                                <div class="mb-3">
                                    <label class="form-label fw-bold" style="font-size:12px;">Full Name *</label>
                                    <input type="text" name="name" class="form-control" required="required"
                                           style="border-radius:8px; font-size:13px;"
                                           t-att-value="profile.name if profile else user.name"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold" style="font-size:12px;">Email</label>
                                    <input type="email" name="email" class="form-control"
                                           style="border-radius:8px; font-size:13px;"
                                           t-att-value="(profile.email if profile else '') or (partner.email or '')"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold" style="font-size:12px;">Phone</label>
                                    <input type="text" name="phone" class="form-control"
                                           style="border-radius:8px; font-size:13px;"
                                           t-att-value="(profile.phone if profile else '') or (partner.phone or '')"/>
                                </div>
                                <div class="mb-0">
                                    <div class="tm-label">Login (Username)</div>
                                    <div class="tm-value" style="font-size:13px; color:var(--tm-grey);">
                                        <i class="fa fa-lock me-1" style="font-size:11px;"/>
                                        <t t-esc="user.login"/>
                                        <small class="ms-2" style="color:var(--tm-text-light);">(cannot be changed)</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Change Password -->
                    <div class="col-lg-6">
                        <div class="tm-card">
                            <div class="tm-card-header" style="background: linear-gradient(135deg, var(--tm-orange), #E07040);">
                                <span><i class="fa fa-key me-2"/>Change Password</span>
                            </div>
                            <div class="tm-card-body">
                                <div class="p-2 mb-3" style="background:var(--tm-bg); border-radius:8px; font-size:12px; color:var(--tm-text-light);">
                                    <i class="fa fa-info-circle me-1"/> Leave blank to keep your current password.
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold" style="font-size:12px;">New Password</label>
                                    <input type="password" name="new_password" class="form-control"
                                           style="border-radius:8px; font-size:13px;"
                                           placeholder="Min. 6 characters" autocomplete="new-password"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold" style="font-size:12px;">Confirm Password</label>
                                    <input type="password" name="confirm_password" class="form-control"
                                           style="border-radius:8px; font-size:13px;"
                                           placeholder="Re-enter new password" autocomplete="new-password"/>
                                </div>
                            </div>
                        </div>

                        <!-- Account Info (read-only) -->
                        <div class="tm-card">
                            <div class="tm-card-header" style="background: linear-gradient(135deg, var(--tm-grey), #607D8B);">
                                <span><i class="fa fa-info-circle me-2"/>Account Info</span>
                            </div>
                            <div class="tm-card-body">
                                <div class="tm-label">Account Type</div>
                                <div class="tm-value"><span class="tm-badge tm-badge-blue"><t t-esc="role"/></span></div>
                                <t t-if="profile">
                                    <t t-if="is_student and profile.grade_id">
                                        <div class="tm-label">Grade</div>
                                        <div class="tm-value" t-esc="profile.grade_id.name"/>
                                    </t>
                                    <t t-if="is_student and profile.parent_id">
                                        <div class="tm-label">Parent</div>
                                        <div class="tm-value" t-esc="profile.parent_id.name"/>
                                    </t>
                                    <t t-if="is_parent and profile.student_ids">
                                        <div class="tm-label">Children</div>
                                        <div class="tm-value">
                                            <t t-foreach="profile.student_ids" t-as="child">
                                                <span class="tm-badge tm-badge-teal me-1 mb-1"><t t-esc="child.name"/></span>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-if="is_tutor and profile.subject_ids">
                                        <div class="tm-label">Subjects</div>
                                        <div class="tm-value">
                                            <t t-foreach="profile.subject_ids" t-as="subj">
                                                <span class="tm-badge tm-badge-purple me-1 mb-1"><t t-esc="subj.name"/></span>
                                            </t>
                                        </div>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mb-4">
                    <button type="submit" class="tm-btn tm-btn-green" style="padding: 10px 28px;">
                        <i class="fa fa-save"/> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </t>
</template>

</odoo>
