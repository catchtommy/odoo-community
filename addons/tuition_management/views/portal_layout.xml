<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ═══════════════════════════════════════════════════ -->
<!-- BASE SIDEBAR LAYOUT                                 -->
<!-- Called by all portal pages as the outer shell       -->
<!-- ═══════════════════════════════════════════════════ -->
<template id="portal_sidebar_layout">
    <t t-call="web.layout">
        <t t-set="head_portal">
            <link rel="stylesheet" href="/tuition_management/static/src/css/portal.css?v=8"/>
            <t t-call="tuition_management.portal_tuition_css"/>
            <script type="text/javascript" src="/tuition_management/static/src/js/portal_assignment_annotator.js"/>
            <t t-out="head or ''"/>
        </t>
        <t t-set="head" t-value="head_portal"/>
        <t t-set="user" t-value="request.env.user"/>
        <body class="o_portal tm-portal-layout">
            <div class="tm-layout">

                <!-- ── TOP NAVBAR ── -->
                <header class="tm-topnav">
                    <div class="tm-topnav-inner">
                        <a href="/my/dashboard" class="tm-topnav-brand">
                            <img src="/tuition_management/static/src/img/shiningace_logo.png" alt="ShiningAce" class="tm-topnav-logo"/>
                        </a>

                        <button type="button" class="tm-topnav-toggle" id="tm-nav-toggle" aria-label="Toggle navigation">
                            <i class="fa fa-bars"/>
                        </button>

                        <t t-set="_page" t-value="str(page_name or '')"/>
                        <nav class="tm-topnav-links" id="tm-nav-links">
                            <t t-if="is_student or is_tutor or is_parent">
                                <a href="/my/dashboard"
                                   t-attf-class="tm-nav-item #{_page == 'dashboard' and 'active' or ''}">
                                    Home
                                </a>
                            </t>

                            <t t-if="is_student">
                                <a href="/my/courses"
                                   t-attf-class="tm-nav-item #{_page == 'my_courses' and 'active' or ''}">
                                    My Courses
                                    <t t-if="course_count">
                                        <span class="tm-nav-badge"><t t-esc="course_count"/></span>
                                    </t>
                                </a>
                                <a href="/my/student/schedule"
                                   t-attf-class="tm-nav-item #{_page == 'student_schedule' and 'active' or ''}">
                                    Schedule
                                </a>
                                <a href="/my/assignments"
                                   t-attf-class="tm-nav-item #{_page == 'assignments' and 'active' or ''}">
                                    Assignments
                                    <t t-if="assignment_count">
                                        <span class="tm-nav-badge"><t t-esc="assignment_count"/></span>
                                    </t>
                                </a>
                            </t>

                            <t t-if="is_tutor">
                                <a href="/my/tutor/courses"
                                   t-attf-class="tm-nav-item #{_page in ('tutor_courses','tutor_course_detail') and 'active' or ''}">
                                    My Courses
                                </a>
                                <a href="/my/tutor/schedule"
                                   t-attf-class="tm-nav-item #{_page == 'tutor_schedule' and 'active' or ''}">
                                    Schedule
                                </a>
                                <a href="/my/tutor/all-assignments"
                                   t-attf-class="tm-nav-item #{_page == 'tutor_all_assignments' and 'active' or ''}">
                                    Assignments
                                </a>
                                <a href="/my/tutor/progress"
                                   t-attf-class="tm-nav-item #{_page == 'tutor_progress' and 'active' or ''}">
                                    Progress
                                </a>
                                <a href="/my/tutor/payments"
                                   t-attf-class="tm-nav-item #{_page == 'tutor_payments' and 'active' or ''}">
                                    Payments
                                </a>
                            </t>

                            <t t-if="is_parent">
                                <a href="/my/parent/children"
                                   t-attf-class="tm-nav-item #{_page == 'parent_children' and 'active' or ''}">
                                    My Children
                                </a>
                                <a href="/my/parent/schedule"
                                   t-attf-class="tm-nav-item #{_page == 'parent_schedule' and 'active' or ''}">
                                    Schedules
                                </a>
                                <a href="/my/parent/progress"
                                   t-attf-class="tm-nav-item #{_page == 'parent_progress' and 'active' or ''}">
                                    Progress
                                </a>
                                <a href="/my/tuition/invoices"
                                   t-attf-class="tm-nav-item #{_page == 'tuition_invoices' and 'active' or ''}">
                                    Invoices
                                </a>
                            </t>

                            <a href="/my/profile"
                               t-attf-class="tm-nav-item #{_page == 'settings' and 'active' or ''}">
                                Settings
                            </a>
                        </nav>

                        <div class="tm-topnav-right">
                            <a href="/my/profile" class="tm-header-user">
                                <div class="tm-header-avatar">
                                    <i class="fa fa-user"/>
                                </div>
                                <span class="tm-header-username"><t t-esc="user.name"/></span>
                            </a>
                            <a href="/web/session/logout?redirect=/web/login" class="tm-header-logout">
                                Logout
                            </a>
                        </div>
                    </div>
                </header>

                <!-- ── MAIN ── -->
                <div class="tm-main">
                    <!-- Page Body -->
                    <div class="tm-content">
                        <t t-out="0"/>
                    </div>
                </div>

            </div><!-- .tm-layout -->

            <!-- Mobile nav toggle -->
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    var toggle = document.getElementById('tm-nav-toggle');
                    var links = document.getElementById('tm-nav-links');
                    if (toggle &amp;&amp; links) {
                        toggle.addEventListener('click', function() {
                            links.classList.toggle('open');
                        });
                    }
                    // Close dropdown menus on outside click
                    document.addEventListener('click', function(e) {
                        document.querySelectorAll('.tm-dropdown-menu.tm-dropdown-open').forEach(function(menu) {
                            if (!menu.parentElement.contains(e.target)) {
                                menu.classList.remove('tm-dropdown-open');
                            }
                        });
                    });
                });
            </script>
        </body>
    </t>
</template>

</odoo>
