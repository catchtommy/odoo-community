<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_tutor" model="ir.ui.view">
        <field name="name">hr.employee.form.tutor.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_open_tutor_profile"
                        icon="fa-graduation-cap"
                        invisible="not tutor_profile_id">
                    <span class="o_stat_text">Tutor Profile</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
